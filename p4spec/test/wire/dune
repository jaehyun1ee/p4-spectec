;; OCaml-to-Rust JSON wire golden tests

(executable
 (name generate_yojson_value)
 (modules generate_yojson_value)
 (libraries wire yojson))

(executable
 (name generate_sim_suite)
 (modules generate_sim_suite)
 (libraries wire stf yojson))

(rule
 (target yojson-value.actual.json)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:generate_yojson_value.exe}))))

(rule
 (target minimal-sim-suite.actual.json)
 (action
  (with-stdout-to
   %{target}
   (run %{exe:generate_sim_suite.exe}))))

(rule
 (target minimal-sl.actual.json)
 (deps minimal.watsup)
 (action
  (run
   %{exe:../../bin/main.exe}
   export-sl-json
   -o
   %{target}
   %{dep:minimal.watsup})))

(rule
 (target minimal-value.actual.json)
 (deps minimal.p4)
 (action
  (run
   %{exe:../../bin/main.exe}
   export-p4-json
   -p
   %{dep:minimal.p4}
   -o
   %{target})))

(rule
 (alias wire)
 (action
  (progn
   (diff minimal-sl.expected.json minimal-sl.actual.json)
   (diff minimal-value.expected.json minimal-value.actual.json)
   (diff
    minimal-sim-suite.expected.json
    minimal-sim-suite.actual.json)
   (diff yojson-value.expected.json yojson-value.actual.json))))

(rule
 (alias wire)
 (target missing-input.err)
 (action
  (with-stderr-to
   %{target}
   (with-accepted-exit-codes
    1
    (run %{exe:../../bin/main.exe} export-p4-json -p missing-input.p4)))))
