use crate::stf::{
    ast::{Action, Condition, CounterKind, IdOrIndex, Match, MatchKind, Program, Statement},
    error::StfError,
    lexer::Token,
    parse::SourceMap,
};

grammar(source: &SourceMap);

extern {
    type Location = usize;
    type Error = StfError;

    enum Token {
        "END" => Token::End,
        "ADD" => Token::Add,
        "ALL" => Token::All,
        "BYTES" => Token::Bytes,
        "CHECK_COUNTER" => Token::CheckCounter,
        "EXPECT" => Token::Expect,
        "NO_PACKET" => Token::NoPacket,
        "PACKET" => Token::Packet,
        "PACKETS" => Token::Packets,
        "EXACT" => Token::Exact,
        "REMOVE" => Token::Remove,
        "SETDEFAULT" => Token::SetDefault,
        "WAIT" => Token::Wait,
        "PACKET_WILDCARD" => Token::PacketWildcard,
        "DATA_TERN" => Token::DataTernary,
        "MIRRORING_ADD" => Token::MirroringAdd,
        "MIRRORING_ADD_MC" => Token::MirroringAddMc,
        "MIRRORING_GET" => Token::MirroringGet,
        "MC_GROUP_CREATE" => Token::McGroupCreate,
        "MC_NODE_CREATE" => Token::McNodeCreate,
        "MC_NODE_ASSOCIATE" => Token::McNodeAssociate,
        "REGISTER_READ" => Token::RegisterRead,
        "REGISTER_WRITE" => Token::RegisterWrite,
        "REGISTER_RESET" => Token::RegisterReset,
        "ID" => Token::Id(<String>),
        ":" => Token::Colon,
        "," => Token::Comma,
        "." => Token::Dot,
        "(" => Token::LeftParen,
        ")" => Token::RightParen,
        "/" => Token::Slash,
        "=" => Token::Assign,
        "==" => Token::Eq,
        "<" => Token::Lt,
        "<=" => Token::Le,
        ">" => Token::Gt,
        ">=" => Token::Ge,
        "!=" => Token::Ne,
        "[" => Token::LeftBracket,
        "]" => Token::RightBracket,
        "INT_CONST_DEC" => Token::IntDecimal(<String>),
        "INT_CONST_HEX" => Token::IntHex(<String>),
        "INT_CONST_BIN" => Token::IntBinary(<String>),
        "TERN_CONST_HEX" => Token::TernaryHex(<String>),
        "DATA_DEC" => Token::DataDecimal(<String>),
        "DATA_HEX" => Token::DataHex(<String>),
    }
}

pub Statements: Program = {
    <statements:StatementRule*> "END" => statements,
};

StatementRule: crate::lang::common::source::Phrase<Statement> = {
    <left:@L> <node:StatementNode> <right:@R> => source.phrase(node, left, right),
};

StatementNode: Statement = {
    "ADD" <table:QualifiedName> <priority:Priority> <matches:MatchRule+>
        <action:ActionRule> "=" <id:"ID"> => Statement::Add {
            table, priority: Some(priority), matches, action, id: Some(id),
        },
    "ADD" <table:QualifiedName> <priority:Priority> <matches:MatchRule+>
        <action:ActionRule> => Statement::Add {
            table, priority: Some(priority), matches, action, id: None,
        },
    "ADD" <table:QualifiedName> <matches:MatchRule+>
        <action:ActionRule> "=" <id:"ID"> => Statement::Add {
            table, priority: None, matches, action, id: Some(id),
        },
    "ADD" <table:QualifiedName> <matches:MatchRule+>
        <action:ActionRule> => Statement::Add {
            table, priority: None, matches, action, id: None,
        },
    "CHECK_COUNTER" <id:"ID"> "(" <target:IdOrIndexRule> ")" => {
        Statement::CheckCounter {
            id,
            target,
            check: (None, Condition::Eq, "0".to_owned()),
        }
    },
    "CHECK_COUNTER" <id:"ID"> "(" <target:IdOrIndexRule> ")"
        <kind:CounterKindRule> <condition:ConditionRule> <number:Number> => {
            Statement::CheckCounter {
                id,
                target,
                check: (Some(kind), condition, number),
            }
        },
    "EXPECT" <port:Port> <expected:ExpectedData> "EXACT" => {
        Statement::Expect(port, expected, true)
    },
    "EXPECT" <port:Port> <expected:ExpectedData> => {
        Statement::Expect(port, expected, false)
    },
    "EXPECT" <port:Port> "EXACT" => Statement::Expect(port, None, true),
    "EXPECT" <port:Port> => Statement::Expect(port, None, false),
    "MIRRORING_ADD" <session:Decimal> <port:Decimal> => {
        Statement::MirroringAdd(session, port)
    },
    "MIRRORING_ADD_MC" <session:Decimal> <id:Decimal> => {
        Statement::MirroringAddMc(session, id)
    },
    "MIRRORING_GET" <session:Decimal> => Statement::MirroringGet(session),
    "NO_PACKET" => Statement::NoPacket,
    "PACKET" <port:Port> <packet:PacketData> => Statement::Packet(port, packet),
    "SETDEFAULT" <table:QualifiedName> <action:ActionRule> => {
        Statement::SetDefault { table, action }
    },
    "MC_GROUP_CREATE" <id:Decimal> => Statement::McGroupCreate(id),
    "MC_NODE_CREATE" <id:Decimal> <ports:Number+> => Statement::McNodeCreate(id, ports),
    "MC_NODE_ASSOCIATE" <id:Decimal> <handle:Decimal> => {
        Statement::McNodeAssociate(id, handle)
    },
    "REGISTER_READ" <name:QualifiedName> <index:Number> => {
        Statement::RegisterRead(name, index)
    },
    "REGISTER_WRITE" <name:QualifiedName> <index:Number> <value:Number> => {
        Statement::RegisterWrite(name, index, value)
    },
    "REGISTER_RESET" <name:QualifiedName> => Statement::RegisterReset(name),
    "REMOVE" "ALL" => Statement::RemoveAll,
    "WAIT" => Statement::Wait,
};

Number: String = {
    Decimal,
    "INT_CONST_BIN",
    "INT_CONST_HEX",
    "TERN_CONST_HEX",
};

NumberOrLpm: MatchKind = {
    <left:Number> "/" <right:Number> => MatchKind::Slash(left, right),
    <number:Number> => MatchKind::Number(number),
};

MatchRule: Match = {
    <name:QualifiedName> ":" <kind:NumberOrLpm> => (name, kind),
};

QualifiedName: String = {
    <id:"ID"> => id,
    <id:"ID"> "[" <index:Decimal> "]" => format!("{id}[{index}]"),
    <prefix:QualifiedName> "." <id:"ID"> => format!("{prefix}.{id}"),
};

IdOrIndexRule: IdOrIndex = {
    <id:"ID"> => IdOrIndex::Id(id),
    <number:Number> => IdOrIndex::Index(number),
};

CounterKindRule: CounterKind = {
    "BYTES" => CounterKind::Bytes,
    "PACKETS" => CounterKind::Packets,
};

ConditionRule: Condition = {
    "==" => Condition::Eq,
    "!=" => Condition::Ne,
    "<=" => Condition::Le,
    "<" => Condition::Lt,
    ">=" => Condition::Ge,
    ">" => Condition::Gt,
};

ActionRule: Action = {
    <name:QualifiedName> "(" <args:Comma<Argument>> ")" => Action { name, args },
};

Argument: (String, String) = {
    "ADD" ":" <number:Number> => ("add".to_owned(), number),
    <id:"ID"> ":" <number:Number> => (id, number),
};

Comma<T>: Vec<T> = {
    => vec![],
    <head:T> <tail:("," <T>)*> => {
        let mut values = vec![head];
        values.extend(tail);
        values
    },
};

Priority: i64 = {
    <left:@L> <value:Decimal> <right:@R> =>? source
        .priority(value, left, right)
        .map_err(|error| lalrpop_util::ParseError::User { error }),
};

Decimal: String = {
    "INT_CONST_DEC",
};

Port: String = {
    "DATA_DEC",
};

ExpectedData: Option<String> = {
    <data:ExpectedDatum+> => data.into_iter().fold(None, |result, datum| match (result, datum) {
        (Some(left), Some(right)) => Some(left + &right),
        (Some(value), None) | (None, Some(value)) => Some(value),
        (None, None) => None,
    }),
};

ExpectedDatum: Option<String> = {
    <data:PacketDatum> => Some(data),
    "PACKET_WILDCARD" => Some("*".to_owned()),
    "DATA_TERN" => None,
};

PacketData: String = {
    <data:PacketDatum+> => data.concat(),
};

PacketDatum: String = {
    "DATA_DEC",
    "DATA_HEX",
};
