// parserConditionalStatement ::= "IF" "L_PAREN" expression "R_PAREN"
//     parserStatement
//   | "IF" "L_PAREN" expression "R_PAREN" parserStatement "ELSE"
//     parserStatement

// The matched forms below implement the canonical parserStatement alternatives
parserStatement: Value = {
    // parserStatement ::= ParserMatchedStatement
    ParserMatchedStatement,

    // parserStatement ::= ParserUnmatchedStatement
    ParserUnmatchedStatement,
};

// - LALRPOP parser-statement dangling-else lowering

ParserMatchedStatement: Value = {
    // ParserMatchedStatement ::= emptyStatement
    emptyStatement,

    // ParserMatchedStatement ::= assignmentStatement
    assignmentStatement,

    // ParserMatchedStatement ::= callStatement
    callStatement,

    // ParserMatchedStatement ::= directApplicationStatement
    directApplicationStatement,

    // ParserMatchedStatement ::= parserBlockStatement
    parserBlockStatement,

    // ParserMatchedStatement ::= "IF" "L_PAREN" expression "R_PAREN" ParserMatchedStatement "ELSE"
    //     ParserMatchedStatement
    <l:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:ParserMatchedStatement> "ELSE"
        <no:ParserMatchedStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "IF `( expression `) parserStatement ELSE parserStatement",
            args: vec![condition, yes, no],
            typ: "parserConditionalStatement",
            span: context.location_span(l, r),
        }?) }),
};

ParserUnmatchedStatement: Value = {
    // ParserUnmatchedStatement ::= "IF" "L_PAREN" expression "R_PAREN" parserStatement
    <l:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:parserStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
