tableActionReference: ValueRef = {
    <n:prefixedNonTypeName> => n,
    <left:@L> <n:prefixedNonTypeName> "L_PAREN" <al:argumentList> "R_PAREN" <right:@R> => value::case_value(context, "prefixedNonTypeName `( argumentList `)", vec![n, al], "tableActionReference", left, right),
};

