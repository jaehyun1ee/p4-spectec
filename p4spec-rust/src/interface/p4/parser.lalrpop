};

// tableEntry ::= constOpt tableEntryPriority keysetExpression colon tableActionReference annotationList "SEMICOLON"
//   | constOpt keysetExpression colon tableActionReference annotationList "SEMICOLON"
tableEntry: ValueRef = {
    <left:@L> <c:constOpt> <p:tableEntryPriority> <k:keysetExpression> colon <ac:tableActionReference> <al:annotationList> "SEMICOLON" <right:@R> => value::case_value(context, "constOpt tableEntryPriority keysetExpression ':' tableActionReference annotationList ';'", vec![c, p, k, ac, al], "tableEntry", left, right),
    <left:@L> <c:constOpt> <k:keysetExpression> colon <ac:tableActionReference> <al:annotationList> "SEMICOLON" <right:@R> => value::case_value(context, "constOpt keysetExpression ':' tableActionReference annotationList ';'", vec![c, k, ac, al], "tableEntry", left, right),
};

// tableEntryList ::= epsilon
