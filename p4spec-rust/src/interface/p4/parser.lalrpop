derivedTypeDeclaration: Value = {
    // derivedTypeDeclaration ::= enumTypeDeclaration
    <d:enumTypeDeclaration> => d,

    // derivedTypeDeclaration ::= structTypeDeclaration
    <d:structTypeDeclaration> => d,

    // derivedTypeDeclaration ::= headerTypeDeclaration
    <d:headerTypeDeclaration> => d,

    // derivedTypeDeclaration ::= headerUnionTypeDeclaration
    <d:headerUnionTypeDeclaration> => d,
};

// - Typedef and newtype declarations
typedef: Value = {
    // typedef ::= typeRef
    <t:typeRef> => t,

    // typedef ::= derivedTypeDeclaration
    <t:derivedTypeDeclaration> => {
    let id = extract::id_declaration(arena, &t).expect("known P4 declaration shape");
    let has_params = extract::has_type_params_declaration(arena, &t)
        .expect("known P4 declaration type parameters");
    context.declare_typ(id, has_params).expect("P4 parser scope");
    t
},
};

typedefDeclaration: Value = {
    // typedefDeclaration ::= annotationList "TYPEDEF" typedef name "SEMICOLON"
    <l:@L> <al:annotationList> "TYPEDEF" <t:typedef> <n:name> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList TYPEDEF typedef name ';'",
            args: vec![al, t, n],
            typ: "typedefDeclaration",
            span: context.location_span(l, r),
        }?) }),

    // typedefDeclaration ::= annotationList "TYPE" typeRef name "SEMICOLON"
    <l:@L> <al:annotationList> "TYPE" <t:typeRef> <n:name> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList TYPE typeRef name ';'",
            args: vec![al, t, n],
            typ: "typedefDeclaration",
            span: context.location_span(l, r),
        }?) }),
};

// - Extern declarations
externFunctionDeclaration: Value = {
    // externFunctionDeclaration ::= annotationList "EXTERN" functionPrototype pop_scope "SEMICOLON"
    <l:@L> <al:annotationList> "EXTERN" <p:functionPrototype> pop_scope "SEMICOLON" <r:@R> =>? parse::action(|| { Ok({
        let id = extract::id_function_prototype(arena, &p)
            .expect("known P4 function prototype");
        let has_params = extract::has_type_params_function_prototype(arena, &p)
            .expect("known P4 function prototype type parameters");
        context
            .declare_var(id, has_params, TypeId::Empty)
            .expect("P4 parser scope");
        make::case! { arena: arena,
            shape: "annotationList EXTERN functionPrototype ';'",
            args: vec![al, p],
            typ: "externFunctionDeclaration",
            span: context.location_span(l, r),
        }?
    }) }),
};

// An extern constructor name can carry either type-name marker depending on
// the following token, so this production accepts both classifications.
constructorTypeIdentifier: Value = {
    // constructorTypeIdentifier ::= token_name "TYPENAME"
    <l:@L> <text:token_name> "TYPENAME" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "_TID text",
            args: vec![text],
            typ: "typeIdentifier",
            span: context.location_span(l, r),
        }?) }),

    // constructorTypeIdentifier ::= token_name "TYPENAME_EXPR"
    <l:@L> <text:token_name> "TYPENAME_EXPR" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "_TID text",
            args: vec![text],
            typ: "typeIdentifier",
            span: context.location_span(l, r),
        }?) }),
};

externConstructorPrototype: Value = {
    // externConstructorPrototype ::= annotationList constructorTypeIdentifier "L_PAREN" parameterList
    //     "R_PAREN" "SEMICOLON"
    <l:@L> <al:annotationList> <tid:constructorTypeIdentifier> "L_PAREN" <pl:parameterList>
        "R_PAREN" "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList typeIdentifier `( parameterList `) ';'",
            args: vec![al, tid, pl],
            typ: "externConstructorPrototype",
            span: context.location_span(l, r),
        }?) }),
};

externMethodPrototype: Value = {
    // externMethodPrototype ::= annotationList functionPrototype pop_scope "SEMICOLON"
    <l:@L> <al:annotationList> <p:functionPrototype> pop_scope "SEMICOLON" <r:@R> =>? parse::action(|| { Ok({
        let id = extract::id_function_prototype(arena, &p)
            .expect("known P4 function prototype");
        let has_params = extract::has_type_params_function_prototype(arena, &p)
            .expect("known P4 function prototype type parameters");
        context
            .declare_var(id, has_params, TypeId::Empty)
            .expect("P4 parser scope");
        make::case! { arena: arena,
            shape: "annotationList functionPrototype ';'",
            args: vec![al, p],
            typ: "externMethodPrototype",
            span: context.location_span(l, r),
        }?
    }) }),

    // externMethodPrototype ::= annotationList "ABSTRACT" functionPrototype pop_scope "SEMICOLON"
    <l:@L> <al:annotationList> "ABSTRACT" <p:functionPrototype> pop_scope "SEMICOLON" <r:@R>
        =>? parse::action(|| { Ok({
            let id = extract::id_function_prototype(arena, &p)
                .expect("known P4 function prototype");
            let has_params = extract::has_type_params_function_prototype(arena, &p)
                .expect("known P4 function prototype type parameters");
            context
                .declare_var(id, has_params, TypeId::Empty)
                .expect("P4 parser scope");
            make::case! { arena: arena,
                shape: "annotationList ABSTRACT functionPrototype ';'",
                args: vec![al, p],
                typ: "externMethodPrototype",
                span: context.location_span(l, r),
            }?
        }) }),
};

externConstructorOrMethodPrototype: Value = {
    // externConstructorOrMethodPrototype ::= externConstructorPrototype
    <p:externConstructorPrototype> => p,

    // externConstructorOrMethodPrototype ::= externMethodPrototype
    <p:externMethodPrototype> => p,
};

externConstructorOrMethodPrototypeList: Value = {
    // externConstructorOrMethodPrototypeList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "_EMPTY",
            args: vec![],
            typ: "externConstructorOrMethodPrototypeList",
            span: context.location_span(l, r),
        }?) }),

    // externConstructorOrMethodPrototypeList ::= externConstructorOrMethodPrototypeList
    //     externConstructorOrMethodPrototype
    <l:@L> <pl:externConstructorOrMethodPrototypeList> <p:externConstructorOrMethodPrototype>
        <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "externConstructorOrMethodPrototypeList externConstructorOrMethodPrototype",
            args: vec![pl, p],
            typ: "externConstructorOrMethodPrototypeList",
            span: context.location_span(l, r),
        }?) }),
};

externObjectDeclaration: Value = {
    // externObjectDeclaration ::= annotationList "EXTERN" push_externName typeParameterListOpt
    //     "L_BRACE" externConstructorOrMethodPrototypeList "R_BRACE" pop_scope
    <l:@L> <al:annotationList> "EXTERN" <n:push_externName> <tpl:typeParameterListOpt> "L_BRACE"
        <pl:externConstructorOrMethodPrototypeList> "R_BRACE" <s:pop_scope> <r:@R> =>? parse::action(|| { Ok({
            let decl = make::case! { arena: arena,
                shape: "annotationList EXTERN name typeParameterListOpt `{ externConstructorOrMethodPrototypeList `}",
                args: vec![al, n, tpl, pl],
                typ: "externObjectDeclaration",
                span: context.location_span(l, r),
            }?;
            declare::typ(arena,
                context,
                &n,
                extract::has_type_params_declaration(arena, &decl)
                    .expect("known P4 declaration type parameters"),
            );
            declare::type_namespace(arena, context, &n, s);
            decl
        }) }),
};

externDeclaration: Value = {
    // externDeclaration ::= externFunctionDeclaration
    <d:externFunctionDeclaration> => d,

    // externDeclaration ::= externObjectDeclaration
    <d:externObjectDeclaration> => d,
};

// - Parser statements and declarations

// - Select expressions
selectCase: Value = {
    // selectCase ::= keysetExpression "COLON" name "SEMICOLON"
    <l:@L> <k:keysetExpression> colon <n:name> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "keysetExpression ':' name ';'",
            args: vec![k, n],
            typ: "selectCase",
            span: context.location_span(l, r),
        }?) }),
};

selectCaseList: Value = {
    // selectCaseList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "selectCaseList",
        span: context.location_span(l, r),
    }?) }),

    // selectCaseList ::= selectCaseList selectCase
    <l:@L> <cl:selectCaseList> <c:selectCase> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "selectCaseList selectCase",
            args: vec![cl, c],
            typ: "selectCaseList",
            span: context.location_span(l, r),
        }?) }),
};

selectExpression: Value = {
    // selectExpression ::= "SELECT" "L_PAREN" "R_PAREN" "L_BRACE" selectCaseList "R_BRACE"
    <l:@L> "SELECT" "L_PAREN" <empty_l:@L> "R_PAREN" "L_BRACE" <cl:selectCaseList> "R_BRACE" <r:@R> =>? parse::action(|| { Ok({
    let empty = make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "expressionList",
        span: context.location_span(empty_l, empty_l),
    }?;
    make::case! { arena: arena,
        shape: "SELECT `( expressionList `) `{ selectCaseList `}",
        args: vec![empty, cl],
        typ: "selectExpression",
        span: context.location_span(l, r),
    }?
}) }),

    // selectExpression ::= "SELECT" "L_PAREN" expressionList "R_PAREN" "L_BRACE" selectCaseList
    //     "R_BRACE"
    <l:@L> "SELECT" "L_PAREN" <el:expressionList> "R_PAREN" "L_BRACE" <cl:selectCaseList>
        "R_BRACE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "SELECT `( expressionList `) `{ selectCaseList `}",
            args: vec![el, cl],
            typ: "selectExpression",
            span: context.location_span(l, r),
        }?) }),
};

// - Transition statements
stateExpression: Value = {
    // stateExpression ::= name "SEMICOLON"
    <l:@L> <n:name> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "name ';'",
            args: vec![n],
            typ: "stateExpression",
            span: context.location_span(l, r),
        }?) }),

    // stateExpression ::= selectExpression
    <e:selectExpression> => e,
};

#[inline]
transitionStatement: Value = {
