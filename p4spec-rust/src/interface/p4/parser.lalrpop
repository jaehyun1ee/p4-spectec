    //   r_angle "L_PAREN" expression "R_PAREN" name "SEMICOLON"
    <l:@L> <al:annotationList> "VALUE_SET" "L_ANGLE_ARGS" <t:valueSetType> r_angle "L_PAREN"
        <s:expression> "R_PAREN" <n:name> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList VALUE_SET `< valueSetType `> `( expression `) name ';'",
