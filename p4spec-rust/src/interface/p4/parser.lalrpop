};

// tableProperty ::= "KEY" "ASSIGN" "L_BRACE" tableKeyList "R_BRACE"
//   | "ACTIONS" "ASSIGN" "L_BRACE" tableActionList "R_BRACE"
//   | annotationList constOpt "ENTRIES" "ASSIGN" "L_BRACE" tableEntryList "R_BRACE"
//   | annotationList constOpt tableCustomName initialValue "SEMICOLON"
tableProperty: ValueRef = {
    <left:@L> "KEY" "ASSIGN" "L_BRACE" <kl:tableKeyList> "R_BRACE" <right:@R> => value::case_value(context, "KEY '=' `{ tableKeyList `}", vec![kl], "tableProperty", left, right),
    <left:@L> "ACTIONS" "ASSIGN" "L_BRACE" <acl:tableActionList> "R_BRACE" <right:@R> => value::case_value(context, "ACTIONS '=' `{ tableActionList `}", vec![acl], "tableProperty", left, right),
    <left:@L> <al:annotationList> <c:constOpt> "ENTRIES" "ASSIGN" "L_BRACE" <el:tableEntryList> "R_BRACE" <right:@R> => value::case_value(context, "annotationList constOpt ENTRIES '=' `{ tableEntryList `}", vec![al, c, el], "tableProperty", left, right),
    <left:@L> <al:annotationList> <c:constOpt> <n:tableCustomName> <i:initialValue> "SEMICOLON" <right:@R> => value::case_value(context, "annotationList constOpt tableCustomName initializer ';'", vec![al, c, n, i], "tableProperty", left, right),
};

// tablePropertyList ::= epsilon
//   | tablePropertyList tableProperty
tablePropertyList: ValueRef = {
    <left:@L>  <right:@R> => value::case_value(context, "_EMPTY", vec![], "tablePropertyList", left, right),
    <left:@L> <pl:tablePropertyList> <p:tableProperty> <right:@R> => value::case_value(context, "tablePropertyList tableProperty", vec![pl, p], "tablePropertyList", left, right),
};

