};

// controlDeclaration ::= annotationList "CONTROL" push_name typeParameterListOpt "L_PAREN" parameterList "R_PAREN" constructorParameterListOpt "L_BRACE" controlLocalDeclarationList "APPLY" controlBody "R_BRACE" pop_scope
controlDeclaration: ValueRef = {
    <left:@L> <al:annotationList> "CONTROL" <n:push_name> <tpl:typeParameterListOpt> "L_PAREN" <pl:parameterList> "R_PAREN" <cpl:constructorParameterListOpt> "L_BRACE" <dl:controlLocalDeclarationList> "APPLY" <b:controlBody> "R_BRACE" pop_scope <right:@R> => value::case_value(context, "annotationList CONTROL name typeParameterListOpt `( parameterList `) constructorParameterListOpt `{ controlLocalDeclarationList APPLY controlBody `}", vec![al, n, tpl, pl, cpl, dl, b], "controlDeclaration", left, right),
};

// packageTypeDeclaration ::= annotationList "PACKAGE" push_name typeParameterListOpt "L_PAREN" parameterList "R_PAREN" pop_scope "SEMICOLON"
packageTypeDeclaration: ValueRef = {
    <left:@L> <al:annotationList> "PACKAGE" <n:push_name> <tpl:typeParameterListOpt> "L_PAREN" <pl:parameterList> "R_PAREN" pop_scope "SEMICOLON" <right:@R> => value::case_value(context, "annotationList PACKAGE name typeParameterListOpt `( parameterList `) ';'", vec![al, n, tpl, pl], "packageTypeDeclaration", left, right),
};

// typeDeclaration ::= derivedTypeDeclaration
//   | typedefDeclaration
//   | parserTypeDeclaration
//   | controlTypeDeclaration
//   | packageTypeDeclaration
typeDeclaration: ValueRef = {
    <d:derivedTypeDeclaration> => d,
    <d:typedefDeclaration> => d,
    <d:parserTypeDeclaration> => d,
    <d:controlTypeDeclaration> => d,
    <d:packageTypeDeclaration> => d,
};

// declaration ::= constantDeclaration
//   | instantiation
//   | functionDeclaration
//   | actionDeclaration
//   | errorDeclaration
//   | matchKindDeclaration
//   | externDeclaration
//   | parserDeclaration
//   | controlDeclaration
//   | typeDeclaration
declaration: ValueRef = {
    <constant:constantDeclaration> => { value::declare_declaration_var(context, &constant); constant },
    <inst:instantiation> => { value::declare_declaration_var(context, &inst); inst },
    <func:functionDeclaration> => { value::declare_declaration_var(context, &func); func },
    <action:actionDeclaration> => { value::declare_declaration_var(context, &action); action },
    <d:errorDeclaration> => d,
    <d:matchKindDeclaration> => d,
    <d:externDeclaration> => d,
    <d:parserDeclaration> => { value::declare_declaration_type(context, &d); d },
    <d:controlDeclaration> => { value::declare_declaration_type(context, &d); d },
    <d:typeDeclaration> => { value::declare_declaration_type(context, &d); d },
};

