// - Declarations

declaration: Value = {
    // declaration ::= constantDeclaration
    <constant:constantDeclaration> => {
    let id = extract::id_declaration(arena, &constant).expect("known P4 declaration shape");
    let has_params = extract::has_type_params_declaration(arena, &constant)
        .expect("known P4 declaration type parameters");
    let type_id = extract::type_id_declaration(arena, &constant)
        .expect("known P4 declaration type");
    context.declare_var(id, has_params, type_id).expect("P4 parser scope");
    constant
},

    // declaration ::= instantiation
    <inst:instantiation> => {
    let id = extract::id_declaration(arena, &inst).expect("known P4 declaration shape");
    let type_id = extract::type_id_declaration(arena, &inst).expect("known P4 declaration type");
    context.declare_var(id, false, type_id).expect("P4 parser scope");
    inst
},

    // declaration ::= functionDeclaration
    <func:functionDeclaration> => {
    let id = extract::id_declaration(arena, &func).expect("known P4 declaration shape");
    let has_params = extract::has_type_params_declaration(arena, &func)
        .expect("known P4 declaration type parameters");
    context.declare_var(id, has_params, TypeId::Empty).expect("P4 parser scope");
    func
},

    // declaration ::= actionDeclaration
    <action:actionDeclaration> => {
    let id = extract::id_declaration(arena, &action).expect("known P4 declaration shape");
    context.declare_var(id, false, TypeId::Empty).expect("P4 parser scope");
    action
},

    // declaration ::= errorDeclaration
    <d:errorDeclaration> => d,

    // declaration ::= matchKindDeclaration
    <d:matchKindDeclaration> => d,

    // declaration ::= externDeclaration
    <d:externDeclaration> => d,

    // declaration ::= parserDeclaration
    <d:parserDeclaration> => {
    let id = extract::id_declaration(arena, &d).expect("known P4 declaration shape");
    let has_params = extract::has_type_params_declaration(arena, &d)
        .expect("known P4 declaration type parameters");
    context.declare_typ(id, has_params).expect("P4 parser scope");
    d
},

    // declaration ::= controlDeclaration
    <d:controlDeclaration> => {
    let id = extract::id_declaration(arena, &d).expect("known P4 declaration shape");
    let has_params = extract::has_type_params_declaration(arena, &d)
        .expect("known P4 declaration type parameters");
    context.declare_typ(id, has_params).expect("P4 parser scope");
    d
},

    // declaration ::= typeDeclaration
    <d:typeDeclaration> => {
    let id = extract::id_declaration(arena, &d).expect("known P4 declaration shape");
    let has_params = extract::has_type_params_declaration(arena, &d)
        .expect("known P4 declaration type parameters");
    context.declare_typ(id, has_params).expect("P4 parser scope");
    d
},
};

