switchCaseList: ValueRef = {
    <left:@L>  <right:@R> => value::case_value(context, "_EMPTY", vec![], "switchCaseList", left, right),
    <left:@L> <cs:switchCaseList> <c:switchCase> <right:@R> => value::case_value(context, "switchCaseList switchCase", vec![cs, c], "switchCaseList", left, right),
};

switchStatement: ValueRef = {
