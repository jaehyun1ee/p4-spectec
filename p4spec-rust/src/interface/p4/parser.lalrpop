tableDeclaration: ValueRef = {
    <left:@L> <al:annotationList> "TABLE" <n:name> "L_BRACE" <pl:tablePropertyList> "R_BRACE" <right:@R> => value::case_value(context, "annotationList TABLE name `{ tablePropertyList `}", vec![al, n, pl], "tableDeclaration", left, right),
};

// controlTypeDeclaration ::= annotationList "CONTROL" push_name typeParameterListOpt "L_PAREN" parameterList "R_PAREN" pop_scope "SEMICOLON"
controlTypeDeclaration: ValueRef = {
    <left:@L> <al:annotationList> "CONTROL" <n:push_name> <tpl:typeParameterListOpt> "L_PAREN" <pl:parameterList> "R_PAREN" pop_scope "SEMICOLON" <right:@R> => value::case_value(context, "annotationList CONTROL name typeParameterListOpt `( parameterList `) ';'", vec![al, n, tpl, pl], "controlTypeDeclaration", left, right),
};

// controlBody ::= blockStatement
controlBody: ValueRef = {
    <b:blockStatement> => b,
};

// controlLocalDeclaration ::= constantDeclaration
//   | instantiation
