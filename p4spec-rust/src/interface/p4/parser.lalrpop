// - Parser declarations
parserBlockElementStatement: Value = {
    // parserBlockElementStatement ::= constantDeclaration
    <s:constantDeclaration> => s,

    // parserBlockElementStatement ::= variableDeclaration
    <s:variableDeclaration> => s,

    // parserBlockElementStatement ::= parserStatement
    <s:parserStatement> => s,
};

parserBlockElementStatementList: Value = {
    // parserBlockElementStatementList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "_EMPTY",
            args: vec![],
            typ: "parserBlockElementStatementList",
            span: context.location_span(l, r),
        }?) }),

    // parserBlockElementStatementList ::= parserBlockElementStatementList
    //     parserBlockElementStatement
    <l:@L> <sl:parserBlockElementStatementList> <s:parserBlockElementStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "parserBlockElementStatementList parserBlockElementStatement",
            args: vec![sl, s],
            typ: "parserBlockElementStatementList",
            span: context.location_span(l, r),
        }?) }),
