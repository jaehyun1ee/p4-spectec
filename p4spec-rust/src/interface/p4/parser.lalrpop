    <l:@L> <b:expression> "MASK" <m:expression> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "expression '&&&' expression",
            args: vec![b, m],
            typ: "simpleKeysetExpression",
            span: context.location_span(l, r),
        }?) }),

    // simpleKeysetExpression ::= expression "RANGE" expression
    <l:@L> <lo:expression> "RANGE" <hi:expression> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "expression '..' expression",
            args: vec![lo, hi],
            typ: "simpleKeysetExpression",
            span: context.location_span(l, r),
        }?) }),

    // simpleKeysetExpression ::= "DEFAULT"
    <l:@L> "DEFAULT" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "DEFAULT",
            args: vec![],
            typ: "simpleKeysetExpression",
            span: context.location_span(l, r),
        }?) }),

    // simpleKeysetExpression ::= "DONTCARE"
    <l:@L> "DONTCARE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "'_'",
        args: vec![],
        typ: "simpleKeysetExpression",
        span: context.location_span(l, r),
    }?) }),
};

simpleKeysetExpressionList: Value = {
    // simpleKeysetExpressionList ::= simpleKeysetExpression
    <e:simpleKeysetExpression> => e,

