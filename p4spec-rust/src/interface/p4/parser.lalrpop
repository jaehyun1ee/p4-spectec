use crate::lang::common::source::Phrase;

use crate::{
    interface::p4::{
        binary::{self, BinaryExpressionPart, BinaryOperator},
        context::{Context, Location, Namespace, TypeId},
        declare,
        error::P4Error,
        extract,
        lexer::{Token, IntegerLiteral},
        parse,
    },
    lang::data::value::{Value, ValueArena, make},
};

grammar(context: &Context, arena: &mut ValueArena);

// == Tokens

extern {
    type Location = Location;
    type Error = P4Error;

    enum Token {
        "END" => Token::End,
        "TYPENAME" => Token::TypeName,
        "TYPENAME_EXPR" => Token::TypeNameExpression,
        "IDENTIFIER" => Token::Identifier,
        "RAW_NAME" => Token::Name(<Box<Phrase<String>>>),
        "RAW_STRING_LITERAL" => Token::StringLiteral(<Box<Phrase<String>>>),
        "RAW_NUMBER_INT" => Token::NumberInt(<Box<Phrase<IntegerLiteral>>>, <String>),
        "RAW_NUMBER" => Token::Number(<Box<Phrase<IntegerLiteral>>>, <String>),
        "LE" => Token::LessEqual,
        "GE" => Token::GreaterEqual,
        "SHL" => Token::ShiftLeft,
        "AND" => Token::And,
        "OR" => Token::Or,
        "NE" => Token::NotEqual,
        "EQ" => Token::Equal,
        "PLUS" => Token::Plus,
        "MINUS" => Token::Minus,
        "PLUS_SAT" => Token::PlusSaturating,
        "MINUS_SAT" => Token::MinusSaturating,
        "MUL" => Token::Multiply,
        "INVALID" => Token::Invalid,
        "DIV" => Token::Divide,
        "MOD" => Token::Modulo,
        "BIT_OR" => Token::BitOr,
        "BIT_AND" => Token::BitAnd,
        "BIT_XOR" => Token::BitXor,
        "COMPLEMENT" => Token::Complement,
        "L_BRACKET" => Token::LeftBracket,
        "R_BRACKET" => Token::RightBracket,
        "L_BRACE" => Token::LeftBrace,
        "R_BRACE" => Token::RightBrace,
        "L_ANGLE" => Token::LeftAngle,
        "L_ANGLE_ARGS" => Token::LeftAngleArgs,
        "R_ANGLE" => Token::RightAngle,
        "R_ANGLE_SHIFT" => Token::RightAngleShift,
        "L_PAREN" => Token::LeftParen,
        "R_PAREN" => Token::RightParen,
        "ASSIGN" => Token::Assign,
        "COLON" => Token::Colon,
        "BLOCK_COLON" => Token::BlockColon,
        "COMMA" => Token::Comma,
        "TRAILING_COMMA" => Token::TrailingComma,
        "QUESTION" => Token::Question,
        "DOT" => Token::Dot,
        "NOT" => Token::Not,
        "SEMICOLON" => Token::Semicolon,
        "AT" => Token::At,
        "PLUSPLUS" => Token::PlusPlus,
        "PLUSCOLON" => Token::PlusColon,
        "DONTCARE" => Token::DontCare,
        "MASK" => Token::Mask,
        "DOTS" => Token::Dots,
        "RANGE" => Token::Range,
        "TRUE" => Token::True,
        "FALSE" => Token::False,
        "ABSTRACT" => Token::Abstract,
        "ACTION" => Token::Action,
        "ACTIONS" => Token::Actions,
        "APPLY" => Token::Apply,
        "BOOL" => Token::Bool,
        "BIT" => Token::Bit,
        "BREAK" => Token::Break,
        "CONST" => Token::Const,
        "CONTINUE" => Token::Continue,
        "CONTROL" => Token::Control,
        "DEFAULT" => Token::Default,
        "ELSE" => Token::Else,
        "ENTRIES" => Token::Entries,
        "ENUM" => Token::Enum,
        "ERROR" => Token::Error,
        "ERROR_EXPR" => Token::ErrorExpression,
        "EXIT" => Token::Exit,
        "EXTERN" => Token::Extern,
        "HEADER" => Token::Header,
        "HEADER_UNION" => Token::HeaderUnion,
        "IF" => Token::If,
        "IN" => Token::In,
        "INOUT" => Token::InOut,
        "FOR" => Token::For,
        "INT" => Token::Int,
        "KEY" => Token::Key,
        "LIST" => Token::List,
        "SELECT" => Token::Select,
        "MATCH_KIND" => Token::MatchKind,
        "OUT" => Token::Out,
        "PACKAGE" => Token::Package,
        "PARSER" => Token::Parser,
        "PRIORITY" => Token::Priority,
        "RETURN" => Token::Return,
        "STATE" => Token::State,
        "STRING" => Token::String,
        "STRUCT" => Token::Struct,
        "SWITCH" => Token::Switch,
        "TABLE" => Token::Table,
        "THIS" => Token::This,
        "TRANSITION" => Token::Transition,
        "TUPLE" => Token::Tuple,
        "TYPEDEF" => Token::Typedef,
        "TYPE" => Token::Type,
        "VALUE_SET" => Token::ValueSet,
        "VARBIT" => Token::Varbit,
        "VOID" => Token::Void,
        "PRAGMA" => Token::Pragma,
        "PRAGMA_END" => Token::PragmaEnd,
        "PLUS_ASSIGN" => Token::PlusAssign,
        "PLUS_SAT_ASSIGN" => Token::PlusSaturatingAssign,
        "MINUS_ASSIGN" => Token::MinusAssign,
        "MINUS_SAT_ASSIGN" => Token::MinusSaturatingAssign,
        "MUL_ASSIGN" => Token::MultiplyAssign,
        "DIV_ASSIGN" => Token::DivideAssign,
        "MOD_ASSIGN" => Token::ModuloAssign,
        "SHL_ASSIGN" => Token::ShiftLeftAssign,
        "SHR_ASSIGN" => Token::ShiftRightAssign,
        "BIT_AND_ASSIGN" => Token::BitAndAssign,
        "BIT_XOR_ASSIGN" => Token::BitXorAssign,
        "BIT_OR_ASSIGN" => Token::BitOrAssign,
        "RAW_UNEXPECTED_TOKEN" => Token::UnexpectedToken(<Box<Phrase<String>>>),
    }
}

token_name: Value = <value:"RAW_NAME"> =>? parse::action(|| make::text(arena, value.node, value.span).map_err(Into::into));
token_string_literal: Value = <value:"RAW_STRING_LITERAL"> =>? parse::action(|| make::text(arena, value.node, value.span).map_err(Into::into));
token_unexpected_token: Value = <value:"RAW_UNEXPECTED_TOKEN"> =>? parse::action(|| make::text(arena, value.node, value.span).map_err(Into::into));
token_number_int: (Value, String) = <value:"RAW_NUMBER_INT"> =>? parse::action(|| Ok((parse::integer(arena, *value.0)?, value.1)));
token_number: (Value, String) = <value:"RAW_NUMBER"> =>? parse::action(|| Ok((parse::integer(arena, *value.0)?, value.1)));

// == LALRPOP token adapters

#[inline]
colon: () = {
    // colon ::= "COLON"
    "COLON" => (),

    // colon ::= "BLOCK_COLON"
    "BLOCK_COLON" => (),
};

#[inline]
plain_colon: () = {
    // plain_colon ::= "COLON"
    "COLON" => (),
};

// == Contexts

push_scope: () = {
    // push_scope ::= epsilon
     => { context.scope_push(); },
};

// A name followed by `(` or `<...>(` may already carry postfix-expression
// classification when the surrounding declaration reduces.
declarationName: Value = {
    name,
    expressionTypeName,
};

push_name: Value = {
    // push_name ::= name
    <n:declarationName> => { context.scope_push(); declare::typ(arena, context, &n, false); n },
};

push_externName: Value = {
    // push_externName ::= externName
    <n:externName> => { context.scope_push(); declare::typ(arena, context, &n, false); n },
};

pop_scope: Namespace = {
    // pop_scope ::= epsilon
     => context.scope_pop().expect("P4 parser scope"),
};

go_toplevel: () = {
    // go_toplevel ::= epsilon
     => { context.scope_to_toplevel().expect("P4 parser scope"); },
};

go_local: () = {
    // go_local ::= epsilon
     => context.scope_to_local(),
};

toplevel<X>: X = {
    // toplevel ::= go_toplevel X go_local
    go_toplevel <x:X> go_local => x,
};

set_parent_namespace: () = {
    // set_parent_namespace ::= epsilon
     => context.namespace_set_parent(),
};

clear_parent_namespace: () = {
    // clear_parent_namespace ::= epsilon
     => context.namespace_clear_parent(),
};

// == P4-16 grammar

// - Aux

externName: Value = {
    // externName ::= nonTypeName
    <n:nonTypeName> => { declare::typ(arena, context, &n, false); n },
};

int: Value = {
    // int ::= token_number_int
    <int:token_number_int> => int.0,
};

r_angle: () = {
    // r_angle ::= "R_ANGLE"
    <r_angle:"R_ANGLE"> => (),

    // r_angle ::= "R_ANGLE_SHIFT"
    <r_angle:"R_ANGLE_SHIFT"> => (),
};

l_angle: () = {
    // l_angle ::= "L_ANGLE"
    <l_angle:"L_ANGLE"> => (),

    // l_angle ::= "L_ANGLE_ARGS"
    <l_angle:"L_ANGLE_ARGS"> => (),
};

// - Misc

// `TRAILING_COMMA` preserves the canonical `COMMA` after lexer lookahead.
trailingCommaOpt: Value = {
    // trailingCommaOpt ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "trailingCommaOpt",
        span: context.location_span(l, r),
    }?) }),

    // trailingCommaOpt ::= "COMMA"
    <l:@L> "TRAILING_COMMA" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "','",
        args: vec![],
        typ: "trailingCommaOpt",
        span: context.location_span(l, r),
    }?) }),
};

// - Booleans

booleanLiteral: Value = {
    // booleanLiteral ::= "TRUE"
    <l:@L> "TRUE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "TRUE",
        args: vec![],
        typ: "booleanLiteral",
        span: context.location_span(l, r),
    }?) }),

    // booleanLiteral ::= "FALSE"
    <l:@L> "FALSE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "FALSE",
        args: vec![],
        typ: "booleanLiteral",
        span: context.location_span(l, r),
    }?) }),
};

// - Integers

integerLiteral: Value = {
    // integerLiteral ::= int
    <l:@L> <int:int> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "D int",
        args: vec![int],
        typ: "integerLiteral",
        span: context.location_span(l, r),
    }?) }),

    // integerLiteral ::= token_number
    <number:token_number> => number.0,
};

// - Strings

stringLiteral: Value = {
    // stringLiteral ::= token_string_literal
    <l:@L> <text:token_string_literal> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "'\"' text '\"'",
            args: vec![text],
            typ: "stringLiteral",
            span: context.location_span(l, r),
        }?) }),
};

// - Names

identifier: Value = {
    // identifier ::= token_name "IDENTIFIER"
    <l:@L> <text:token_name> "IDENTIFIER" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "_ID text",
            args: vec![text],
            typ: "identifier",
            span: context.location_span(l, r),
        }?) }),
};

typeIdentifier: Value = {
    // typeIdentifier ::= token_name "TYPENAME"
    <l:@L> <text:token_name> "TYPENAME" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "_TID text",
            args: vec![text],
            typ: "typeIdentifier",
            span: context.location_span(l, r),
        }?) }),
};

// - Non-type names

nonTypeName: Value = {
    // nonTypeName ::= identifier
    <id:identifier> => id,

    // nonTypeName ::= "APPLY"
    <l:@L> "APPLY" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "APPLY",
        args: vec![],
        typ: "nonTypeName",
        span: context.location_span(l, r),
    }?) }),

    // nonTypeName ::= "KEY"
    <l:@L> "KEY" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "KEY",
        args: vec![],
        typ: "nonTypeName",
        span: context.location_span(l, r),
    }?) }),

    // nonTypeName ::= "ACTIONS"
    <l:@L> "ACTIONS" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "ACTIONS",
        args: vec![],
        typ: "nonTypeName",
        span: context.location_span(l, r),
    }?) }),

    // nonTypeName ::= "STATE"
    <l:@L> "STATE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "STATE",
        args: vec![],
        typ: "nonTypeName",
        span: context.location_span(l, r),
    }?) }),

    // nonTypeName ::= "ENTRIES"
    <l:@L> "ENTRIES" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "ENTRIES",
        args: vec![],
        typ: "nonTypeName",
        span: context.location_span(l, r),
    }?) }),

    // nonTypeName ::= "TYPE"
    <l:@L> "TYPE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "TYPE",
        args: vec![],
        typ: "nonTypeName",
        span: context.location_span(l, r),
    }?) }),

    // nonTypeName ::= "PRIORITY"
    <l:@L> "PRIORITY" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "PRIORITY",
        args: vec![],
        typ: "nonTypeName",
        span: context.location_span(l, r),
    }?) }),
};

prefixedNonTypeName: Value = {
    // prefixedNonTypeName ::= nonTypeName
    <n:nonTypeName> => n,

    // prefixedNonTypeName ::= "DOT" go_toplevel nonTypeName go_local
    <l:@L> "DOT" go_toplevel <n:nonTypeName> go_local <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "_ID '.' nonTypeName",
            args: vec![n],
            typ: "prefixedNonTypeName",
            span: context.location_span(l, r),
        }?) }),
};

// - Type names

typeName: Value = {
    // typeName ::= typeIdentifier
    <n:typeIdentifier> => n,
};

prefixedTypeName: Value = {
    // prefixedTypeName ::= typeName
    <n:typeName> => n,

    // prefixedTypeName ::= "DOT" go_toplevel typeName go_local
    <l:@L> "DOT" go_toplevel <tid:typeName> go_local <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "_TID '.' typeName",
            args: vec![tid],
            typ: "prefixedTypeName",
            span: context.location_span(l, r),
        }?) }),
};

// - Table custom property names

tableCustomName: Value = {
    // tableCustomName ::= identifier
    <id:identifier> => id,

    // tableCustomName ::= typeIdentifier
    <tid:typeIdentifier> => tid,

    // tableCustomName ::= "APPLY"
    <l:@L> "APPLY" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "APPLY",
        args: vec![],
        typ: "tableCustomName",
        span: context.location_span(l, r),
    }?) }),

    // tableCustomName ::= "STATE"
    <l:@L> "STATE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "STATE",
        args: vec![],
        typ: "tableCustomName",
        span: context.location_span(l, r),
    }?) }),

    // tableCustomName ::= "TYPE"
    <l:@L> "TYPE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "TYPE",
        args: vec![],
        typ: "tableCustomName",
        span: context.location_span(l, r),
    }?) }),

    // tableCustomName ::= "PRIORITY"
    <l:@L> "PRIORITY" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "PRIORITY",
        args: vec![],
        typ: "tableCustomName",
        span: context.location_span(l, r),
    }?) }),
};

// - Names

name: Value = {
    // name ::= nonTypeName
    <n:nonTypeName> => n,

    // name ::= typeName
    <n:typeName> => n,

    // name ::= "LIST"
    <l:@L> "LIST" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "LIST",
        args: vec![],
        typ: "name",
        span: context.location_span(l, r),
    }?) }),
};

nameList: Value = {
    // nameList ::= name
    <n:name> => n,

    // nameList ::= nameList "COMMA" name
    <l:@L> <ns:nameList> "COMMA" <n:name> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "nameList ',' name",
            args: vec![ns, n],
            typ: "nameList",
            span: context.location_span(l, r),
        }?) }),
};

member: Value = {
    // member ::= name
    <name:name> => name,
};

// - Directions

#[inline]
direction: Value = {
    // direction ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "direction",
        span: context.location_span(l, r),
    }?) }),

    // direction ::= "IN"
    <l:@L> "IN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "IN",
        args: vec![],
        typ: "direction",
        span: context.location_span(l, r),
    }?) }),

    // direction ::= "OUT"
    <l:@L> "OUT" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "OUT",
        args: vec![],
        typ: "direction",
        span: context.location_span(l, r),
    }?) }),

    // direction ::= "INOUT"
    <l:@L> "INOUT" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "INOUT",
        args: vec![],
        typ: "direction",
        span: context.location_span(l, r),
    }?) }),
};

// - Types

// - Base types

baseType: Value = {
    // baseType ::= "BOOL"
    <l:@L> "BOOL" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "BOOL",
        args: vec![],
        typ: "baseType",
        span: context.location_span(l, r),
    }?) }),

    // baseType ::= "MATCH_KIND"
    <l:@L> "MATCH_KIND" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "MATCH_KIND",
        args: vec![],
        typ: "baseType",
        span: context.location_span(l, r),
    }?) }),

    // baseType ::= "ERROR"
    <l:@L> "ERROR" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "ERROR",
        args: vec![],
        typ: "baseType",
        span: context.location_span(l, r),
    }?) }),

    // baseType ::= "BIT"
    <l:@L> "BIT" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "BIT",
        args: vec![],
        typ: "baseType",
        span: context.location_span(l, r),
    }?) }),

    // baseType ::= "STRING"
    <l:@L> "STRING" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "STRING",
        args: vec![],
        typ: "baseType",
        span: context.location_span(l, r),
    }?) }),

    // baseType ::= "INT"
    <l:@L> "INT" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "INT",
        args: vec![],
        typ: "baseType",
        span: context.location_span(l, r),
    }?) }),

    // baseType ::= "BIT" l_angle int r_angle
    <l:@L> "BIT" "L_ANGLE_ARGS" <v:int> r_angle <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "BIT `< int `>",
            args: vec![v],
            typ: "baseType",
            span: context.location_span(l, r),
        }?) }),

    // baseType ::= "INT" l_angle int r_angle
    <l:@L> "INT" "L_ANGLE_ARGS" <v:int> r_angle <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "INT `< int `>",
            args: vec![v],
            typ: "baseType",
            span: context.location_span(l, r),
        }?) }),

    // baseType ::= "VARBIT" l_angle int r_angle
    <l:@L> "VARBIT" "L_ANGLE_ARGS" <v:int> r_angle <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "VARBIT `< int `>",
            args: vec![v],
            typ: "baseType",
            span: context.location_span(l, r),
        }?) }),

    // baseType ::= "BIT" l_angle "L_PAREN" expression "R_PAREN" r_angle
    <l:@L> "BIT" "L_ANGLE_ARGS" "L_PAREN" <e:expression> "R_PAREN" r_angle <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "BIT `< `( expression `) `>",
            args: vec![e],
            typ: "baseType",
            span: context.location_span(l, r),
        }?) }),

    // baseType ::= "INT" l_angle "L_PAREN" expression "R_PAREN" r_angle
    <l:@L> "INT" "L_ANGLE_ARGS" "L_PAREN" <e:expression> "R_PAREN" r_angle <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "INT `< `( expression `) `>",
            args: vec![e],
            typ: "baseType",
            span: context.location_span(l, r),
        }?) }),

    // baseType ::= "VARBIT" l_angle "L_PAREN" expression "R_PAREN" r_angle
    <l:@L> "VARBIT" "L_ANGLE_ARGS" "L_PAREN" <e:expression> "R_PAREN" r_angle <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "VARBIT `< `( expression `) `>",
            args: vec![e],
            typ: "baseType",
            span: context.location_span(l, r),
        }?) }),
};

// - Named types

specializedType: Value = {
    // specializedType ::= prefixedTypeName l_angle typeArgumentList r_angle
    <l:@L> <n:prefixedTypeName> "L_ANGLE_ARGS" <tal:typeArgumentList> r_angle <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "prefixedTypeName `< typeArgumentList `>",
            args: vec![n, tal],
            typ: "specializedType",
            span: context.location_span(l, r),
        }?) }),
};

namedType: Value = {
    // namedType ::= prefixedTypeName
    <t:prefixedTypeName> => t,

    // namedType ::= specializedType
    <t:specializedType> => t,
};

// - Array types

#[inline]
arrayType: Value = {
    // arrayType ::= typeRef "L_BRACKET" expression "R_BRACKET"
    <l:@L> <t:typeRef> "L_BRACKET" <e:expression> "R_BRACKET" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "typeRef `[ expression `]",
            args: vec![t, e],
            typ: "arrayType",
            span: context.location_span(l, r),
        }?) }),
};

// - List types

listType: Value = {
    // listType ::= "LIST" l_angle typeArgument r_angle
    <l:@L> "LIST" "L_ANGLE_ARGS" <targ:typeArgument> r_angle <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "LIST `< typeArgument `>",
            args: vec![targ],
            typ: "listType",
            span: context.location_span(l, r),
        }?) }),
};

// - Tuple types

tupleType: Value = {
    // tupleType ::= "TUPLE" l_angle typeArgumentList r_angle
    <l:@L> "TUPLE" "L_ANGLE_ARGS" <targs:typeArgumentList> r_angle <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "TUPLE `< typeArgumentList `>",
            args: vec![targs],
            typ: "tupleType",
            span: context.location_span(l, r),
        }?) }),
};

// - Types

typeRef: Value = {
    // typeRef ::= baseType
    <t:baseType> => t,

    // typeRef ::= namedType
    <t:namedType> => t,

    // typeRef ::= arrayType
    <t:arrayType> => t,

    // typeRef ::= listType
    <t:listType> => t,

    // typeRef ::= tupleType
    <t:tupleType> => t,
};

typeOrVoid: Value = {
    // typeOrVoid ::= typeRef
    <t:typeRef> => t,

    // typeOrVoid ::= "VOID"
    <l:@L> "VOID" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "VOID",
        args: vec![],
        typ: "typeOrVoid",
        span: context.location_span(l, r),
    }?) }),

    // typeOrVoid ::= identifier
    <id:identifier> => id,
};

// - Type parameters

typeParameter: Value = {
    // typeParameter ::= name
    <n:name> => n,
};

typeParameterList: Value = {
    // typeParameterList ::= typeParameter
    <tp:typeParameter> => tp,

    // typeParameterList ::= typeParameterList "COMMA" typeParameter
    <l:@L> <tps:typeParameterList> "COMMA" <tp:typeParameter> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "typeParameterList ',' typeParameter",
            args: vec![tps, tp],
            typ: "typeParameterList",
            span: context.location_span(l, r),
        }?) }),
};

typeParameterListOpt: Value = {
    // typeParameterListOpt ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "typeParameterListOpt",
        span: context.location_span(l, r),
    }?) }),

    // typeParameterListOpt ::= l_angle typeParameterList r_angle
    <l:@L> l_angle <tps:typeParameterList> r_angle <r:@R> =>? parse::action(|| { Ok({
        declare::typs(arena, context, &tps);
        make::case! { arena: arena,
            shape: "`< typeParameterList `>",
            args: vec![tps],
            typ: "typeParameterListOpt",
            span: context.location_span(l, r),
        }?
    }) }),
};

// - Parameters

parameter: Value = {
    // parameter ::= annotationList direction typeRef name initializerOpt
    <l:@L> <al:annotationList> <dir:direction> <t:typeRef> <n:name> <i:initializerOpt> <r:@R>
        =>? parse::action(|| { Ok({
            declare::var(arena, context, &n, false, Some(&t));
            make::case! { arena: arena,
                shape: "annotationList direction type name initializerOpt",
                args: vec![al, dir, t, n, i],
                typ: "parameter",
                span: context.location_span(l, r),
            }?
        }) }),
};

nonEmptyParameterList: Value = {
    // nonEmptyParameterList ::= parameter
    <p:parameter> => p,

    // nonEmptyParameterList ::= nonEmptyParameterList "COMMA" parameter
    <l:@L> <ps:nonEmptyParameterList> "COMMA" <p:parameter> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "nonEmptyParameterList ',' parameter",
            args: vec![ps, p],
            typ: "nonEmptyParameterList",
            span: context.location_span(l, r),
        }?) }),
};

#[inline]
parameterList: Value = {
    // parameterList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "parameterList",
        span: context.location_span(l, r),
    }?) }),

    // parameterList ::= nonEmptyParameterList
    <ps:nonEmptyParameterList> => ps,
};

// - Constructor parameters

constructorParameterListOpt: Value = {
    // constructorParameterListOpt ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "constructorParameterListOpt",
        span: context.location_span(l, r),
    }?) }),

    // constructorParameterListOpt ::= "L_PAREN" parameterList "R_PAREN"
    <l:@L> "L_PAREN" <ps:parameterList> "R_PAREN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "`( parameterList `)",
            args: vec![ps],
            typ: "constructorParameterListOpt",
            span: context.location_span(l, r),
        }?) }),
};

// - Expression key-value pairs

namedExpression: Value = {
    // namedExpression ::= name "ASSIGN" expression
    <l:@L> <n:name> "ASSIGN" <e:expression> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "name '=' expression",
            args: vec![n, e],
            typ: "namedExpression",
            span: context.location_span(l, r),
        }?) }),
};

namedExpressionList: Value = {
    // namedExpressionList ::= namedExpression
    <e:namedExpression> => e,

    // namedExpressionList ::= namedExpressionList "COMMA" namedExpression
    <l:@L> <es:namedExpressionList> "COMMA" <e:namedExpression> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "namedExpressionList ',' namedExpression",
            args: vec![es, e],
            typ: "namedExpressionList",
            span: context.location_span(l, r),
        }?) }),
};

// - Expressions

// - Literal expressions

literalExpression: Value = {
    // literalExpression ::= booleanLiteral
    <bool:booleanLiteral> => bool,

    // literalExpression ::= integerLiteral
    <int:integerLiteral> => int,

    // literalExpression ::= stringLiteral
    <str:stringLiteral> => str,
};

// - Reference expressions

referenceExpression: Value = {
    // referenceExpression ::= prefixedNonTypeName
    <n:prefixedNonTypeName> => n,

    // referenceExpression ::= "THIS"
    <l:@L> "THIS" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "THIS",
        args: vec![],
        typ: "referenceExpression",
        span: context.location_span(l, r),
    }?) }),
};

// - Default expressions

defaultExpression: Value = {
    // defaultExpression ::= "DOTS"
    <l:@L> "DOTS" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "'...'",
        args: vec![],
        typ: "defaultExpression",
        span: context.location_span(l, r),
    }?) }),
};

// - Unary, binary, and ternary expressions
//
// The source grammar defines `unop` and `binop` independently of precedence.
// These productions retain its operator order; the following ladder makes
// precedence and associativity explicit enough for LALRPOP to remain LR(1).
//
// unop ::= "NOT" | "COMPLEMENT" | "MINUS" | "PLUS"
// unaryExpression ::= unop expression
// binop ::= "MUL" | "DIV" | "MOD" | "PLUS" | "PLUS_SAT" | "MINUS"
//   | "MINUS_SAT" | "SHL" | r_angle "R_ANGLE_SHIFT" | "LE" | "GE"
//   | l_angle | r_angle | "NE" | "EQ" | "BIT_AND" | "BIT_XOR" | "BIT_OR"
//   | "PLUSPLUS" | "AND" | "OR"
// binaryExpression ::= expression binop expression
// binaryExpressionNonBrace ::= expressionNonBrace binop expression
// ternaryExpression ::= expression "QUESTION" expression "COLON" expression
// ternaryExpressionNonBrace ::= expressionNonBrace "QUESTION" expression
//   "COLON" expression
//
// - Cast expressions
// castExpression ::= "L_PAREN" typeRef "R_PAREN" expression
//
// - Data (aggregate) expressions
// dataExpression ::= "INVALID"
//   | "L_BRACE" sequenceOrRecordElementExpression trailingCommaOpt "R_BRACE"
//
// - Member and index access expressions
// errorAccessExpression ::= "ERROR" "DOT" member
// memberAccessExpression ::= memberAccessBase "DOT" member
// indexAccessExpression ::= expression "L_BRACKET" expression "R_BRACKET"
sliceop: Value = {
    // sliceop ::= "COLON"
    <l:@L> colon <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "':'",
        args: vec![],
        typ: "sliceop",
        span: context.location_span(l, r),
    }?) }),

    // sliceop ::= "PLUSCOLON"
    <l:@L> "PLUSCOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "'+:'",
        args: vec![],
        typ: "sliceop",
        span: context.location_span(l, r),
    }?) }),
};
// sliceAccessExpression ::= expression "L_BRACKET" expression sliceop expression "R_BRACKET"
// accessExpression ::= errorAccessExpression | memberAccessExpression
//   | indexAccessExpression | sliceAccessExpression
// memberAccessExpressionNonBrace ::= memberAccessBaseNonBrace "DOT" member
// indexAccessExpressionNonBrace ::= expressionNonBrace "L_BRACKET" expression "R_BRACKET"
// sliceAccessExpressionNonBrace ::= expressionNonBrace "L_BRACKET"
//   expression sliceop expression "R_BRACKET"
// accessExpressionNonBrace ::= errorAccessExpression
//   | memberAccessExpressionNonBrace | indexAccessExpressionNonBrace
//   | sliceAccessExpressionNonBrace
//
// - Call expressions
// callableTarget ::= expression
// constructorTarget ::= namedType
// callTarget ::= callableTarget | constructorTarget
// callExpression ::= callTarget "L_PAREN" argumentList "R_PAREN"
//   | callableTarget l_angle realTypeArgumentList r_angle
//     "L_PAREN" argumentList "R_PAREN"
// callableTargetNonBrace ::= expressionNonBrace
// callTargetNonBrace ::= callableTargetNonBrace | constructorTarget
// callExpressionNonBrace ::= callTargetNonBrace "L_PAREN" argumentList "R_PAREN"
//   | callableTargetNonBrace l_angle realTypeArgumentList r_angle
//     "L_PAREN" argumentList "R_PAREN"
//
// - Parenthesized expressions
// parenthesizedExpression ::= "L_PAREN" expression "R_PAREN"

// - LALRPOP precedence lowering

TernaryExpression: Value = {
    // TernaryExpression ::= ExpressionOr
    ExpressionOr,

    // TernaryExpression ::= ExpressionOr "QUESTION" expression colon expression
    <l:@L> <condition:ExpressionOr> "QUESTION" <yes:expression> colon <no:expression> <r:@R>
        =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "expression '?' expression ':' expression",
            args: vec![condition, yes, no],
            typ: "ternaryExpression",
            span: context.location_span(l, r),
        }?) }),
};

ExpressionOr: Value = {
    // ExpressionOr ::= ExpressionAnd
    ExpressionAnd,

    // ExpressionOr ::= ExpressionOr "OR" ExpressionAnd
    <l:@L> <lhs:ExpressionOr> <op_l:@L> "OR" <op_r:@R> <rhs:ExpressionAnd> <r:@R> =>? parse::action(|| { Ok({
        let span_op = context.location_span(op_l, op_r);
        let value_op = make::case! { arena: arena,
            shape: "'||'",
            args: vec![],
            typ: "binop",
            span: span_op,
        }?;
        let span_exp = context.location_span(l, r);
        make::case! { arena: arena,
            shape: "expression binop expression",
            args: vec![lhs, value_op, rhs],
            typ: "binaryExpression",
            span: span_exp,
        }?
    }) }),
};

ExpressionAnd: Value = {
    // ExpressionAnd ::= ExpressionEquality
    ExpressionEquality,

    // ExpressionAnd ::= ExpressionAnd "AND" ExpressionEquality
    <l:@L> <lhs:ExpressionAnd> <op_l:@L> "AND" <op_r:@R> <rhs:ExpressionEquality>
        <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'&&'",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),
};

ExpressionEquality: Value = {
    // ExpressionEquality ::= ExpressionComparison
    ExpressionComparison,

    // ExpressionEquality ::= ExpressionEquality "EQ" ExpressionComparison
    <l:@L> <lhs:ExpressionEquality> <op_l:@L> "EQ" <op_r:@R> <rhs:ExpressionComparison>
        <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'=='",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),

    // ExpressionEquality ::= ExpressionEquality "NE" ExpressionComparison
    <l:@L> <lhs:ExpressionEquality> <op_l:@L> "NE" <op_r:@R> <rhs:ExpressionComparison>
        <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'!='",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),
};

ExpressionComparison: Value = {
    <first:ExpressionAdditive> <parts:ExpressionPrecedencePart*> =>? parse::action(|| { Ok(binary::fold(arena, first, parts)?) }),
};

ExpressionPrecedencePart: BinaryExpressionPart = {
    <l:@L> "LE" <r:@R> <rhs:ExpressionAdditive> =>
        BinaryExpressionPart::new(BinaryOperator::LessEqual, context.location_span(l, r), rhs),
    <l:@L> "GE" <r:@R> <rhs:ExpressionAdditive> =>
        BinaryExpressionPart::new(BinaryOperator::GreaterEqual, context.location_span(l, r), rhs),
    <l:@L> "L_ANGLE" <r:@R> <rhs:ExpressionAdditive> =>
        BinaryExpressionPart::new(BinaryOperator::Less, context.location_span(l, r), rhs),
    <l:@L> r_angle <r:@R> <rhs:ExpressionAdditive> =>
        BinaryExpressionPart::new(BinaryOperator::Greater, context.location_span(l, r), rhs),
    <l:@L> "BIT_OR" <r:@R> <rhs:ExpressionAdditive> =>
        BinaryExpressionPart::new(BinaryOperator::BitOr, context.location_span(l, r), rhs),
    <l:@L> "BIT_XOR" <r:@R> <rhs:ExpressionAdditive> =>
        BinaryExpressionPart::new(BinaryOperator::BitXor, context.location_span(l, r), rhs),
    <l:@L> "BIT_AND" <r:@R> <rhs:ExpressionAdditive> =>
        BinaryExpressionPart::new(BinaryOperator::BitAnd, context.location_span(l, r), rhs),
    <l:@L> "SHL" <r:@R> <rhs:ExpressionAdditive> =>
        BinaryExpressionPart::new(BinaryOperator::ShiftLeft, context.location_span(l, r), rhs),
    <l:@L> r_angle "R_ANGLE_SHIFT" <r:@R> <rhs:ExpressionAdditive> =>
        BinaryExpressionPart::new(BinaryOperator::ShiftRight, context.location_span(l, r), rhs),
};

ExpressionAdditive: Value = {
    // ExpressionAdditive ::= ExpressionMultiplicative
    ExpressionMultiplicative,

    // ExpressionAdditive ::= ExpressionAdditive "PLUSPLUS" ExpressionMultiplicative
    <l:@L> <lhs:ExpressionAdditive> <op_l:@L> "PLUSPLUS" <op_r:@R>
        <rhs:ExpressionMultiplicative> <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'++'",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),

    // ExpressionAdditive ::= ExpressionAdditive "PLUS" ExpressionMultiplicative
    <l:@L> <lhs:ExpressionAdditive> <op_l:@L> "PLUS" <op_r:@R>
        <rhs:ExpressionMultiplicative> <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'+'",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),

    // ExpressionAdditive ::= ExpressionAdditive "PLUS_SAT" ExpressionMultiplicative
    <l:@L> <lhs:ExpressionAdditive> <op_l:@L> "PLUS_SAT" <op_r:@R>
        <rhs:ExpressionMultiplicative> <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'|+|'",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),

    // ExpressionAdditive ::= ExpressionAdditive "MINUS" ExpressionMultiplicative
    <l:@L> <lhs:ExpressionAdditive> <op_l:@L> "MINUS" <op_r:@R>
        <rhs:ExpressionMultiplicative> <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'-'",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),

    // ExpressionAdditive ::= ExpressionAdditive "MINUS_SAT" ExpressionMultiplicative
    <l:@L> <lhs:ExpressionAdditive> <op_l:@L> "MINUS_SAT" <op_r:@R>
        <rhs:ExpressionMultiplicative> <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'|-|'",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),
};

ExpressionMultiplicative: Value = {
    // ExpressionMultiplicative ::= ExpressionPrefix
    ExpressionPrefix,

    // ExpressionMultiplicative ::= ExpressionMultiplicative "MUL" ExpressionPrefix
    <l:@L> <lhs:ExpressionMultiplicative> <op_l:@L> "MUL" <op_r:@R> <rhs:ExpressionPrefix>
        <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'*'",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),

    // ExpressionMultiplicative ::= ExpressionMultiplicative "DIV" ExpressionPrefix
    <l:@L> <lhs:ExpressionMultiplicative> <op_l:@L> "DIV" <op_r:@R> <rhs:ExpressionPrefix>
        <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'/'",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),

    // ExpressionMultiplicative ::= ExpressionMultiplicative "MOD" ExpressionPrefix
    <l:@L> <lhs:ExpressionMultiplicative> <op_l:@L> "MOD" <op_r:@R> <rhs:ExpressionPrefix>
        <r:@R> =>? parse::action(|| { Ok({
            let span_op = context.location_span(op_l, op_r);
            let value_op = make::case! { arena: arena,
                shape: "'%'",
                args: vec![],
                typ: "binop",
                span: span_op,
            }?;
            let span_exp = context.location_span(l, r);
            make::case! { arena: arena,
                shape: "expression binop expression",
                args: vec![lhs, value_op, rhs],
                typ: "binaryExpression",
                span: span_exp,
            }?
        }) }),
};

ExpressionPrefix: Value = {
    // ExpressionPrefix ::= ExpressionPostfix
    ExpressionPostfix,

    // ExpressionPrefix ::= "NOT" ExpressionPrefix
    <l:@L> <op_l:@L> "NOT" <op_r:@R> <inner:ExpressionPrefix> <r:@R> =>? parse::action(|| { Ok({
        let span_op = context.location_span(op_l, op_r);
        let value_op = make::case! { arena: arena,
            shape: "'!'",
            args: vec![],
            typ: "unop",
            span: span_op,
        }?;
        let span_exp = context.location_span(l, r);
        make::case! { arena: arena,
            shape: "unop expression",
            args: vec![value_op, inner],
            typ: "unaryExpression",
            span: span_exp,
        }?
    }) }),

    // ExpressionPrefix ::= "COMPLEMENT" ExpressionPrefix
    <l:@L> <op_l:@L> "COMPLEMENT" <op_r:@R> <inner:ExpressionPrefix> <r:@R> =>? parse::action(|| { Ok({
        let span_op = context.location_span(op_l, op_r);
        let value_op = make::case! { arena: arena,
            shape: "'~'",
            args: vec![],
            typ: "unop",
            span: span_op,
        }?;
        let span_exp = context.location_span(l, r);
        make::case! { arena: arena,
            shape: "unop expression",
            args: vec![value_op, inner],
            typ: "unaryExpression",
            span: span_exp,
        }?
    }) }),

    // ExpressionPrefix ::= "MINUS" ExpressionPrefix
    <l:@L> <op_l:@L> "MINUS" <op_r:@R> <inner:ExpressionPrefix> <r:@R> =>? parse::action(|| { Ok({
        let span_op = context.location_span(op_l, op_r);
        let value_op = make::case! { arena: arena,
            shape: "'-'",
            args: vec![],
            typ: "unop",
            span: span_op,
        }?;
        let span_exp = context.location_span(l, r);
        make::case! { arena: arena,
            shape: "unop expression",
            args: vec![value_op, inner],
            typ: "unaryExpression",
            span: span_exp,
        }?
    }) }),

    // ExpressionPrefix ::= "PLUS" ExpressionPrefix
    <l:@L> <op_l:@L> "PLUS" <op_r:@R> <inner:ExpressionPrefix> <r:@R> =>? parse::action(|| { Ok({
        let span_op = context.location_span(op_l, op_r);
        let value_op = make::case! { arena: arena,
            shape: "'+'",
            args: vec![],
            typ: "unop",
            span: span_op,
        }?;
        let span_exp = context.location_span(l, r);
        make::case! { arena: arena,
            shape: "unop expression",
            args: vec![value_op, inner],
            typ: "unaryExpression",
            span: span_exp,
        }?
    }) }),

    // ExpressionPrefix ::= "L_PAREN" typeRef "R_PAREN" ExpressionPrefix
    <l:@L> "L_PAREN" <typ:typeRef> "R_PAREN" <inner:ExpressionPrefix> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "`( typeRef `) expression",
            args: vec![typ, inner],
            typ: "castExpression",
            span: context.location_span(l, r),
        }?) }),
};

ExpressionPostfix: Value = {
    // ExpressionPostfix ::= ExpressionPrimary
    ExpressionPrimary,

    // ExpressionPostfix ::= expressionPrefixedTypeName "DOT" set_parent_namespace member
    //     clear_parent_namespace
    <l:@L> <base:expressionPrefixedTypeName> "DOT" set_parent_namespace <member:member>
        clear_parent_namespace <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "memberAccessBase '.' member",
            args: vec![base, member],
            typ: "memberAccessExpression",
            span: context.location_span(l, r),
        }?) }),

    // ExpressionPostfix ::= expressionNamedType "L_PAREN" argumentList "R_PAREN"
    <l:@L> <target:expressionNamedType> "L_PAREN" <arguments:argumentList> "R_PAREN" <r:@R>
        =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "callTarget `( argumentList `)",
            args: vec![target, arguments],
            typ: "callExpression",
            span: context.location_span(l, r),
        }?) }),

    // ExpressionPostfix ::= ExpressionPostfix "DOT" set_parent_namespace member
    //     clear_parent_namespace
    <l:@L> <base:ExpressionPostfix> "DOT" set_parent_namespace <member:member>
        clear_parent_namespace <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "memberAccessBase '.' member",
            args: vec![base, member],
            typ: "memberAccessExpression",
            span: context.location_span(l, r),
        }?) }),

    // ExpressionPostfix ::= ExpressionPostfix "L_BRACKET" expression "R_BRACKET"
    <l:@L> <base:ExpressionPostfix> "L_BRACKET" <index:expression> "R_BRACKET" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "expression `[ expression `]",
            args: vec![base, index],
            typ: "indexAccessExpression",
            span: context.location_span(l, r),
        }?) }),

    // ExpressionPostfix ::= ExpressionPostfix "L_BRACKET" expression sliceop expression "R_BRACKET"
    <l:@L> <base:ExpressionPostfix> "L_BRACKET" <slice_l:expression> <operator:sliceop>
        <slice_r:expression> "R_BRACKET" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "expression `[ expression sliceop expression `]",
            args: vec![base, slice_l, operator, slice_r],
            typ: "sliceAccessExpression",
            span: context.location_span(l, r),
        }?) }),

    // ExpressionPostfix ::= ExpressionPostfix "L_PAREN" argumentList "R_PAREN"
    <l:@L> <target:ExpressionPostfix> "L_PAREN" <arguments:argumentList> "R_PAREN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "callTarget `( argumentList `)",
            args: vec![target, arguments],
            typ: "callExpression",
            span: context.location_span(l, r),
        }?) }),

    // ExpressionPostfix ::= ExpressionPostfix "L_ANGLE_ARGS" realTypeArgumentList r_angle "L_PAREN"
    //     argumentList "R_PAREN"
    <l:@L> <target:ExpressionPostfix> "L_ANGLE_ARGS" <types:realTypeArgumentList> r_angle
        "L_PAREN" <arguments:argumentList> "R_PAREN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "callTarget `< realTypeArgumentList `> `( argumentList `)",
            args: vec![target, types, arguments],
            typ: "callExpression",
            span: context.location_span(l, r),
        }?) }),
};

