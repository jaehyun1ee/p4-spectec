    <l:@L> "MINUS" <r:@R> => value::case_value(context, "'-'", vec![], "annotationToken", l, r),

    // annotationToken ::= "MINUS_SAT"
    <l:@L> "MINUS_SAT" <r:@R> => value::case_value(context, "'|-|'", vec![], "annotationToken", l, r),

    // annotationToken ::= "MUL"
    <l:@L> "MUL" <r:@R> => value::case_value(context, "'*'", vec![], "annotationToken", l, r),

    // annotationToken ::= "DIV"
    <l:@L> "DIV" <r:@R> => value::case_value(context, "'/'", vec![], "annotationToken", l, r),

    // annotationToken ::= "MOD"
    <l:@L> "MOD" <r:@R> => value::case_value(context, "'%'", vec![], "annotationToken", l, r),

    // annotationToken ::= "BIT_OR"
    <l:@L> "BIT_OR" <r:@R> => value::case_value(context, "'|'", vec![], "annotationToken", l, r),

    // annotationToken ::= "BIT_AND"
    <l:@L> "BIT_AND" <r:@R> => value::case_value(context, "'&'", vec![], "annotationToken", l, r),

    // annotationToken ::= "BIT_XOR"
    <l:@L> "BIT_XOR" <r:@R> => value::case_value(context, "'^'", vec![], "annotationToken", l, r),

    // annotationToken ::= "COMPLEMENT"
    <l:@L> "COMPLEMENT" <r:@R> => value::case_value(context, "'~'", vec![], "annotationToken", l, r),

    // annotationToken ::= "L_BRACKET"
    <l:@L> "L_BRACKET" <r:@R> => value::case_value(context, "'['", vec![], "annotationToken", l, r),

    // annotationToken ::= "R_BRACKET"
    <l:@L> "R_BRACKET" <r:@R> => value::case_value(context, "']'", vec![], "annotationToken", l, r),

    // annotationToken ::= "L_BRACE"
    <l:@L> "L_BRACE" <r:@R> => value::case_value(context, "'{'", vec![], "annotationToken", l, r),

    // annotationToken ::= "R_BRACE"
    <l:@L> "R_BRACE" <r:@R> => value::case_value(context, "'}'", vec![], "annotationToken", l, r),

    // annotationToken ::= "L_ANGLE"
    <l:@L> "L_ANGLE" <r:@R> => value::case_value(context, "'<'", vec![], "annotationToken", l, r),

    // Rust lexer adapter for annotationToken ::= "L_ANGLE"
    <l:@L> "L_ANGLE_ARGS" <r:@R> => value::case_value(context, "'<'", vec![], "annotationToken", l, r),

    // annotationToken ::= "R_ANGLE"
    <l:@L> "R_ANGLE" <r:@R> => value::case_value(context, "'>'", vec![], "annotationToken", l, r),

    // annotationToken ::= "NOT"
    <l:@L> "NOT" <r:@R> => value::case_value(context, "'!'", vec![], "annotationToken", l, r),

    // annotationToken ::= "COLON"
    <l:@L> colon <r:@R> => value::case_value(context, "':'", vec![], "annotationToken", l, r),

    // annotationToken ::= "COMMA"
    <l:@L> "COMMA" <r:@R> => value::case_value(context, "','", vec![], "annotationToken", l, r),

    // Rust lexer adapter for annotationToken ::= "COMMA"
    <l:@L> "TRAILING_COMMA" <r:@R> => value::case_value(context, "','", vec![], "annotationToken", l, r),

    // annotationToken ::= "QUESTION"
    <l:@L> "QUESTION" <r:@R> => value::case_value(context, "'?'", vec![], "annotationToken", l, r),

    // annotationToken ::= "DOT"
    <l:@L> "DOT" <r:@R> => value::case_value(context, "'.'", vec![], "annotationToken", l, r),

    // annotationToken ::= "ASSIGN"
    <l:@L> "ASSIGN" <r:@R> => value::case_value(context, "'='", vec![], "annotationToken", l, r),

    // annotationToken ::= "SEMICOLON"
    <l:@L> "SEMICOLON" <r:@R> => value::case_value(context, "';'", vec![], "annotationToken", l, r),

    // annotationToken ::= "AT"
    <l:@L> "AT" <r:@R> => value::case_value(context, "'@'", vec![], "annotationToken", l, r),
};

annotationBody: ValueRef = {
    // annotationBody ::= epsilon
    <l:@L>  <r:@R> => value::case_value(context, "_EMPTY", vec![], "annotationBody", l, r),

    // annotationBody ::= annotationBody "L_PAREN" annotationBody "R_PAREN"
    <l:@L> <ab:annotationBody> "L_PAREN" <ab_in:annotationBody> "R_PAREN" <r:@R> =>
        value::case_value(
            context,
            "annotationBody `( annotationBody `)",
            vec![ab, ab_in],
            "annotationBody",
            l,
            r,
        ),

    // annotationBody ::= annotationBody annotationToken
    <l:@L> <ab:annotationBody> <atoken:annotationToken> <r:@R> =>
        value::case_value(context, "annotationBody annotationToken", vec![ab, atoken], "annotationBody", l, r),
};

structuredAnnotationBody: ValueRef = {
    // structuredAnnotationBody ::= sequenceOrRecordElementExpression trailingCommaOpt
    <l:@L> <e:sequenceOrRecordElementExpression> <c:trailingCommaOpt> <r:@R> =>
        value::case_value(
            context,
            "sequenceOrRecordElementExpression trailingCommaOpt",
            vec![e, c],
            "structuredAnnotationBody",
            l,
            r,
        ),
};

annotation: ValueRef = {
    // annotation ::= "AT" name
    <l:@L> "AT" <name:name> <r:@R> =>
        value::case_value(context, "'@' name", vec![name], "annotation", l, r),

    // annotation ::= "AT" name "L_PAREN" annotationBody "R_PAREN"
    <l:@L> "AT" <name:name> "L_PAREN" <body:annotationBody> "R_PAREN" <r:@R> =>
        value::case_value(context, "'@' name `( annotationBody `)", vec![name, body], "annotation", l, r),

    // annotation ::= "AT" name "L_BRACKET" structuredAnnotationBody "R_BRACKET"
    <l:@L> "AT" <name:name> "L_BRACKET" <body:structuredAnnotationBody> "R_BRACKET" <r:@R> =>
        value::case_value(
            context,
            "'@' name `[ structuredAnnotationBody `]",
            vec![name, body],
            "annotation",
            l,
            r,
        ),

    // annotation ::= "PRAGMA" name annotationBody "PRAGMA_END"
    <l:@L> "PRAGMA" <name:name> <body:annotationBody> "PRAGMA_END" <r:@R> =>
        value::case_value(context, "'@' PRAGMA name annotationBody", vec![name, body], "annotation", l, r),
};

annotationListNonEmpty: ValueRef = {
    // annotationListNonEmpty ::= annotation
    <a:annotation> => a,

    // annotationListNonEmpty ::= annotationListNonEmpty annotation
    <l:@L> <al:annotationListNonEmpty> <a:annotation> <r:@R> =>
        value::case_value(
            context,
            "annotationListNonEmpty annotation",
            vec![al, a],
            "annotationListNonEmpty",
            l,
            r,
        ),
};

#[inline]
annotationList: ValueRef = {
    // annotationList ::= epsilon
    <l:@L>  <r:@R> => value::case_value(context, "_EMPTY", vec![], "annotationList", l, r),

    // annotationList ::= annotationListNonEmpty
    <al:annotationListNonEmpty> => al,
};

// - P4 program

declarationList: ValueRef = {
    // declarationList ::= epsilon
    <l:@L>  <r:@R> => value::case_value(context, "_EMPTY", vec![], "declarationList", l, r),

    // declarationList ::= declarationList declaration
    <l:@L> <ds:declarationList> <d:declaration> <r:@R> =>
        value::case_value(context, "declarationList declaration", vec![ds, d], "declarationList", l, r),

    // declarationList ::= declarationList "SEMICOLON"
    <l:@L> <ds:declarationList> "SEMICOLON" <r:@R> =>
        value::case_value(context, "declarationList ';'", vec![ds], "declarationList", l, r),
};

pub p4program: ValueRef = {
    // p4program ::= declarationList "END"
    <dl:declarationList> "END" => value::retag(dl, "p4program"),
};
