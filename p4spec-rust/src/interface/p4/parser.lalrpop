    <l:@L> <al:annotationList> "STRUCT" <n:name> <tpl:typeParameterListOpt> "L_BRACE"
        <fl:typeFieldList> "R_BRACE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList STRUCT name typeParameterListOpt `{ typeFieldList `}",
