    }?) }),

    // assignop ::= "MOD_ASSIGN"
    <l:@L> "MOD_ASSIGN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "'%='",
        args: vec![],
        typ: "assignop",
        span: context.location_span(l, r),
    }?) }),

    // assignop ::= "SHL_ASSIGN"
    <l:@L> "SHL_ASSIGN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "'<<='",
        args: vec![],
        typ: "assignop",
        span: context.location_span(l, r),
    }?) }),

    // assignop ::= "SHR_ASSIGN"
    <l:@L> "SHR_ASSIGN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "'>>='",
        args: vec![],
        typ: "assignop",
        span: context.location_span(l, r),
    }?) }),

    // assignop ::= "BIT_AND_ASSIGN"
    <l:@L> "BIT_AND_ASSIGN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "'&='",
        args: vec![],
        typ: "assignop",
        span: context.location_span(l, r),
    }?) }),

    // assignop ::= "BIT_XOR_ASSIGN"
    <l:@L> "BIT_XOR_ASSIGN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "'^='",
        args: vec![],
        typ: "assignop",
        span: context.location_span(l, r),
    }?) }),

    // assignop ::= "BIT_OR_ASSIGN"
    <l:@L> "BIT_OR_ASSIGN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "'|='",
        args: vec![],
        typ: "assignop",
        span: context.location_span(l, r),
    }?) }),
};

assignmentStatement: Value = {
    // assignmentStatement ::= lvalue assignop expression "SEMICOLON"
    <l:@L> <lv:lvalue> <o:assignop> <e:expression> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "lvalue assignop expression ';'",
            args: vec![lv, o, e],
            typ: "assignmentStatement",
            span: context.location_span(l, r),
        }?) }),
};

// - Call statements

callStatement: Value = {
    // callStatement ::= lvalue "L_PAREN" argumentList "R_PAREN" "SEMICOLON"
    <l:@L> <lv:lvalue> "L_PAREN" <args:argumentList> "R_PAREN" "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "lvalue `( argumentList `) ';'",
            args: vec![lv, args],
            typ: "callStatement",
            span: context.location_span(l, r),
        }?) }),

    // callStatement ::= lvalue l_angle typeArgumentList r_angle "L_PAREN" argumentList "R_PAREN"
    //     "SEMICOLON"
    <l:@L> <lv:lvalue> "L_ANGLE_ARGS" <targs:typeArgumentList> r_angle "L_PAREN"
        <args:argumentList> "R_PAREN" "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "lvalue `< typeArgumentList `> `( argumentList `) ';'",
            args: vec![lv, targs, args],
            typ: "callStatement",
            span: context.location_span(l, r),
        }?) }),
};

// - Direct application statements

// The lexer marks a bare canonical `namedType` as expression-context before
// `.`, but a specialized type retains its declaration-context marker.
directApplicationType: Value = {
    namedType,
    expressionNamedType,
};

directApplicationStatement: Value = {
    // directApplicationStatement ::= namedType "DOT" "APPLY" "L_PAREN"
    //   argumentList "R_PAREN" "SEMICOLON"
    <l:@L> <t:directApplicationType> "DOT" "APPLY" "L_PAREN" <args:argumentList> "R_PAREN"
        "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "namedType '.' APPLY `( argumentList `) ';'",
            args: vec![t, args],
            typ: "directApplicationStatement",
            span: context.location_span(l, r),
        }?) }),
};

// - Return statements

returnStatement: Value = {
    // returnStatement ::= "RETURN" "SEMICOLON"
    <l:@L> "RETURN" "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "RETURN ';'",
            args: vec![],
            typ: "returnStatement",
            span: context.location_span(l, r),
        }?) }),

    // returnStatement ::= "RETURN" expression "SEMICOLON"
    <l:@L> "RETURN" <e:expression> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "RETURN expression ';'",
            args: vec![e],
            typ: "returnStatement",
            span: context.location_span(l, r),
        }?) }),
};

// - Exit statements

exitStatement: Value = {
    // exitStatement ::= "EXIT" "SEMICOLON"
    <l:@L> "EXIT" "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "EXIT ';'",
            args: vec![],
            typ: "exitStatement",
            span: context.location_span(l, r),
        }?) }),
};

// - Block statements

blockStatement: Value = {
    // blockStatement ::= annotationList "L_BRACE" push_scope
    //   blockElementStatementList "R_BRACE" pop_scope
    <l:@L> <al:annotationList> "L_BRACE" push_scope <sl:blockElementStatementList> "R_BRACE"
        pop_scope <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList `{ blockElementStatementList `}",
            args: vec![al, sl],
            typ: "blockStatement",
            span: context.location_span(l, r),
        }?) }),
};

// - Conditional statements

// conditionalStatement ::= "IF" "L_PAREN" expression "R_PAREN" statement
//   | "IF" "L_PAREN" expression "R_PAREN" statement "ELSE" statement

// - For statements

forInitStatement: Value = {
    // forInitStatement ::= annotationList typeRef name initializerOpt
    <l:@L> <al:annotationList> <t:typeRef> <n:name> <i:initializerOpt> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList type name initializerOpt",
            args: vec![al, t, n, i],
            typ: "forInitStatement",
            span: context.location_span(l, r),
        }?) }),

    // forInitStatement ::= lvalue "L_PAREN" argumentList "R_PAREN"
    <l:@L> <lv:lvalue> "L_PAREN" <args:argumentList> "R_PAREN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "lvalue `( argumentList `)",
            args: vec![lv, args],
            typ: "forInitStatement",
            span: context.location_span(l, r),
        }?) }),

    // forInitStatement ::= lvalue l_angle typeArgumentList r_angle "L_PAREN" argumentList "R_PAREN"
    <l:@L> <lv:lvalue> "L_ANGLE_ARGS" <targs:typeArgumentList> r_angle "L_PAREN"
        <args:argumentList> "R_PAREN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "lvalue `< typeArgumentList `> `( argumentList `)",
            args: vec![lv, targs, args],
            typ: "forInitStatement",
            span: context.location_span(l, r),
        }?) }),

    // forInitStatement ::= lvalue assignop expression
    <l:@L> <lv:lvalue> <o:assignop> <e:expression> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "lvalue assignop expression",
            args: vec![lv, o, e],
            typ: "forInitStatement",
            span: context.location_span(l, r),
        }?) }),
};

forInitStatementListNonEmpty: Value = {
    // forInitStatementListNonEmpty ::= forInitStatement
    <s:forInitStatement> => s,

    // forInitStatementListNonEmpty ::= forInitStatementListNonEmpty "COMMA" forInitStatement
    <l:@L> <sl:forInitStatementListNonEmpty> "COMMA" <s:forInitStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "forInitStatementListNonEmpty ',' forInitStatement",
            args: vec![sl, s],
            typ: "forInitStatementListNonEmpty",
            span: context.location_span(l, r),
        }?) }),
};

#[inline]
forInitStatementList: Value = {
    // forInitStatementList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "forInitStatementList",
        span: context.location_span(l, r),
    }?) }),

    // forInitStatementList ::= forInitStatementListNonEmpty
    <sl:forInitStatementListNonEmpty> => sl,
};

forUpdateStatement: Value = {
    // forUpdateStatement ::= forInitStatement
    <s:forInitStatement> => s,
};

forUpdateStatementListNonEmpty: Value = {
    // forUpdateStatementListNonEmpty ::= forUpdateStatement
    <s:forUpdateStatement> => s,

    // forUpdateStatementListNonEmpty ::= forUpdateStatementListNonEmpty "COMMA" forUpdateStatement
    <l:@L> <sl:forUpdateStatementListNonEmpty> "COMMA" <s:forUpdateStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "forUpdateStatementListNonEmpty ',' forUpdateStatement",
            args: vec![sl, s],
            typ: "forUpdateStatementListNonEmpty",
            span: context.location_span(l, r),
        }?) }),
};

#[inline]
forUpdateStatementList: Value = {
    // forUpdateStatementList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "forUpdateStatementList",
        span: context.location_span(l, r),
    }?) }),

    // forUpdateStatementList ::= forUpdateStatementListNonEmpty
    <sl:forUpdateStatementListNonEmpty> => sl,
};

forCollectionExpression: Value = {
    // forCollectionExpression ::= expression
    <e:expression> => e,

    // forCollectionExpression ::= expression "RANGE" expression
    <l:@L> <lo:expression> "RANGE" <hi:expression> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "expression '..' expression",
            args: vec![lo, hi],
            typ: "forCollectionExpression",
            span: context.location_span(l, r),
        }?) }),
};

// forStatement ::= annotationList "FOR" "L_PAREN" forInitStatementList
//     "SEMICOLON" expression "SEMICOLON" forUpdateStatementList "R_PAREN" statement
//   | annotationList "FOR" "L_PAREN" typeRef name "IN"
//     forCollectionExpression "R_PAREN" statement
//   | annotationList "FOR" "L_PAREN" annotationListNonEmpty typeRef name
//     "IN" forCollectionExpression "R_PAREN" statement

// - Switch statements

switchLabel: Value = {
    // switchLabel ::= "DEFAULT"
    <l:@L> "DEFAULT" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "DEFAULT",
        args: vec![],
        typ: "switchLabel",
        span: context.location_span(l, r),
    }?) }),

    // switchLabel ::= expressionNonBrace
    <e:expressionNonBrace> => e,
};

#[inline]
switchCase: Value = {
    // switchCase ::= switchLabel "COLON" blockStatement
    <l:@L> <label:switchLabel> "BLOCK_COLON" <body:blockStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "switchLabel ':' blockStatement",
            args: vec![label, body],
            typ: "switchCase",
            span: context.location_span(l, r),
        }?) }),

    // switchCase ::= switchLabel "COLON"
    <l:@L> <label:switchLabel> plain_colon <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "switchLabel ':'",
            args: vec![label],
            typ: "switchCase",
            span: context.location_span(l, r),
        }?) }),
};

switchCaseList: Value = {
    // switchCaseList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "switchCaseList",
        span: context.location_span(l, r),
    }?) }),

    // switchCaseList ::= switchCaseList switchCase
    <l:@L> <cs:switchCaseList> <c:switchCase> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "switchCaseList switchCase",
            args: vec![cs, c],
            typ: "switchCaseList",
            span: context.location_span(l, r),
        }?) }),
};

switchStatement: Value = {
    // switchStatement ::= "SWITCH" "L_PAREN" expression "R_PAREN" "L_BRACE" switchCaseList "R_BRACE"
    <l:@L> "SWITCH" "L_PAREN" <e:expression> "R_PAREN" "L_BRACE" <cs:switchCaseList> "R_BRACE"
        <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "SWITCH `( expression `) `{ switchCaseList `}",
            args: vec![e, cs],
            typ: "switchStatement",
            span: context.location_span(l, r),
        }?) }),
};

// - Break and continue statements

breakStatement: Value = {
    // breakStatement ::= "BREAK" "SEMICOLON"
    <l:@L> "BREAK" "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "BREAK ';'",
            args: vec![],
            typ: "breakStatement",
            span: context.location_span(l, r),
        }?) }),
};

continueStatement: Value = {
    // continueStatement ::= "CONTINUE" "SEMICOLON"
    <l:@L> "CONTINUE" "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "CONTINUE ';'",
            args: vec![],
            typ: "continueStatement",
            span: context.location_span(l, r),
        }?) }),
};

// - Statements

// The matched forms below implement the canonical statement alternatives
statement: Value = {
    // statement ::= MatchedStatement
    MatchedStatement,

    // statement ::= UnmatchedStatement
    UnmatchedStatement,
};

// - LALRPOP dangling-else lowering
//
// Matched and unmatched forms attach each `ELSE` to the nearest open `IF`
// without moving the canonical statement productions from this section.

MatchedStatement: Value = {
    // MatchedStatement ::= emptyStatement
    emptyStatement,

    // MatchedStatement ::= assignmentStatement
    assignmentStatement,

    // MatchedStatement ::= callStatement
    callStatement,

    // MatchedStatement ::= directApplicationStatement
    directApplicationStatement,

    // MatchedStatement ::= returnStatement
    returnStatement,

    // MatchedStatement ::= exitStatement
    exitStatement,

    // MatchedStatement ::= blockStatement
    blockStatement,

    // MatchedStatement ::= MatchedForStatement
    MatchedForStatement,

    // MatchedStatement ::= breakStatement
    breakStatement,

    // MatchedStatement ::= continueStatement
    continueStatement,

    // MatchedStatement ::= switchStatement
    switchStatement,

    // MatchedStatement ::= "IF" "L_PAREN" expression "R_PAREN" MatchedStatement "ELSE"
    //     MatchedStatement
    <l:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:MatchedStatement> "ELSE"
        <no:MatchedStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "IF `( expression `) statement ELSE statement",
            args: vec![condition, yes, no],
            typ: "conditionalStatement",
            span: context.location_span(l, r),
        }?) }),
};

UnmatchedStatement: Value = {
    // UnmatchedStatement ::= UnmatchedForStatement
    UnmatchedForStatement,

    // UnmatchedStatement ::= "IF" "L_PAREN" expression "R_PAREN" statement
    <l:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:statement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "IF `( expression `) statement",
            args: vec![condition, yes],
            typ: "conditionalStatement",
            span: context.location_span(l, r),
        }?) }),

    // UnmatchedStatement ::= "IF" "L_PAREN" expression "R_PAREN" MatchedStatement "ELSE"
    //     UnmatchedStatement
    <l:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:MatchedStatement> "ELSE"
        <no:UnmatchedStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "IF `( expression `) statement ELSE statement",
            args: vec![condition, yes, no],
            typ: "conditionalStatement",
            span: context.location_span(l, r),
        }?) }),
};

MatchedForStatement: Value = {
    // MatchedForStatement ::= annotationList "FOR" "L_PAREN" forInitStatementList "SEMICOLON"
    //     expression "SEMICOLON" forUpdateStatementList "R_PAREN" MatchedStatement
    <l:@L> <annotations:annotationList> "FOR" "L_PAREN" <init:forInitStatementList> "SEMICOLON"
        <condition:expression> "SEMICOLON" <update:forUpdateStatementList> "R_PAREN"
        <body:MatchedStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList FOR `( forInitStatementList ';' expression ';' forUpdateStatementList `) statement",
            args: vec![annotations, init, condition, update, body],
            typ: "forStatement",
            span: context.location_span(l, r),
        }?) }),

    // MatchedForStatement ::= annotationList "FOR" "L_PAREN" typeRef name "IN"
    //     forCollectionExpression "R_PAREN" MatchedStatement
    <l:@L> <annotations:annotationList> "FOR" "L_PAREN" <typ:typeRef> <name:name> "IN"
        <collection:forCollectionExpression> "R_PAREN" <body:MatchedStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList FOR `( typeRef name IN forCollectionExpression `) statement",
            args: vec![annotations, typ, name, collection, body],
            typ: "forStatement",
            span: context.location_span(l, r),
        }?) }),

    // MatchedForStatement ::= annotationList "FOR" "L_PAREN" annotationListNonEmpty typeRef name
    //     "IN" forCollectionExpression "R_PAREN" MatchedStatement
    <l:@L> <annotations:annotationList> "FOR" "L_PAREN"
        <inner_annotations:annotationListNonEmpty> <typ:typeRef> <name:name> "IN"
        <collection:forCollectionExpression> "R_PAREN" <body:MatchedStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList FOR `( annotationList typeRef name IN forCollectionExpression `) statement",
            args: vec![
                annotations,
                inner_annotations,
                typ,
                name,
                collection,
                body,
            ],
            typ: "forStatement",
            span: context.location_span(l, r),
        }?) }),
};

UnmatchedForStatement: Value = {
    // UnmatchedForStatement ::= annotationList "FOR" "L_PAREN" forInitStatementList "SEMICOLON"
    //     expression "SEMICOLON" forUpdateStatementList "R_PAREN" UnmatchedStatement
    <l:@L> <annotations:annotationList> "FOR" "L_PAREN" <init:forInitStatementList> "SEMICOLON"
        <condition:expression> "SEMICOLON" <update:forUpdateStatementList> "R_PAREN"
        <body:UnmatchedStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList FOR `( forInitStatementList ';' expression ';' forUpdateStatementList `) statement",
            args: vec![annotations, init, condition, update, body],
            typ: "forStatement",
            span: context.location_span(l, r),
        }?) }),

    // UnmatchedForStatement ::= annotationList "FOR" "L_PAREN" typeRef name "IN"
    //     forCollectionExpression "R_PAREN" UnmatchedStatement
    <l:@L> <annotations:annotationList> "FOR" "L_PAREN" <typ:typeRef> <name:name> "IN"
        <collection:forCollectionExpression> "R_PAREN" <body:UnmatchedStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList FOR `( typeRef name IN forCollectionExpression `) statement",
            args: vec![annotations, typ, name, collection, body],
            typ: "forStatement",
            span: context.location_span(l, r),
        }?) }),

    // UnmatchedForStatement ::= annotationList "FOR" "L_PAREN" annotationListNonEmpty typeRef name
    //     "IN" forCollectionExpression "R_PAREN" UnmatchedStatement
    <l:@L> <annotations:annotationList> "FOR" "L_PAREN"
        <inner_annotations:annotationListNonEmpty> <typ:typeRef> <name:name> "IN"
        <collection:forCollectionExpression> "R_PAREN" <body:UnmatchedStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList FOR `( annotationList typeRef name IN forCollectionExpression `) statement",
            args: vec![
                annotations,
                inner_annotations,
                typ,
                name,
                collection,
                body,
            ],
            typ: "forStatement",
            span: context.location_span(l, r),
        }?) }),
};

// - Declarations

// - Constant and variable declarations
initialValue: Value = {
    // initialValue ::= "ASSIGN" expression
    <l:@L> "ASSIGN" <e:expression> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "'=' expression",
            args: vec![e],
            typ: "initializer",
            span: context.location_span(l, r),
        }?) }),
};

constantDeclaration: Value = {
    // constantDeclaration ::= annotationList "CONST" typeRef name initialValue "SEMICOLON"
    <l:@L> <al:annotationList> "CONST" <t:typeRef> <n:name> <i:initialValue> "SEMICOLON"
        <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList CONST typeRef name initializer ';'",
            args: vec![al, t, n, i],
            typ: "constantDeclaration",
            span: context.location_span(l, r),
        }?) }),
};

#[inline]
initializerOpt: Value = {
    // initializerOpt ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "initializerOpt",
        span: context.location_span(l, r),
    }?) }),

    // initializerOpt ::= initialValue
    <i:initialValue> => i,
};

variableDeclaration: Value = {
    // variableDeclaration ::= annotationList typeRef name initializerOpt "SEMICOLON"
    <l:@L> <al:annotationList> <t:typeRef> <n:name> <i:initializerOpt> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok({
        declare::var(arena, context, &n, false, Some(&t));
        make::case! { arena: arena,
            shape: "annotationList typeRef name initializerOpt ';'",
            args: vec![al, t, n, i],
            typ: "variableDeclaration",
            span: context.location_span(l, r),
        }?
    }) }),
};

blockElementStatement: Value = {
    // blockElementStatement ::= constantDeclaration
    <d:constantDeclaration> => d,

    // blockElementStatement ::= variableDeclaration
    <d:variableDeclaration> => d,

    // blockElementStatement ::= statement
    <d:statement> => d,
};

blockElementStatementList: Value = {
    // blockElementStatementList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "blockElementStatementList",
        span: context.location_span(l, r),
    }?) }),

    // blockElementStatementList ::= blockElementStatementList blockElementStatement
    <l:@L> <sl:blockElementStatementList> <s:blockElementStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "blockElementStatementList blockElementStatement",
            args: vec![sl, s],
            typ: "blockElementStatementList",
            span: context.location_span(l, r),
        }?) }),
};

// - Function declarations
functionPrototype: Value = {
    // functionPrototype ::= typeOrVoid name push_scope typeParameterListOpt "L_PAREN" parameterList
    //     "R_PAREN"
    <l:@L> <t:typeOrVoid> <n:declarationName> push_scope <tpl:typeParameterListOpt> "L_PAREN"
        <pl:parameterList> "R_PAREN" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "typeOrVoid name typeParameterListOpt `( parameterList `)",
            args: vec![t, n, tpl, pl],
            typ: "functionPrototype",
            span: context.location_span(l, r),
        }?) }),
};

functionDeclaration: Value = {
    // functionDeclaration ::= annotationList functionPrototype blockStatement pop_scope
    <l:@L> <al:annotationList> <p:functionPrototype> <b:blockStatement> pop_scope <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList functionPrototype blockStatement",
            args: vec![al, p, b],
            typ: "functionDeclaration",
            span: context.location_span(l, r),
        }?) }),
};

// - Action declarations
actionDeclaration: Value = {
    // actionDeclaration ::= annotationList "ACTION" name "L_PAREN" parameterList "R_PAREN"
    //     blockStatement
    <l:@L> <al:annotationList> "ACTION" <n:name> "L_PAREN" <pl:parameterList> "R_PAREN"
        <s:blockStatement> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList ACTION name `( parameterList `) blockStatement",
            args: vec![al, n, pl, s],
            typ: "actionDeclaration",
            span: context.location_span(l, r),
        }?) }),
};

// - Instantiations
objectInitializer: Value = {
    // objectInitializer ::= "ASSIGN" "L_BRACE" objectDeclarationList "R_BRACE"
    <l:@L> "ASSIGN" "L_BRACE" <ds:objectDeclarationList> "R_BRACE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "'=' `{ objectDeclarationList `}",
            args: vec![ds],
            typ: "objectInitializer",
            span: context.location_span(l, r),
        }?) }),
};

// A type name may already carry expression-leading classification when this
// production reduces, so both alternatives denote the same type reference.
instantiationTypeRef: Value = {
    // instantiationTypeRef ::= typeRef
    typeRef,

    // instantiationTypeRef ::= expressionNamedType
    expressionNamedType,
};

instantiation: Value = {
    // instantiation ::= annotationList instantiationTypeRef "L_PAREN" argumentList "R_PAREN" name
    //     "SEMICOLON"
    <l:@L> <al:annotationList> <t:instantiationTypeRef> "L_PAREN" <args:argumentList> "R_PAREN"
        <n:name> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList typeRef `( argumentList `) name ';'",
            args: vec![al, t, args, n],
            typ: "instantiation",
            span: context.location_span(l, r),
        }?) }),

    // instantiation ::= annotationList instantiationTypeRef "L_PAREN" argumentList "R_PAREN" name
    //     objectInitializer "SEMICOLON"
    <l:@L> <al:annotationList> <t:instantiationTypeRef> "L_PAREN" <args:argumentList> "R_PAREN"
        <n:name> <i:objectInitializer> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList typeRef `( argumentList `) name objectInitializer ';'",
            args: vec![al, t, args, n, i],
            typ: "instantiation",
            span: context.location_span(l, r),
        }?) }),
};

objectDeclaration: Value = {
    // objectDeclaration ::= functionDeclaration
    <d:functionDeclaration> => d,

    // objectDeclaration ::= instantiation
    <d:instantiation> => d,
};

objectDeclarationList: Value = {
    // objectDeclarationList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "objectDeclarationList",
        span: context.location_span(l, r),
    }?) }),

    // objectDeclarationList ::= objectDeclarationList objectDeclaration
    <l:@L> <ds:objectDeclarationList> <d:objectDeclaration> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "objectDeclarationList objectDeclaration",
            args: vec![ds, d],
            typ: "objectDeclarationList",
            span: context.location_span(l, r),
        }?) }),
};

// - Error declarations
errorDeclaration: Value = {
    // errorDeclaration ::= "ERROR" "L_BRACE" nameList "R_BRACE"
    <l:@L> "ERROR" "L_BRACE" <nl:nameList> "R_BRACE" <r:@R> =>? parse::action(|| { Ok({
        declare::vars(arena, context, &nl);
        make::case! { arena: arena,
            shape: "ERROR `{ nameList `}",
            args: vec![nl],
            typ: "errorDeclaration",
            span: context.location_span(l, r),
        }?
    }) }),
};

// - Match kind declarations
matchKindDeclaration: Value = {
    // matchKindDeclaration ::= "MATCH_KIND" "L_BRACE" nameList trailingCommaOpt "R_BRACE"
    <l:@L> "MATCH_KIND" "L_BRACE" <nl:nameList> <c:trailingCommaOpt> "R_BRACE" <r:@R> =>? parse::action(|| { Ok({
        declare::vars(arena, context, &nl);
        make::case! { arena: arena,
            shape: "MATCH_KIND `{ nameList trailingCommaOpt `}",
            args: vec![nl, c],
            typ: "matchKindDeclaration",
            span: context.location_span(l, r),
        }?
    }) }),
};

// - Derived type declarations

// - Enum declarations

enumTypeDeclaration: Value = {
    // enumTypeDeclaration ::= annotationList "ENUM" name "L_BRACE" nameList trailingCommaOpt "R_BRACE"
    <l:@L> <al:annotationList> "ENUM" <n:name> "L_BRACE" <nl:nameList> <c:trailingCommaOpt>
        "R_BRACE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList ENUM name `{ nameList trailingCommaOpt `}",
            args: vec![al, n, nl, c],
            typ: "enumTypeDeclaration",
            span: context.location_span(l, r),
        }?) }),

    // enumTypeDeclaration ::= annotationList "ENUM" typeRef name "L_BRACE" namedExpressionList
    //     trailingCommaOpt "R_BRACE"
    <l:@L> <al:annotationList> "ENUM" <t:typeRef> <n:name> "L_BRACE" <el:namedExpressionList>
        <c:trailingCommaOpt> "R_BRACE" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList ENUM typeRef name `{ namedExpressionList trailingCommaOpt `}",
            args: vec![al, t, n, el, c],
            typ: "enumTypeDeclaration",
            span: context.location_span(l, r),
        }?) }),
};

// - Struct, header, and union declarations

typeField: Value = {
    // typeField ::= annotationList typeRef name "SEMICOLON"
    <l:@L> <al:annotationList> <t:typeRef> <n:name> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList typeRef name ';'",
            args: vec![al, t, n],
            typ: "typeField",
            span: context.location_span(l, r),
        }?) }),
};

typeFieldList: Value = {
    // typeFieldList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "typeFieldList",
        span: context.location_span(l, r),
    }?) }),

    // typeFieldList ::= typeFieldList typeField
    <l:@L> <fl:typeFieldList> <f:typeField> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "typeFieldList typeField",
            args: vec![fl, f],
            typ: "typeFieldList",
            span: context.location_span(l, r),
        }?) }),
};

structTypeDeclaration: Value = {
