controlLocalDeclaration: ValueRef = {
    <d:constantDeclaration> => d,
    <d:instantiation> => d,
    <d:variableDeclaration> => d,
    <d:actionDeclaration> => d,
    <d:tableDeclaration> => { value::declare_declaration_var(context, &d); d },
};

// controlLocalDeclarationList ::= epsilon
//   | controlLocalDeclarationList controlLocalDeclaration
controlLocalDeclarationList: ValueRef = {
    <left:@L>  <right:@R> => value::case_value(context, "_EMPTY", vec![], "controlLocalDeclarationList", left, right),
