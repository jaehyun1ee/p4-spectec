    //     parameterList "R_PAREN" pop_scope "SEMICOLON"
    <l:@L> <al:annotationList> "PARSER" <n:push_name> <tpl:typeParameterListOpt> "L_PAREN"
        <pl:parameterList> "R_PAREN" pop_scope "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationList PARSER name typeParameterListOpt `( parameterList `) ';'",
            args: vec![al, n, tpl, pl],
            typ: "parserTypeDeclaration",
            span: context.location_span(l, r),
        }?) }),
