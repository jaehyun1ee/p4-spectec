    <left:@L> "MINUS_SAT" <right:@R> => value::case_value(context, "'|-|'", vec![], "annotationToken", left, right),
    <left:@L> "MUL" <right:@R> => value::case_value(context, "'*'", vec![], "annotationToken", left, right),
    <left:@L> "DIV" <right:@R> => value::case_value(context, "'/'", vec![], "annotationToken", left, right),
    <left:@L> "MOD" <right:@R> => value::case_value(context, "'%'", vec![], "annotationToken", left, right),
    <left:@L> "BIT_OR" <right:@R> => value::case_value(context, "'|'", vec![], "annotationToken", left, right),
    <left:@L> "BIT_AND" <right:@R> => value::case_value(context, "'&'", vec![], "annotationToken", left, right),
    <left:@L> "BIT_XOR" <right:@R> => value::case_value(context, "'^'", vec![], "annotationToken", left, right),
    <left:@L> "COMPLEMENT" <right:@R> => value::case_value(context, "'~'", vec![], "annotationToken", left, right),
    <left:@L> "L_BRACKET" <right:@R> => value::case_value(context, "'['", vec![], "annotationToken", left, right),
    <left:@L> "R_BRACKET" <right:@R> => value::case_value(context, "']'", vec![], "annotationToken", left, right),
    <left:@L> "L_BRACE" <right:@R> => value::case_value(context, "'{'", vec![], "annotationToken", left, right),
    <left:@L> "R_BRACE" <right:@R> => value::case_value(context, "'}'", vec![], "annotationToken", left, right),
    <left:@L> "L_ANGLE" <right:@R> => value::case_value(context, "'<'", vec![], "annotationToken", left, right),
    <left:@L> "R_ANGLE" <right:@R> => value::case_value(context, "'>'", vec![], "annotationToken", left, right),
    <left:@L> "NOT" <right:@R> => value::case_value(context, "'!'", vec![], "annotationToken", left, right),
    <left:@L> colon <right:@R> => value::case_value(context, "':'", vec![], "annotationToken", left, right),
    <left:@L> "COMMA" <right:@R> => value::case_value(context, "','", vec![], "annotationToken", left, right),
    <left:@L> "QUESTION" <right:@R> => value::case_value(context, "'?'", vec![], "annotationToken", left, right),
    <left:@L> "DOT" <right:@R> => value::case_value(context, "'.'", vec![], "annotationToken", left, right),
    <left:@L> "ASSIGN" <right:@R> => value::case_value(context, "'='", vec![], "annotationToken", left, right),
    <left:@L> "SEMICOLON" <right:@R> => value::case_value(context, "';'", vec![], "annotationToken", left, right),
    <left:@L> "AT" <right:@R> => value::case_value(context, "'@'", vec![], "annotationToken", left, right),
};

// annotationBody ::= epsilon
//   | annotationBody "L_PAREN" annotationBody "R_PAREN"
//   | annotationBody annotationToken
annotationBody: ValueRef = {
    <left:@L>  <right:@R> => value::case_value(context, "_EMPTY", vec![], "annotationBody", left, right),
    <left:@L> <ab:annotationBody> "L_PAREN" <ab_in:annotationBody> "R_PAREN" <right:@R> => value::case_value(context, "annotationBody `( annotationBody `)", vec![ab, ab_in], "annotationBody", left, right),
    <left:@L> <ab:annotationBody> <atoken:annotationToken> <right:@R> => value::case_value(context, "annotationBody annotationToken", vec![ab, atoken], "annotationBody", left, right),
};

// structuredAnnotationBody ::= sequenceOrRecordElementExpression trailingCommaOpt
structuredAnnotationBody: ValueRef = {
    <left:@L> <e:sequenceOrRecordElementExpression> <c:trailingCommaOpt> <right:@R> => value::case_value(context, "sequenceOrRecordElementExpression trailingCommaOpt", vec![e, c], "structuredAnnotationBody", left, right),
};

// annotation ::= "AT" name
//   | "AT" name "L_PAREN" annotationBody "R_PAREN"
//   | "AT" name "L_BRACKET" structuredAnnotationBody "R_BRACKET"
//   | "PRAGMA" name annotationBody "PRAGMA_END"
annotation: ValueRef = {
    <left:@L> "AT" <name:name> <right:@R> => value::case_value(context, "'@' name", vec![name], "annotation", left, right),
    <left:@L> "AT" <name:name> "L_PAREN" <body:annotationBody> "R_PAREN" <right:@R> => value::case_value(context, "'@' name `( annotationBody `)", vec![name, body], "annotation", left, right),
    <left:@L> "AT" <name:name> "L_BRACKET" <body:structuredAnnotationBody> "R_BRACKET" <right:@R> => value::case_value(context, "'@' name `[ structuredAnnotationBody `]", vec![name, body], "annotation", left, right),
    <left:@L> "PRAGMA" <name:name> <body:annotationBody> "PRAGMA_END" <right:@R> => value::case_value(context, "'@' PRAGMA name annotationBody", vec![name, body], "annotation", left, right),
};

// annotationListNonEmpty ::= annotation
//   | annotationListNonEmpty annotation
annotationListNonEmpty: ValueRef = {
    <a:annotation> => a,
    <left:@L> <al:annotationListNonEmpty> <a:annotation> <right:@R> => value::case_value(context, "annotationListNonEmpty annotation", vec![al, a], "annotationListNonEmpty", left, right),
};

#[inline]
// annotationList ::= epsilon
//   | annotationListNonEmpty
annotationList: ValueRef = {
    <left:@L>  <right:@R> => value::case_value(context, "_EMPTY", vec![], "annotationList", left, right),
    <al:annotationListNonEmpty> => al,
};

// declarationList ::= epsilon
//   | declarationList declaration
//   | declarationList "SEMICOLON"
declarationList: ValueRef = {
    <left:@L>  <right:@R> => value::case_value(context, "_EMPTY", vec![], "declarationList", left, right),
    <left:@L> <ds:declarationList> <d:declaration> <right:@R> => value::case_value(context, "declarationList declaration", vec![ds, d], "declarationList", left, right),
    <left:@L> <ds:declarationList> "SEMICOLON" <right:@R> => value::case_value(context, "declarationList ';'", vec![ds], "declarationList", left, right),
};

// p4program ::= declarationList "END"
pub p4program: ValueRef = {
    <dl:declarationList> "END" => value::retag(dl, "p4program"),
};

// statement ::= MatchedStatement
//   | UnmatchedStatement
statement: ValueRef = {
    MatchedStatement,
    UnmatchedStatement,
};

// MatchedStatement ::= emptyStatement
//   | assignmentStatement
//   | callStatement
//   | directApplicationStatement
//   | returnStatement
//   | exitStatement
//   | blockStatement
//   | MatchedForStatement
//   | breakStatement
//   | continueStatement
//   | switchStatement
//   | "IF" "L_PAREN" expression "R_PAREN" MatchedStatement "ELSE" MatchedStatement
MatchedStatement: ValueRef = {
    emptyStatement,
    assignmentStatement,
    callStatement,
    directApplicationStatement,
    returnStatement,
    exitStatement,
    blockStatement,
    MatchedForStatement,
    breakStatement,
    continueStatement,
    switchStatement,
    <left:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:MatchedStatement> "ELSE" <no:MatchedStatement> <right:@R> =>
        value::case_value(context, "IF `( expression `) statement ELSE statement", vec![condition, yes, no], "conditionalStatement", left, right),
};

// UnmatchedStatement ::= UnmatchedForStatement
//   | "IF" "L_PAREN" expression "R_PAREN" statement
//   | "IF" "L_PAREN" expression "R_PAREN" MatchedStatement "ELSE" UnmatchedStatement
UnmatchedStatement: ValueRef = {
    UnmatchedForStatement,
    <left:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:statement> <right:@R> =>
        value::case_value(context, "IF `( expression `) statement", vec![condition, yes], "conditionalStatement", left, right),
    <left:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:MatchedStatement> "ELSE" <no:UnmatchedStatement> <right:@R> =>
        value::case_value(context, "IF `( expression `) statement ELSE statement", vec![condition, yes, no], "conditionalStatement", left, right),
};

// MatchedForStatement ::= annotationList "FOR" "L_PAREN" forInitStatementList "SEMICOLON" expression "SEMICOLON" forUpdateStatementList "R_PAREN" MatchedStatement
//   | annotationList "FOR" "L_PAREN" typeRef name "IN" forCollectionExpression "R_PAREN" MatchedStatement
//   | annotationList "FOR" "L_PAREN" annotationListNonEmpty typeRef name "IN" forCollectionExpression "R_PAREN" MatchedStatement
MatchedForStatement: ValueRef = {
    <left:@L> <annotations:annotationList> "FOR" "L_PAREN" <init:forInitStatementList> "SEMICOLON" <condition:expression> "SEMICOLON" <update:forUpdateStatementList> "R_PAREN" <body:MatchedStatement> <right:@R> =>
        value::case_value(context, "annotationList FOR `( forInitStatementList ';' expression ';' forUpdateStatementList `) statement", vec![annotations, init, condition, update, body], "forStatement", left, right),
    <left:@L> <annotations:annotationList> "FOR" "L_PAREN" <typ:typeRef> <name:name> "IN" <collection:forCollectionExpression> "R_PAREN" <body:MatchedStatement> <right:@R> =>
        value::case_value(context, "annotationList FOR `( typeRef name IN forCollectionExpression `) statement", vec![annotations, typ, name, collection, body], "forStatement", left, right),
    <left:@L> <annotations:annotationList> "FOR" "L_PAREN" <inner_annotations:annotationListNonEmpty> <typ:typeRef> <name:name> "IN" <collection:forCollectionExpression> "R_PAREN" <body:MatchedStatement> <right:@R> =>
        value::case_value(context, "annotationList FOR `( annotationList typeRef name IN forCollectionExpression `) statement", vec![annotations, inner_annotations, typ, name, collection, body], "forStatement", left, right),
};

// UnmatchedForStatement ::= annotationList "FOR" "L_PAREN" forInitStatementList "SEMICOLON" expression "SEMICOLON" forUpdateStatementList "R_PAREN" UnmatchedStatement
//   | annotationList "FOR" "L_PAREN" typeRef name "IN" forCollectionExpression "R_PAREN" UnmatchedStatement
//   | annotationList "FOR" "L_PAREN" annotationListNonEmpty typeRef name "IN" forCollectionExpression "R_PAREN" UnmatchedStatement
UnmatchedForStatement: ValueRef = {
    <left:@L> <annotations:annotationList> "FOR" "L_PAREN" <init:forInitStatementList> "SEMICOLON" <condition:expression> "SEMICOLON" <update:forUpdateStatementList> "R_PAREN" <body:UnmatchedStatement> <right:@R> =>
        value::case_value(context, "annotationList FOR `( forInitStatementList ';' expression ';' forUpdateStatementList `) statement", vec![annotations, init, condition, update, body], "forStatement", left, right),
    <left:@L> <annotations:annotationList> "FOR" "L_PAREN" <typ:typeRef> <name:name> "IN" <collection:forCollectionExpression> "R_PAREN" <body:UnmatchedStatement> <right:@R> =>
        value::case_value(context, "annotationList FOR `( typeRef name IN forCollectionExpression `) statement", vec![annotations, typ, name, collection, body], "forStatement", left, right),
    <left:@L> <annotations:annotationList> "FOR" "L_PAREN" <inner_annotations:annotationListNonEmpty> <typ:typeRef> <name:name> "IN" <collection:forCollectionExpression> "R_PAREN" <body:UnmatchedStatement> <right:@R> =>
        value::case_value(context, "annotationList FOR `( annotationList typeRef name IN forCollectionExpression `) statement", vec![annotations, inner_annotations, typ, name, collection, body], "forStatement", left, right),
};

// parserStatement ::= ParserMatchedStatement
//   | ParserUnmatchedStatement
parserStatement: ValueRef = {
    ParserMatchedStatement,
    ParserUnmatchedStatement,
};

// ParserMatchedStatement ::= emptyStatement
//   | assignmentStatement
//   | callStatement
//   | directApplicationStatement
//   | parserBlockStatement
//   | "IF" "L_PAREN" expression "R_PAREN" ParserMatchedStatement "ELSE" ParserMatchedStatement
ParserMatchedStatement: ValueRef = {
    emptyStatement,
    assignmentStatement,
    callStatement,
    directApplicationStatement,
    parserBlockStatement,
    <left:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:ParserMatchedStatement> "ELSE" <no:ParserMatchedStatement> <right:@R> =>
        value::case_value(context, "IF `( expression `) parserStatement ELSE parserStatement", vec![condition, yes, no], "parserConditionalStatement", left, right),
};

// ParserUnmatchedStatement ::= "IF" "L_PAREN" expression "R_PAREN" parserStatement
//   | "IF" "L_PAREN" expression "R_PAREN" ParserMatchedStatement "ELSE" ParserUnmatchedStatement
ParserUnmatchedStatement: ValueRef = {
    <left:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:parserStatement> <right:@R> =>
        value::case_value(context, "IF `( expression `) parserStatement", vec![condition, yes], "parserConditionalStatement", left, right),
    <left:@L> "IF" "L_PAREN" <condition:expression> "R_PAREN" <yes:ParserMatchedStatement> "ELSE" <no:ParserUnmatchedStatement> <right:@R> =>
        value::case_value(context, "IF `( expression `) parserStatement ELSE parserStatement", vec![condition, yes, no], "parserConditionalStatement", left, right),
};
