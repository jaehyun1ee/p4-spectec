            args: vec![name, body],
            typ: "annotation",
            span: context.location_span(l, r),
        }?) }),

    // annotation ::= "PRAGMA" name annotationBody "PRAGMA_END"
    <l:@L> "PRAGMA" <name:name> <body:annotationBody> "PRAGMA_END" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "'@' PRAGMA name annotationBody",
            args: vec![name, body],
            typ: "annotation",
            span: context.location_span(l, r),
        }?) }),
};

annotationListNonEmpty: Value = {
    // annotationListNonEmpty ::= annotation
    <a:annotation> => a,

    // annotationListNonEmpty ::= annotationListNonEmpty annotation
    <l:@L> <al:annotationListNonEmpty> <a:annotation> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "annotationListNonEmpty annotation",
            args: vec![al, a],
            typ: "annotationListNonEmpty",
            span: context.location_span(l, r),
        }?) }),
};

#[inline]
annotationList: Value = {
    // annotationList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "annotationList",
        span: context.location_span(l, r),
    }?) }),

    // annotationList ::= annotationListNonEmpty
    <al:annotationListNonEmpty> => al,
};

// - P4 program

declarationList: Value = {
    // declarationList ::= epsilon
    <l:@L>  <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
        shape: "_EMPTY",
        args: vec![],
        typ: "p4program",
        span: context.location_span(l, r),
    }?) }),

    // declarationList ::= declarationList declaration
    <l:@L> <ds:declarationList> <d:declaration> <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "p4program declaration",
            args: vec![ds, d],
            typ: "p4program",
            span: context.location_span(l, r),
        }?) }),

    // declarationList ::= declarationList "SEMICOLON"
    <l:@L> <ds:declarationList> "SEMICOLON" <r:@R> =>? parse::action(|| { Ok(make::case! { arena: arena,
            shape: "p4program ';'",
            args: vec![ds],
            typ: "p4program",
            span: context.location_span(l, r),
        }?) }),
};

pub p4program: Value = {
    // p4program ::= declarationList "END"
    <program:declarationList> "END" => program,
};
