use crate::frontend::{
    ctx::{Context, Location as Loc},
    error::{FrontendError, SyntaxErrorKind},
    lexer::Token,
};
use crate::lang::{
    common::{notation::atom::Atom, source::{Position, Span, Phrase}},
    el::ast::{self, *},
    xl::{self, num},
};

grammar(context: &Context);

extern {
    type Location = Loc;
    type Error = FrontendError;

    enum Token {
        "TAG_UPID" => Token::TagUpperId(<String>),
        "OPERATOR" => Token::Operator(<String>),
        "TICK_LPAREN" => Token::TickLeftParen,
        "TICK_RPAREN" => Token::TickRightParen,
        "TICK_LBRACK" => Token::TickLeftBracket,
        "TICK_RBRACK" => Token::TickRightBracket,
        "TICK_LBRACE" => Token::TickLeftBrace,
        "TICK_RBRACE" => Token::TickRightBrace,
        "TICK_LANGLE" => Token::TickLeftAngle,
        "TICK_RANGLE" => Token::TickRightAngle,
        "NL_BAR" => Token::NewlineBar,
        "NL2" => Token::Newline2,
        "NL3" => Token::Newline3,
        "SEQ" => Token::Sequence,
        "SUB" => Token::Subtype,
        "TURNSTILE" => Token::Turnstile,
        "TILESTURN" => Token::Tilesturn,
        "ARROW" => Token::Arrow,
        "ARROW_SUB" => Token::ArrowSub,
        "DOUBLE_ARROW" => Token::DoubleArrow,
        "DOUBLE_ARROW_SUB" => Token::DoubleArrowSub,
        "DOUBLE_ARROW_BOTH" => Token::DoubleArrowBoth,
        "DOUBLE_ARROW_LONG" => Token::DoubleArrowLong,
        "SQARROW" => Token::SquigglyArrow,
        "SQARROW_STAR" => Token::SquigglyArrowStar,
        "AND" => Token::And,
        "OR" => Token::Or,
        "DOT" => Token::Dot,
        "DOT2" => Token::DoubleDot,
        "DOT3" => Token::TripleDot,
        "COMMA" => Token::Comma,
        "COMMA_NL" => Token::CommaNewline,
        "SEMICOLON" => Token::Semicolon,
        "COLON" => Token::Colon,
        "COLON2" => Token::DoubleColon,
        "COLON_SLASH" => Token::ColonSlash,
        "COLON_EQ" => Token::ColonEquals,
        "HASH" => Token::Hash,
        "HASH2" => Token::DoubleHash,
        "DOLLAR" => Token::Dollar,
        "QUEST" => Token::Question,
        "TILDE" => Token::Tilde,
        "TILDE2" => Token::DoubleTilde,
        "LANGLE" => Token::LeftAngle,
        "LANGLE_DASH" => Token::LeftAngleDash,
        "LANGLE_EQ" => Token::LeftAngleEquals,
        "RANGLE" => Token::RightAngle,
        "RANGLE_EQ" => Token::RightAngleEquals,
        "RANGLE_LPAREN" => Token::RightAngleLeftParen,
        "LPAREN" => Token::LeftParen,
        "RPAREN" => Token::RightParen,
        "LBRACK" => Token::LeftBracket,
        "RBRACK" => Token::RightBracket,
        "LBRACE" => Token::LeftBrace,
        "RBRACE" => Token::RightBrace,
        "PLUS" => Token::Plus,
        "PLUS2" => Token::DoublePlus,
        "MINUS" => Token::Minus,
        "DASH" => Token::Dash,
        "STAR" => Token::Star,
        "ITER_STAR" => Token::IterStar,
        "SLASH" => Token::Slash,
        "BACKSLASH" => Token::Backslash,
        "HOLE" => Token::Hole,
        "HOLE_NUM" => Token::NumberedHole(<i64>),
        "HOLE_MULTI" => Token::MultipleHole,
        "HOLE_NIL" => Token::EmptyHole,
        "EQ" => Token::Equals,
        "NEQ" => Token::NotEquals,
        "UP" => Token::Up,
        "BAR" => Token::Bar,
        "LATEX" => Token::Latex,
        "BOOL" => Token::Bool,
        "NAT" => Token::Nat,
        "INT" => Token::Int,
        "TEXT" => Token::Text,
        "SYNTAX" => Token::Syntax,
        "EXTERN" => Token::Extern,
        "TABLE" => Token::Table,
        "RELATION" => Token::Relation,
        "RULEGROUP" => Token::RuleGroup,
        "RULE" => Token::Rule,
        "VAR" => Token::Var,
        "BUILTIN" => Token::Builtin,
        "DEC" => Token::Dec,
        "DEF" => Token::Def,
        "IF" => Token::If,
        "OTHERWISE" => Token::Otherwise,
        "DEBUG" => Token::Debug,
        "HINT_LPAREN" => Token::HintLeftParen,
        "EPS" => Token::Epsilon,
        "BOOLLIT" => Token::BoolLiteral(<bool>),
        "NATLIT" => Token::NaturalLiteral(<num::Natural>),
        "HEXLIT" => Token::HexLiteral(<num::Natural>),
        "TEXTLIT" => Token::TextLiteral(<String>),
        "UPID" => Token::UpperId(<String>),
        "LOID" => Token::LowerId(<String>),
        "DOTID" => Token::DotId(<String>),
        "UPID_LPAREN" => Token::UpperIdLeftParen(<String>),
        "LOID_LPAREN" => Token::LowerIdLeftParen(<String>),
        "UPID_LANGLE" => Token::UpperIdLeftAngle(<String>),
        "LOID_LANGLE" => Token::LowerIdLeftAngle(<String>),
        "EOF" => Token::Eof,
    }
}

// Spec ::= NL2* Def* EOF
pub Spec: ast::Spec = {
    "NL2"* <definitions:Def*> "EOF" => definitions,
};

// Def ::= DefCore NL2*
Def: ast::Def = {
    <definition:DefCore> "NL2"* => definition,
};

// DefCore ::= RuleRule | DefKindRule
DefCore: ast::Def = {
    <left:@L> <rule:RuleRule> => {
        let right = rule.span.right.clone();
        let (relid, groupid, _, _) = rule.node.clone();
        let kind = DefKind::RuleGroup(RuleGroupDef {
            relid,
            groupid,
            rules: vec![rule],
        });
        crate::phrase! {
            node: kind,
            span: Span::new(context.position(left), right),
        }
    },
    DefKindRule,
};

// DefKindRule ::= EXTERN SYNTAX VarId Hints
//   | SYNTAX CommaList<SynId>
//   | SYNTAX VarIdBind Hints DefTypEquals DefTyp
//   | SYNTAX VarIdLAngleBind EnterScope CommaList<TParam> RANGLE Hints
//       DefTypEquals DefTyp
//   | VAR VarIdBind COLON PlainTyp Hints
//   | EXTERN RELATION RelId COLON NotTyp Hints
//   | RELATION RelId COLON NotTyp Hints
//   | RULEGROUP RelId RuleIds SEQ? LBRACE Rules RBRACE
//   | EXTERN DEC DOLLAR CallableDec
//   | BUILTIN DEC DOLLAR CallableDec
//   | TABLE DEC DOLLAR TableDecSignature
//   | DEC DOLLAR CallableDec
//   | TABLE DEF DOLLAR DefId EQ TableBody
//   | DEF DOLLAR FunctionDefSignature
//   | NL3
DefKindRule: ast::Def = {
    <left:@L> "EXTERN" "SYNTAX" <id:VarId> <hints:Hints> => {
        let right = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| id.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::ExternSyntax(ExternSyntaxDef { id, hints }),
            span: Span::new(context.position(left), right),
        }
    },
    <left:@L> "SYNTAX" <syntax_right:@R> <entries:CommaList<SynId>> <right:@R> =>? {
        if entries.is_empty() {
            Err(lalrpop_util::ParseError::User {
                error: crate::phrase! {
                    node: SyntaxErrorKind::EmptySyntaxDeclaration,
                    span: context.span(left, syntax_right),
                }.into(),
            })
        } else {
            Ok(crate::phrase! {
                node: DefKind::Syntax(SyntaxDef { entries }),
                span: context.span(left, right),
            })
        }
    },
    <left:@L> "SYNTAX" <id:VarIdBind> <hints:Hints> <equal_right:DefTypEquals>
        <def_typ:DefTyp?> =>? {
        let def_typ = def_typ.ok_or_else(|| lalrpop_util::ParseError::User {
            error: crate::phrase! {
                node: SyntaxErrorKind::EmptyType,
                span: context.span(equal_right, equal_right),
            }.into(),
        })?;
        let right = def_typ.span.right.clone();
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        Ok(crate::phrase! {
            node: DefKind::Typ(TypDef {
                id,
                tparams: vec![],
                def_typ,
                hints,
            }),
            span: Span::new(context.position(left), right),
        })
    },
    <left:@L> "SYNTAX" <id:VarIdLAngleBind> <_enter:EnterScope>
        <tparams:CommaList<TParam>> "RANGLE" <hints:Hints> <equal_right:DefTypEquals>
        <def_typ:DefTyp?> =>? {
            context.exit_scope();
            let def_typ = def_typ.ok_or_else(|| lalrpop_util::ParseError::User {
                error: crate::phrase! {
                    node: SyntaxErrorKind::EmptyType,
                    span: context.span(equal_right, equal_right),
                }.into(),
            })?;
            let right = def_typ.span.right.clone();
            let hints = hints.into_iter().map(|hint| hint.node).collect();
            Ok(crate::phrase! {
                node: DefKind::Typ(TypDef {
                    id,
                    tparams,
                    def_typ,
                    hints,
                }),
                span: Span::new(context.position(left), right),
            })
        },
    <left:@L> "VAR" <id:VarIdBind> "COLON" <plain_typ:PlainTyp> <hints:Hints> => {
        let right = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::Var(VarDef { id, plain_typ, hints }),
            span: Span::new(context.position(left), right),
        }
    },
    <left:@L> "EXTERN" "RELATION" <id:RelId> "COLON" <not_typ:NotTyp>
        <hints:Hints> => {
        let right = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| not_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::ExternRel(ExternRelDef { id, not_typ, hints }),
            span: Span::new(context.position(left), right),
        }
    },
    <left:@L> "RELATION" <id:RelId> "COLON" <not_typ:NotTyp> <hints:Hints> => {
        let right = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| not_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::Rel(RelDef { id, not_typ, hints }),
            span: Span::new(context.position(left), right),
        }
    },
    <left:@L> "RULEGROUP" <relid:RelId> <ruleids:RuleIds> "SEQ"? "LBRACE"
        <rules:Rules> "RBRACE" <right:@R> => {
        let groupid = if ruleids.node.is_empty() {
            String::new()
        } else {
            ruleids.node[1..].to_owned()
        };
        crate::phrase! {
            node: DefKind::RuleGroup(RuleGroupDef {
                relid,
                groupid: crate::phrase! {
                    node: groupid,
                    span: ruleids.span,
                },
                rules,
            }),
            span: context.span(left, right),
        }
    },
    <left:@L> "EXTERN" "DEC" "DOLLAR" <signature:CallableDec> => {
        let (id, tparams, params, plain_typ, hints) = signature;
        let right = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::ExternDec(ExternDecDef { id, tparams, params, plain_typ, hints }),
            span: Span::new(context.position(left), right),
        }
    },
    <left:@L> "BUILTIN" "DEC" "DOLLAR" <signature:CallableDec> => {
        let (id, tparams, params, plain_typ, hints) = signature;
        let right = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::BuiltinDec(BuiltinDecDef { id, tparams, params, plain_typ, hints }),
            span: Span::new(context.position(left), right),
        }
    },
    <left:@L> "TABLE" "DEC" "DOLLAR" <signature:TableDecSignature> => {
        let (id, params, plain_typ, hints) = signature;
        let right = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::TableDec(TableDecDef { id, params, plain_typ, hints }),
            span: Span::new(context.position(left), right),
        }
    },
    <left:@L> "DEC" "DOLLAR" <signature:CallableDec> => {
        let (id, tparams, params, plain_typ, hints) = signature;
        let right = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::FuncDec(FuncDecDef { id, tparams, params, plain_typ, hints }),
            span: Span::new(context.position(left), right),
        }
    },
    <left:@L> "TABLE" "DEF" "DOLLAR" <id:DefId> "EQ" <rows:TableBody>
        <right:@R> => {
        crate::phrase! {
            node: DefKind::TableDef(TableDef { id, rows }),
            span: context.span(left, right),
        }
    },
    <left:@L> "DEF" "DOLLAR" <signature:FunctionDefSignature> => {
        let (id, tparams, args, exp, prems) = signature;
        let right = prems
            .last()
            .map(|premise| premise.span.right.clone())
            .unwrap_or_else(|| exp.span.right.clone());
        let prems = prems
            .into_iter()
            .filter_map(|premise| premise.node)
            .collect();
        crate::phrase! {
            node: DefKind::FuncDef(FuncDef { id, tparams, args, exp, prems }),
            span: Span::new(context.position(left), right),
        }
    },
    <left:@L> "NL3" <right:@R> => crate::phrase! {
        node: DefKind::Sep,
        span: context.span(left, right),
    },
};

// EnterScope ::= ε
EnterScope: () = {
    => context.enter_scope(),
};

// ExitScope ::= ε
ExitScope: () = {
    => context.exit_scope(),
};

// EnterExp ::= ε
EnterExp: () = {
    => context.enter_exp(),
};

// EnterArith ::= ε
EnterArith: () = {
    => context.enter_arith(),
};

// ExitMode ::= ε
ExitMode: () = {
    => context.exit_mode(),
};

// DefTypEquals ::= EQ
DefTypEquals: Loc = {
    "EQ" <right:@R> => right,
};

// Comma ::= COMMA | COMMA_NL
Comma: () = {
    "COMMA" => (),
    "COMMA_NL" => (),
};

// Separated<T, Sep> ::= ε | T (Sep T)*
Separated<T, Sep>: Vec<T> = {
    => vec![],
    <head:T> <tail:(<Sep> <T>)*> => {
        let mut items = Vec::with_capacity(tail.len() + 1);
        items.push(head);
        items.extend(tail.into_iter().map(|(_, item)| item));
        items
    },
};

// CommaList<T> ::= Separated<T, Comma>
CommaList<T>: Vec<T> = Separated<T, Comma>;

// Id ::= UPID | LOID
Id: ast::Id = {
    <left:@L> <id:"UPID"> <right:@R> => crate::phrase! {
        node: id,
        span: context.span(left, right),
    },
    <left:@L> <id:"LOID"> <right:@R> => crate::phrase! {
        node: id,
        span: context.span(left, right),
    },
};

// IdLParen ::= UPID_LPAREN | LOID_LPAREN
IdLParen: ast::Id = {
    <left:@L> <id:"UPID_LPAREN"> <right:@R> => crate::phrase! {
        node: id,
        span: context.span(left, right),
    },
    <left:@L> <id:"LOID_LPAREN"> <right:@R> => crate::phrase! {
        node: id,
        span: context.span(left, right),
    },
};

// IdLAngle ::= UPID_LANGLE | LOID_LANGLE
IdLAngle: ast::Id = {
    <left:@L> <id:"UPID_LANGLE"> <right:@R> => crate::phrase! {
        node: id,
        span: context.span(left, right),
    },
    <left:@L> <id:"LOID_LANGLE"> <right:@R> => crate::phrase! {
        node: id,
        span: context.span(left, right),
    },
};

// VarId ::= LOID
VarId: ast::Id = {
    <left:@L> <id:"LOID"> <right:@R> => crate::phrase! {
        node: id,
        span: context.span(left, right),
    },
};

// VarIdBind ::= VarId | UPID
VarIdBind: ast::Id = {
    <id:VarId> => {
        context.add_id(&id.node);
        id
    },
    <left:@L> <id:"UPID"> <right:@R> => {
        context.add_id(&id);
        crate::phrase! {
            node: id,
            span: context.span(left, right),
        }
    },
};

// VarIdLAngle ::= LOID_LANGLE
VarIdLAngle: ast::Id = {
    <left:@L> <id:"LOID_LANGLE"> <right:@R> => crate::phrase! {
        node: id,
        span: context.span(left, right),
    },
};

// VarIdLAngleBind ::= VarIdLAngle | UPID_LANGLE
VarIdLAngleBind: ast::Id = {
    <id:VarIdLAngle> => {
        context.add_id(&id.node);
        id
    },
    <left:@L> <id:"UPID_LANGLE"> <right:@R> => {
        context.add_id(&id);
        crate::phrase! {
            node: id,
            span: context.span(left, right),
        }
    },
};

// AtomIdRaw ::= UPID
AtomIdRaw: String = {
    <id:"UPID"> => id,
};

// AtomIdLParen ::= UPID_LPAREN
AtomIdLParen: String = {
    <id:"UPID_LPAREN"> => id,
};

// AtomIdLAngle ::= UPID_LANGLE
AtomIdLAngle: String = {
    <id:"UPID_LANGLE"> => id,
};

// DotId ::= DOTID
DotId: ast::Atom = {
    <left:@L> <id:"DOTID"> <right:@R> => {
        crate::phrase! {
            node: Atom::Keyword(id),
            span: context.span(left, right),
        }
    },
};

// FieldId ::= AtomIdRaw
FieldId: ast::Atom = {
    <left:@L> <id:AtomIdRaw> <right:@R> => {
        crate::phrase! {
            node: Atom::Keyword(id),
            span: context.span(left, right),
        }
    },
};

// RelId ::= Id
RelId: ast::Id = Id;

// DefId ::= Id
DefId: ast::Id = Id;

// DefIdLParen ::= IdLParen
DefIdLParen: ast::Id = IdLParen;

// DefIdLAngle ::= IdLAngle
DefIdLAngle: ast::Id = IdLAngle;

// HintId ::= UPID | LOID
HintId: String = {
    <id:"UPID"> => id,
    <id:"LOID"> => id,
};

// SynId ::= VarId | VarIdLAngleBind EnterScope CommaList<TParam> RANGLE
//   ExitScope
SynId: SyntaxDefEntry = {
    <id:VarId> => SyntaxDefEntry { id, tparams: vec![] },
    <id:VarIdLAngleBind> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE"
        <_exit:ExitScope> => SyntaxDefEntry { id, tparams },
};

// RuleId ::= UPID | LOID | TEXT | EXTERN | BUILTIN | NATLIT | BOOLLIT
//   | RuleId DOTID
RuleId: String = {
    <id:"UPID"> => id,
    <id:"LOID"> => id,
    "TEXT" => "text".to_owned(),
    "EXTERN" => "extern".to_owned(),
    "BUILTIN" => "builtin".to_owned(),
    <value:"NATLIT"> => value.to_string(),
    <value:"BOOLLIT"> => value.to_string(),
    <prefix:RuleId> <suffix:"DOTID"> => format!("{prefix}.{suffix}"),
};

// RuleIdSegment ::= SLASH RuleId | MINUS RuleId
RuleIdSegment: String = {
    "SLASH" <id:RuleId> => format!("/{id}"),
    "MINUS" <id:RuleId> => format!("-{id}"),
};

// RuleIds ::= RuleIdSegment*
RuleIds: ast::Id = {
    <left:@L> <segments:RuleIdSegment*> <right:@R> => {
        crate::phrase! {
            node: segments.concat(),
            span: context.span(left, right),
        }
    },
};

// TParam ::= VarIdBind
TParam: ast::TParam = VarIdBind;

// Targ ::= PlainTyp
Targ: ast::Targ = PlainTyp;

// IterRule ::= QUEST | STAR | ITER_STAR
#[inline]
IterRule: Iter = {
    "QUEST" => Iter::Opt,
    "STAR" => Iter::List,
    "ITER_STAR" => Iter::List,
};

// PlainTyp ::= PlainTypBase | PlainTyp IterRule
PlainTyp: ast::PlainTyp = {
    #[precedence(level="0")]
    <left:@L> <kind:PlainTypBase> <right:@R> => crate::phrase! {
        node: kind,
        span: context.span(left, right),
    },
    #[precedence(level="1")]
    #[assoc(side="left")]
    <left:@L> <plain_typ:PlainTyp> <iter:IterRule> <right:@R> => {
        crate::phrase! {
            node: PlainTypKind::Iter(Box::new(plain_typ), iter),
            span: context.span(left, right),
        }
    },
};

// PlainTypBase ::= PlainTypPrimaryKind
//   | LPAREN CommaList<PlainTyp> RPAREN
PlainTypBase: PlainTypKind = {
    PlainTypPrimaryKind,
    <left:@L> "LPAREN" <types:CommaList<PlainTyp>> "RPAREN" <right:@R> => {
        match types.as_slice() {
            [] => PlainTypKind::Paren(Box::new(crate::phrase! {
                node: PlainTypKind::Tuple(vec![]),
                span: context.span(left, right),
            })),
            [plain_typ] => PlainTypKind::Paren(Box::new(plain_typ.clone())),
            _ => PlainTypKind::Tuple(types),
        }
    },
};

// PlainTypPrimaryKind ::= VarId | VarIdLAngle CommaList<Targ> RANGLE
//   | BOOL | NAT | INT | TEXT
PlainTypPrimaryKind: PlainTypKind = {
    <id:VarId> => PlainTypKind::Var(id, vec![]),
    <id:VarIdLAngle> <targs:CommaList<Targ>> "RANGLE" => PlainTypKind::Var(id, targs),
    "BOOL" => PlainTypKind::Bool,
    "NAT" => PlainTypKind::Num(num::Typ::Nat),
    "INT" => PlainTypKind::Num(num::Typ::Int),
    "TEXT" => PlainTypKind::Text,
};

// AtomRule ::= AtomKind
AtomRule: ast::Atom = {
    <left:@L> <atom:AtomKind> <right:@R> => crate::phrase! {
        node: atom,
        span: context.span(left, right),
    },
};

// AtomKind ::= AtomIdRaw | TAG_UPID | OPERATOR
AtomKind: Atom = {
    <id:AtomIdRaw> => Atom::Keyword(id),
    <id:"TAG_UPID"> => Atom::Tag(id),
    <operator:"OPERATOR"> => Atom::Operator(operator),
};

// TypAtom ::= AtomIdRaw DOTID* | TAG_UPID | OPERATOR
TypAtom: ast::Atom = {
    <left:@L> <id:AtomIdRaw> <suffixes:"DOTID"*> <right:@R> => {
        let id = suffixes.into_iter().fold(id, |prefix, suffix| {
            format!("{prefix}.{suffix}")
        });
        crate::phrase! {
            node: Atom::Keyword(id),
            span: context.span(left, right),
        }
    },
    <left:@L> <id:"TAG_UPID"> <right:@R> => crate::phrase! {
        node: Atom::Tag(id),
        span: context.span(left, right),
    },
    <left:@L> <operator:"OPERATOR"> <right:@R> => {
        crate::phrase! {
            node: Atom::Operator(operator),
            span: context.span(left, right),
        }
    },
};

// TypPrimary ::= PlainTyp | TypAtom
//   | TickLAngle Typ TickRAngle
//   | TickLParen Typ TickRParen
//   | TickLBrack Typ TickRBrack
//   | TickLBrace Typ TickRBrace
TypPrimary: Typ = {
    <plain_typ:PlainTyp> => Typ::Plain(plain_typ),
    <atom:TypAtom> => {
        let span = atom.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Atom(atom),
            span: span,
        })
    },
    <left:TickLAngle> <typ:Typ> <right:TickRAngle> => {
        let span = left.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Brack(left, Box::new(typ), right),
            span: span,
        })
    },
    <left:TickLParen> <typ:Typ> <right:TickRParen> => {
        let span = left.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Brack(left, Box::new(typ), right),
            span: span,
        })
    },
    <left:TickLBrack> <typ:Typ> <right:TickRBrack> => {
        let span = left.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Brack(left, Box::new(typ), right),
            span: span,
        })
    },
    <left:TickLBrace> <typ:Typ> <right:TickRBrace> => {
        let span = left.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Brack(left, Box::new(typ), right),
            span: span,
        })
    },
};

// Typ ::= RelationOperator Typ | TypDoubleArrow
Typ: Typ = {
    <operator:RelationOperator> <right:Typ> => {
        let span = operator.span.clone();
        let left = Typ::Notation(crate::phrase! {
            node: NotTypKind::Seq(vec![]),
            span: span.clone(),
        });
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypDoubleArrow,
};

// TypDoubleArrow ::= TypTurnstile DoubleArrowTypOperator TypDoubleArrow
//   | TypTurnstile
TypDoubleArrow: Typ = {
    <left:TypTurnstile> <operator:DoubleArrowTypOperator> <right:TypDoubleArrow> => {
        let span = operator.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypTurnstile,
};

// TypTurnstile ::= TypTilesturn TurnstileOperator TypTilesturn
//   | TypTilesturn
TypTurnstile: Typ = {
    <left:TypTilesturn> <operator:TurnstileOperator> <right:TypTilesturn> => {
        let span = operator.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypTilesturn,
};

// TypTilesturn ::= TypSquiggly TilesturnOperator TypSquiggly
//   | TypSquiggly
TypTilesturn: Typ = {
    <left:TypSquiggly> <operator:TilesturnOperator> <right:TypSquiggly> => {
        let span = operator.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypSquiggly,
};

// TypSquiggly ::= TypColon SquigglyOperator TypSquiggly | TypColon
TypSquiggly: Typ = {
    <left:TypColon> <operator:SquigglyOperator> <right:TypSquiggly> => {
        let span = operator.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypColon,
};

// TypColon ::= TypColon ColonTypOperator TypArrow | TypArrow
TypColon: Typ = {
    <left:TypColon> <operator:ColonTypOperator> <right:TypArrow> => {
        let span = operator.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypArrow,
};

// TypArrow ::= TypSemicolon ArrowTypOperator TypArrow | TypSemicolon
TypArrow: Typ = {
    <left:TypSemicolon> <operator:ArrowTypOperator> <right:TypArrow> => {
        let span = operator.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypSemicolon,
};

// TypSemicolon ::= TypSemicolon SemicolonOperator TypDot | TypDot
TypSemicolon: Typ = {
    <left:TypSemicolon> <operator:SemicolonOperator> <right:TypDot> => {
        let span = operator.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypDot,
};

// TypDot ::= TypDot DotOperator TypBackslash | TypBackslash
TypDot: Typ = {
    <left:TypDot> <operator:DotOperator> <right:TypBackslash> => {
        let span = operator.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypBackslash,
};

// TypBackslash ::= TypBackslash BackslashOperator TypPrefix | TypPrefix
TypBackslash: Typ = {
    <left:TypBackslash> <operator:BackslashOperator> <right:TypPrefix> => {
        let span = operator.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypPrefix,
};

// TypPrefix ::= InfixOperator TypPrefix | TypSeq
TypPrefix: Typ = {
    <operator:InfixOperator> <right:TypPrefix> => {
        let span = operator.span.clone();
        let left = Typ::Notation(crate::phrase! {
            node: NotTypKind::Seq(vec![]),
            span: span.clone(),
        });
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        })
    },
    TypSeq,
};

// TypSeq ::= TypPrimary (SEQ TypPrimary)*
TypSeq: Typ = {
    <first:TypPrimary> <first_right:@R> <rest:("SEQ" <TypPrimary>)*> => {
        if rest.is_empty() {
            first
        } else {
            let left = match &first {
                Typ::Plain(plain_typ) => plain_typ.span.left.clone(),
                Typ::Notation(not_typ) => not_typ.span.left.clone(),
            };
            let span = Span::new(left, context.position(first_right));
            let mut types = Vec::with_capacity(rest.len() + 1);
            types.push(first);
            types.extend(rest);
            Typ::Notation(crate::phrase! {
                node: NotTypKind::Seq(types),
                span: span,
            })
        }
    },
};

// CheckTyp ::= Typ EOF
pub CheckTyp: Typ = {
    <typ:Typ> "EOF" => typ,
};

// NotTyp ::= Typ
NotTyp: ast::NotTyp = {
    <left:@L> <typ:Typ> <right:@R> =>? match typ {
        Typ::Notation(not_typ) => Ok(not_typ),
        Typ::Plain(_) => Err(lalrpop_util::ParseError::User {
            error: crate::phrase! {
                node: SyntaxErrorKind::ExpectedNotationType,
                span: context.span(left, right),
            }.into(),
        }),
    },
};

// FieldTyp ::= FieldId SEQ PlainTyp Hints
FieldTyp: ast::TypField = {
    <field:FieldId> "SEQ" <plain_typ:PlainTyp> <hints:Hints> => {
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        (field, plain_typ, hints)
    },
};

// CaseTyp ::= Typ Hints
CaseTyp: (Typ, Vec<ast::Hint>, Position) = {
    <typ:Typ> <typ_right:@R> <hints:Hints> => {
        let right = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| context.position(typ_right));
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        (typ, hints, right)
    },
};

// CaseTypList ::= CaseTyp (Bar CaseTyp)* BarAt?
CaseTypList: (Vec<(Typ, Vec<ast::Hint>, Position)>, Option<Loc>) = {
    <head:CaseTyp> <tail:(<Bar> <CaseTyp>)*> <trailing:BarAt?> => {
        let mut cases = Vec::with_capacity(tail.len() + 1);
        cases.push(head);
        cases.extend(tail.into_iter().map(|(_, case)| case));
        (cases, trailing)
    },
};

// BarAt ::= Bar
BarAt: Loc = {
    <_bar:Bar> <right:@R> => right,
};

// DefTyp ::= LBRACE CommaList<FieldTyp> RBRACE
//   | Bar CaseTypList
//   | CaseTypList
DefTyp: ast::DefTyp = {
    <left:@L> "LBRACE" <fields:CommaList<FieldTyp>> "RBRACE" <right:@R> =>? {
        if fields.is_empty() {
            Err(lalrpop_util::ParseError::User {
                error: crate::phrase! {
                    node: SyntaxErrorKind::EmptyStructType,
                    span: context.span(left, right),
                }.into(),
            })
        } else {
            Ok(crate::phrase! {
                node: DefTypKind::Struct(fields),
                span: context.span(left, right),
            })
        }
    },
    <left:@L> <_bar:Bar> <bar_right:@R> <case_list:CaseTypList?> =>? {
        let (cases, trailing) = case_list.unwrap_or_else(|| (vec![], None));
        let actual_right = trailing
            .map(|location| context.position(location))
            .or_else(|| cases.last().map(|(_, _, right)| right.clone()))
            .unwrap_or_else(|| context.position(bar_right));
        let actual_right_location = context.location(actual_right.clone());
        let cases: Vec<(Typ, Vec<ast::Hint>)> = cases
            .into_iter()
            .map(|(typ, hints, _)| (typ, hints))
            .collect();
        let kind = if cases.is_empty() {
            Err(SyntaxErrorKind::EmptyVariantType)
        } else if cases
            .iter()
            .any(|(typ, hints)| matches!(typ, Typ::Plain(_)) && !hints.is_empty())
        {
            Err(SyntaxErrorKind::HintsInPlainTypeDefinition)
        } else if let [(Typ::Plain(plain_typ), _)] = cases.as_slice() {
            Ok(DefTypKind::Plain(plain_typ.clone()))
        } else {
            Ok(DefTypKind::Variant(cases))
        };
        kind
            .map(|kind| crate::phrase! {
                node: kind,
                span: Span::new(context.position(left), actual_right),
            })
            .map_err(|kind| lalrpop_util::ParseError::User {
                error: crate::phrase! {
                    node: kind,
                    span: context.span(left, actual_right_location),
                }.into(),
            })
    },
    <left:@L> <case_list:CaseTypList> =>? {
        let (cases, trailing) = case_list;
        let actual_right = trailing
            .map(|location| context.position(location))
            .or_else(|| cases.last().map(|(_, _, right)| right.clone()))
            .expect("a non-empty case type list has a closing position");
        let actual_right_location = context.location(actual_right.clone());
        let cases: Vec<(Typ, Vec<ast::Hint>)> = cases
            .into_iter()
            .map(|(typ, hints, _)| (typ, hints))
            .collect();
        let kind = if cases.is_empty() {
            Err(SyntaxErrorKind::EmptyType)
        } else if cases
            .iter()
            .any(|(typ, hints)| matches!(typ, Typ::Plain(_)) && !hints.is_empty())
        {
            Err(SyntaxErrorKind::HintsInPlainTypeDefinition)
        } else if let [(Typ::Plain(plain_typ), _)] = cases.as_slice() {
            Ok(DefTypKind::Plain(plain_typ.clone()))
        } else {
            Ok(DefTypKind::Variant(cases))
        };
        kind
            .map(|kind| crate::phrase! {
                node: kind,
                span: Span::new(context.position(left), actual_right),
            })
            .map_err(|kind| lalrpop_util::ParseError::User {
                error: crate::phrase! {
                    node: kind,
                    span: context.span(left, actual_right_location),
                }.into(),
            })
    },
};

