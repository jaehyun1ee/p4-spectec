    // ArithUnary ::= BAR EnterExp Exp BAR ExitMode
    <l:@L> "BAR" <_enter:EnterExp> <exp:Exp> "BAR" <r:@R> <_exit:ExitMode> => {
        crate::phrase! {
            node: ExpKind::Len(Box::new(exp)),
            span: context.span(l, r),
        }
    },

    // ArithUnary ::= UnaryOperator ArithUnary
    <l:@L> <operator:UnaryOperator> <exp:ArithUnary> <r:@R> => {
        crate::phrase! {
            node: ExpKind::Un(operator, Box::new(exp)),
            span: context.span(l, r),
        }
    },

    // ArithUnary ::= ArithPost
    ArithPost,
};

ArithPost: ast::Exp = {
    // ArithPost ::= ArithAtomBase
    ArithAtomBase,

    // ArithPost ::= ArithPost UP ArithAtomBase
    <l:@L> <base:ArithPost> "UP" <exponent:ArithAtomBase> <r:@R> => {
        crate::phrase! {
            node: ExpKind::Bin(
                Box::new(base),
                BinOp::Num(num::BinOp::Pow),
                Box::new(exponent),
            ),
            span: context.span(l, r),
        }
    },

    // ArithPost ::= ArithPost LBRACK Arith RBRACK
    <l:@L> <base:ArithPost> "LBRACK" <index:Arith> "RBRACK" <r:@R> => {
        crate::phrase! {
            node: ExpKind::Idx(Box::new(base), Box::new(index)),
            span: context.span(l, r),
        }
    },

    // ArithPost ::= ArithPost DotId
    <l:@L> <base:ArithPost> <field:DotId> <r:@R> => {
        match (base.node, field.node) {
            (ExpKind::Atom(atom), Atom::Keyword(suffix)) => match atom.node {
                Atom::Keyword(prefix) => {
                    let span = context.span(l, r);
                    let atom = crate::phrase! {
                        node: Atom::Keyword(format!("{prefix}.{suffix}")),
                        span: span.clone(),
                    };
                    crate::phrase! {
                        node: ExpKind::Atom(atom),
                        span: span,
                    }
                }
                node => crate::phrase! {
                    node: ExpKind::Dot(
                        Box::new(crate::phrase! {
                            node: ExpKind::Atom(crate::phrase! {
                                node: node,
                                span: atom.span,
                            }),
                            span: base.span,
                        }),
                        crate::phrase! {
                            node: Atom::Keyword(suffix),
                            span: field.span,
                        },
                    ),
                    span: context.span(l, r),
                },
            },
            (node, field_node) => crate::phrase! {
                node: ExpKind::Dot(
                    Box::new(crate::phrase! {
                        node: node,
                        span: base.span,
                    }),
                    crate::phrase! {
                        node: field_node,
                        span: field.span,
                    },
                ),
                span: context.span(l, r),
            },
        }
    },
};

ArithAtomBase: ast::Exp = {
    // ArithAtomBase ::= ExpLiteral
    ExpLiteral,

    // ArithAtomBase ::= ExpVariable
    ExpVariable,

    // ArithAtomBase ::= ExpCall
    ExpCall,

    // ArithAtomBase ::= ExpHole
    ExpHole,

    // ArithAtomBase ::= LPAREN Arith RPAREN
    <l:@L> "LPAREN" <arith:Arith> "RPAREN" <r:@R> => {
        crate::phrase! {
            node: ExpKind::Paren(Box::new(arith)),
            span: context.span(l, r),
        }
    },

    // ArithAtomBase ::= DOLLAR LPAREN EnterExp Exp RPAREN ExitMode
    <l:@L> "DOLLAR" "LPAREN" <_enter:EnterExp> <exp:Exp> "RPAREN" <r:@R>
        <_exit:ExitMode> => {
        crate::phrase! {
            node: exp.node,
            span: context.span(l, r),
        }
    },

    // ArithAtomBase ::= AtomRule
    <atom:AtomRule> => {
        let span = atom.span.clone();
        crate::phrase! {
            node: ExpKind::Atom(atom),
            span: span,
        }
    },
};

UpdatePath: ast::Path = {
    // UpdatePath ::= LBRACK
    "LBRACK" <r:@R> => crate::phrase! {
        node: PathKind::Root,
        span: context.span(r, r),
    },

    // UpdatePath ::= UpdatePath LBRACK Arith RBRACK
    <path:UpdatePath> "LBRACK" <index:Arith> "RBRACK" <r:@R> => {
        let l = path.span.left.clone();
        crate::phrase! {
            node: PathKind::Idx(Box::new(path), Box::new(index)),
            span: Span::new(l, context.position(r)),
        }
    },

    // UpdatePath ::= UpdatePath LBRACK Arith COLON Arith RBRACK
    <path:UpdatePath> "LBRACK" <start:Arith> "COLON" <end:Arith> "RBRACK"
        <r:@R> => {
        let l = path.span.left.clone();
        crate::phrase! {
            node: PathKind::Slice(Box::new(path), Box::new(start), Box::new(end)),
            span: Span::new(l, context.position(r)),
        }
    },

    // UpdatePath ::= UpdatePath DotId
    <path:UpdatePath> <field:DotId> <r:@R> => {
        let l = path.span.left.clone();
        crate::phrase! {
            node: PathKind::Dot(Box::new(path), field),
            span: Span::new(l, context.position(r)),
        }
    },
};

Param: ast::Param = {
    // Param ::= ParamKindRule
    <l:@L> <kind:ParamKindRule> <r:@R> => crate::phrase! {
        node: kind,
        span: context.span(l, r),
    },
};

ParamKindRule: ParamKind = {
    // ParamKindRule ::= PlainTyp
    <plain_typ:PlainTyp> => ParamKind::Exp(plain_typ),

    // ParamKindRule ::= DEF DOLLAR DefId COLON PlainTyp
    "DEF" "DOLLAR" <id:DefId> "COLON" <plain_typ:PlainTyp> => {
        ParamKind::Def(id, vec![], vec![], plain_typ)
    },

    // ParamKindRule ::= DEF DOLLAR DefIdLParen EnterScope CommaList<Param> RPAREN COLON PlainTyp
    //     ExitScope
    "DEF" "DOLLAR" <id:DefIdLParen> <_enter:EnterScope> <params:CommaList<Param>>
        "RPAREN" "COLON" <plain_typ:PlainTyp> <_exit:ExitScope> => {
            ParamKind::Def(id, vec![], params, plain_typ)
        },

    // ParamKindRule ::= DEF DOLLAR DefIdLAngle EnterScope CommaList<TParam> RANGLE COLON PlainTyp
    //     ExitScope
    "DEF" "DOLLAR" <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>>
        "RANGLE" "COLON" <plain_typ:PlainTyp> <_exit:ExitScope> => {
            ParamKind::Def(id, tparams, vec![], plain_typ)
        },

    // ParamKindRule ::= DEF DOLLAR DefIdLAngle EnterScope CommaList<TParam> RANGLE_LPAREN
    //     CommaList<Param> RPAREN COLON PlainTyp ExitScope
    "DEF" "DOLLAR" <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>>
        "RANGLE_LPAREN" <params:CommaList<Param>> "RPAREN" "COLON" <plain_typ:PlainTyp>
        <_exit:ExitScope> => ParamKind::Def(id, tparams, params, plain_typ),
};

PremList: Vec<Phrase<Option<ast::Prem>>> = {
    // PremList ::= EnterScope PremEntry* ExitScope
    <_enter:EnterScope> <entries:PremEntry*> <_exit:ExitScope> => entries,
};

PremEntry: Phrase<Option<ast::Prem>> = {
    // PremEntry ::= DASH DASH
    <l:@L> "DASH" "DASH" <r:@R> => crate::phrase! {
        node: None,
        span: context.span(l, r),
    },

    // PremEntry ::= DASH Prem
    <l:@L> "DASH" <premise:Prem> <r:@R> => crate::phrase! {
        node: Some(premise),
        span: context.span(l, r),
    },
};

Prem: ast::Prem = {
    // Prem ::= PremKindRule
    <l:@L> <kind:PremKindRule> <r:@R> => crate::phrase! {
        node: kind,
        span: context.span(l, r),
    },
};

PremKindRule: PremKind = {
    // PremKindRule ::= OTHERWISE
    "OTHERWISE" => PremKind::Else,

    // PremKindRule ::= LPAREN Prem RPAREN IterRule*
    <l:@L> "LPAREN" <premise:Prem> "RPAREN" <iterations:IterRule*> <r:@R> => {
        let mut premise = premise;
        for iter in iterations {
            premise = crate::phrase! {
                node: PremKind::Iter(IterPrem {
                    prem: Box::new(premise),
                    iter,
                }),
                span: context.span(l, r),
            };
        }
        premise.node
    },

    // PremKindRule ::= RelId COLON Exp
    <id:RelId> "COLON" <exp:Exp> => PremKind::Rule(RulePrem { id, exp }),

    // PremKindRule ::= RelId COLON_SLASH Exp
    <id:RelId> "COLON_SLASH" <exp:Exp> => PremKind::RuleNot(RuleNotPrem { id, exp }),

    // PremKindRule ::= VAR VarIdBind COLON PlainTyp
    "VAR" <id:VarIdBind> "COLON" <plain_typ:PlainTyp> => {
        PremKind::Var(VarPrem { id, plain_typ })
    },

    // PremKindRule ::= IF Exp
    "IF" <exp:Exp> => {
        fn from_exp(exp: ast::Exp) -> PremKind {
            match exp.node {
                ExpKind::Iter(exp, iter) => {
                    let span = exp.span.clone();
                    PremKind::Iter(IterPrem {
                        prem: Box::new(crate::phrase! {
                            node: from_exp(*exp),
                            span: span,
                        }),
                        iter,
                    })
                }
                node => PremKind::If(IfPrem {
                    exp: crate::phrase! {
                        node: node,
                        span: exp.span,
                    },
                }),
            }
        }
        from_exp(exp)
    },

    // PremKindRule ::= DEBUG Exp
    "DEBUG" <exp:Exp> => PremKind::Debug(DebugPrem { exp }),
};

Hint: Phrase<ast::Hint> = {
    // Hint ::= HINT_LPAREN HintId SEQ Exp RPAREN
    <l:@L> "HINT_LPAREN" <id_l:@L> <id:HintId> <id_r:@R> "SEQ"
        <exp:Exp> "RPAREN" <r:@R> => {
        let id = crate::phrase! {
            node: id,
            span: context.span(id_l, id_r),
        };
        crate::phrase! {
            node: (id, exp),
            span: context.span(l, r),
        }
    },

    // Hint ::= HINT_LPAREN HintId RPAREN
    <l:@L> "HINT_LPAREN" <id_l:@L> <id:HintId> <id_r:@R> "RPAREN"
        <r:@R> => {
        let id = crate::phrase! {
            node: id,
            span: context.span(id_l, id_r),
        };
        let exp = crate::phrase! {
            node: ExpKind::Seq(vec![]),
            span: id.span.clone(),
        };
        crate::phrase! {
            node: (id, exp),
            span: context.span(l, r),
        }
    },
};

Hints: Vec<Phrase<ast::Hint>> = {
    // Hints ::= Hint*
    <hints:Hint*> => hints,
};

TableBody: Vec<ast::TableRow> = {
    // TableBody ::= Bar BarList<TableRow>
    <_bar:Bar> <rows:BarList<TableRow>> => rows,
};

TableRow: ast::TableRow = {
    // TableRow ::= TablePattern DOUBLE_ARROW ExpBin
    <pattern:TablePattern> "DOUBLE_ARROW" <body:ExpBin> => {
        let span = Span::new(pattern.span.left.clone(), body.span.right.clone());
        crate::phrase! {
            node: (pattern, body),
            span: span,
        }
    },
};

// TablePattern ::= ExpSeq
TablePattern: ast::Exp = ExpSeq;

ExpSeq: ast::Exp = {
    // ExpSeq ::= ExpSeqStart ExpSeqTail*
    <first:ExpSeqStart> <rest:ExpSeqTail*> => {
        rest.into_iter().fold(first, |l, (fuse, r)| {
            let span = Span::new(l.span.left.clone(), r.span.right.clone());
            if fuse {
                crate::phrase! {
                    node: ExpKind::Fuse(Box::new(l), Box::new(r)),
                    span: span,
                }
            } else {
                let mut expressions = match l.node {
                    ExpKind::Seq(expressions) if expressions.len() >= 2 => expressions,
                    node => vec![crate::phrase! {
                        node: node,
                        span: l.span,
                    }],
                };
                expressions.push(r);
                crate::phrase! {
                    node: ExpKind::Seq(expressions),
                    span: span,
                }
            }
        })
    },
};

ExpSeqStart: ast::Exp = {
    // ExpSeqStart ::= ExpPost
    ExpPost,

    // ExpSeqStart ::= ExpListIter
    ExpListIter,
};

ExpSeqTail: (bool, ast::Exp) = {
    // ExpSeqTail ::= SEQ ExpPost
    "SEQ" <exp:ExpPost> => (false, exp),

    // ExpSeqTail ::= HASH ExpPost
    "HASH" <exp:ExpPost> => (true, exp),
};

RuleRule: ast::Rule = {
    // RuleRule ::= RULE RelId RuleIds COLON Exp PremList
    <l:@L> "RULE" <relid:RelId> <ruleids:RuleIds> "COLON" <exp:Exp>
        <premises:PremList> => {
            let groupid = if ruleids.node.is_empty() {
                String::new()
            } else {
                ruleids.node[1..].to_owned()
            };
            let groupid = crate::phrase! {
                node: groupid,
                span: ruleids.span,
            };
            let r = premises
                .last()
                .map(|premise| premise.span.right.clone())
                .unwrap_or_else(|| exp.span.right.clone());
            let premises = premises
                .into_iter()
                .filter_map(|premise| premise.node)
                .collect();
            crate::phrase! {
                node: (relid, groupid, exp, premises),
                span: Span::new(context.position(l), r),
            }
        },
};

RuleItem: Option<ast::Rule> = {
    // RuleItem ::= NL2
    "NL2" => None,

    // RuleItem ::= NL3
    "NL3" => None,

    // RuleItem ::= RuleRule
    <rule:RuleRule> => Some(rule),
};

Rules: Vec<ast::Rule> = {
    // Rules ::= RuleItem*
    <items:RuleItem*> => items.into_iter().flatten().collect(),
};

CallableDec: (
    ast::Id,
    Vec<ast::TParam>,
    Vec<ast::Param>,
    ast::PlainTyp,
    Vec<Phrase<ast::Hint>>,
) = {
    // CallableDec ::= DefId COLON PlainTyp Hints
    <id:DefId> "COLON" <plain_typ:PlainTyp> <hints:Hints> => {
        (id, vec![], vec![], plain_typ, hints)
    },

    // CallableDec ::= DefIdLParen EnterScope CommaList<Param> RPAREN COLON PlainTyp Hints ExitScope
    <id:DefIdLParen> <_enter:EnterScope> <params:CommaList<Param>> "RPAREN" "COLON"
        <plain_typ:PlainTyp> <hints:Hints> <_exit:ExitScope> => {
            (id, vec![], params, plain_typ, hints)
        },

    // CallableDec ::= DefIdLAngle EnterScope CommaList<TParam> RANGLE COLON PlainTyp Hints
    //     ExitScope
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE" "COLON"
        <plain_typ:PlainTyp> <hints:Hints> <_exit:ExitScope> => {
            (id, tparams, vec![], plain_typ, hints)
        },

    // CallableDec ::= DefIdLAngle EnterScope CommaList<TParam> RANGLE_LPAREN CommaList<Param>
    //     RPAREN COLON PlainTyp Hints ExitScope
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE_LPAREN"
        <params:CommaList<Param>> "RPAREN" "COLON" <plain_typ:PlainTyp> <hints:Hints>
        <_exit:ExitScope> => {
            (id, tparams, params, plain_typ, hints)
        },
};

TableDecSignature: (
    ast::Id,
    Vec<ast::Param>,
    ast::PlainTyp,
    Vec<Phrase<ast::Hint>>,
) = {
    // TableDecSignature ::= DefId COLON PlainTyp Hints
    <id:DefId> "COLON" <plain_typ:PlainTyp> <hints:Hints> => {
        (id, vec![], plain_typ, hints)
    },

    // TableDecSignature ::= DefIdLParen EnterScope CommaList<Param> RPAREN COLON PlainTyp Hints
    //     ExitScope
    <id:DefIdLParen> <_enter:EnterScope> <params:CommaList<Param>> "RPAREN" "COLON"
        <plain_typ:PlainTyp> <hints:Hints> <_exit:ExitScope> => {
            (id, params, plain_typ, hints)
        },
};

FunctionDefSignature: (
    ast::Id,
    Vec<ast::TParam>,
    Vec<ast::Arg>,
    ast::Exp,
    Vec<Phrase<Option<ast::Prem>>>,
) = {
    // FunctionDefSignature ::= DefId EQ Exp PremList
    <id:DefId> "EQ" <exp:Exp> <prems:PremList> => {
        (id, vec![], vec![], exp, prems)
    },

    // FunctionDefSignature ::= DefIdLParen EnterScope CommaList<Arg> RPAREN EQ Exp PremList
    //     ExitScope
    <id:DefIdLParen> <_enter:EnterScope> <args:CommaList<Arg>> "RPAREN" "EQ"
        <exp:Exp> <prems:PremList> <_exit:ExitScope> => {
            (id, vec![], args, exp, prems)
        },

    // FunctionDefSignature ::= DefIdLAngle EnterScope CommaList<TParam> RANGLE EQ Exp PremList
    //     ExitScope
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE" "EQ"
        <exp:Exp> <prems:PremList> <_exit:ExitScope> => {
            (id, tparams, vec![], exp, prems)
        },

    // FunctionDefSignature ::= DefIdLAngle EnterScope CommaList<TParam> RANGLE_LPAREN
    //     CommaList<Arg> RPAREN EQ Exp PremList ExitScope
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE_LPAREN"
        <args:CommaList<Arg>> "RPAREN" "EQ" <exp:Exp> <prems:PremList>
        <_exit:ExitScope> => {
            (id, tparams, args, exp, prems)
        },
};
