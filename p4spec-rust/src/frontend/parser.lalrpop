// Bar ::= BAR | NL_BAR
Bar: () = {
    "BAR" => (),
    "NL_BAR" => (),
};

// BarList<T> ::= Separated<T, Bar>
BarList<T>: Vec<T> = Separated<T, Bar>;

// Exp ::= ExpPost | ExpListIter
//   | Exp SEQ Exp | Exp HASH Exp
//   | BAR Exp BAR | UnaryOperator Exp | InfixOperator Exp
//   | Exp StarOperator Exp | Exp SLASH Exp | Exp BACKSLASH Exp
//   | Exp PLUS Exp | Exp MINUS Exp | Exp PLUS2 Exp
//   | Exp DotOperator Exp | Exp SemicolonOperator Exp
//   | Exp ArrowTypOperator Exp | Exp COLON2 Exp
//   | Exp EQ Exp | Exp NEQ Exp | Exp LANGLE_DASH Exp
//   | Exp SUB PlainTyp | Exp ColonTypOperator Exp
//   | Exp SquigglyOperator Exp | Exp TilesturnOperator Exp
//   | Exp TurnstileOperator Exp | Exp AND Exp | Exp OR Exp
//   | Exp DOUBLE_ARROW Exp | Exp DOUBLE_ARROW_BOTH Exp
//   | Exp DoubleArrowTypOperator Exp | RelationOperator Exp
Exp: ast::Exp = {
    #[precedence(level="0")]
    ExpPost,
    ExpListIter,

    #[precedence(level="2")]
    #[assoc(side="left")]
    <left:Exp> "SEQ" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        let mut expressions = match left.node {
            ExpKind::Seq(expressions) if expressions.len() >= 2 => expressions,
            node => vec![crate::phrase! {
                node: node,
                span: left.span,
            }],
        };
        expressions.push(right);
        crate::phrase! {
            node: ExpKind::Seq(expressions),
            span: span,
        }
    },
    <left:Exp> "HASH" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Fuse(Box::new(left), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="3")]
    <left:@L> "BAR" <exp:Exp> "BAR" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Len(Box::new(exp)),
            span: context.span(left, right),
        }
    },
    <left:@L> <operator:UnaryOperator> <exp:Exp> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Un(operator, Box::new(exp)),
            span: context.span(left, right),
        }
    },
    <operator:InfixOperator> <right:Exp> => {
        let span = Span::new(operator.span.left.clone(), right.span.right.clone());
        let left = crate::phrase! {
            node: ExpKind::Seq(vec![]),
            span: operator.span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="4")]
    #[assoc(side="left")]
    <left:Exp> <_operator:StarOperator> <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mul), Box::new(right)),
            span: span,
        }
    },
    <left:Exp> "SLASH" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Div), Box::new(right)),
            span: span,
        }
    },
    <left:Exp> "BACKSLASH" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mod), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="5")]
    #[assoc(side="left")]
    <left:Exp> "PLUS" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Add), Box::new(right)),
            span: span,
        }
    },
    <left:Exp> "MINUS" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Sub), Box::new(right)),
            span: span,
        }
    },
    <left:Exp> "PLUS2" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cat(Box::new(left), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="6")]
    #[assoc(side="left")]
    <left:Exp> <operator:DotOperator> <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="7")]
    #[assoc(side="left")]
    <left:Exp> <operator:SemicolonOperator> <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="8")]
    #[assoc(side="right")]
    <left:Exp> <operator:ArrowTypOperator> <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="9")]
    #[assoc(side="right")]
    <head:Exp> "COLON2" <tail:Exp> => {
        let span = Span::new(head.span.left.clone(), tail.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cons(Box::new(head), Box::new(tail)),
            span: span,
        }
    },

    #[precedence(level="10")]
    #[assoc(side="right")]
    <left:Exp> "EQ" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cmp(Box::new(left), CmpOp::Bool(xl::bool::CmpOp::Eq), Box::new(right)),
            span: span,
        }
    },
    <left:Exp> "NEQ" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cmp(Box::new(left), CmpOp::Bool(xl::bool::CmpOp::Ne), Box::new(right)),
            span: span,
        }
    },
    <left:Exp> "LANGLE_DASH" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Mem(Box::new(left), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="11")]
    #[assoc(side="left")]
    <left:Exp> "SUB" <plain_typ:PlainTyp> => {
        let span = Span::new(left.span.left.clone(), plain_typ.span.right.clone());
        crate::phrase! {
            node: ExpKind::Sub(Box::new(left), plain_typ),
            span: span,
        }
    },
    <left:Exp> <operator:ColonTypOperator> <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="12")]
    #[assoc(side="right")]
    <left:Exp> <operator:SquigglyOperator> <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="13")]
    #[assoc(side="none")]
    <left:Exp> <operator:TilesturnOperator> <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="14")]
    #[assoc(side="none")]
    <left:Exp> <operator:TurnstileOperator> <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="15")]
    #[assoc(side="left")]
    <left:Exp> "AND" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::And), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="16")]
    #[assoc(side="left")]
    <left:Exp> "OR" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Or), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="17")]
    #[assoc(side="right")]
    <left:Exp> "DOUBLE_ARROW" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Impl), Box::new(right)),
            span: span,
        }
    },
    <left:Exp> "DOUBLE_ARROW_BOTH" <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Equiv), Box::new(right)),
            span: span,
        }
    },
    <left:Exp> <operator:DoubleArrowTypOperator> <right:Exp> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="18")]
    #[assoc(side="right")]
    <operator:RelationOperator> <right:Exp> => {
        let span = Span::new(operator.span.left.clone(), right.span.right.clone());
        let left = crate::phrase! {
            node: ExpKind::Seq(vec![]),
            span: operator.span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },
};

// Menhir deliberately uses `exp_bin` (rather than `exp`) at collection,
// argument, and table-body boundaries.  This parallel precedence grammar
// excludes the relation operators while retaining all ordinary expression
// operators and the full-expression escape hatches inside postfix forms.
// ExpBin ::= ExpPost | ExpListIter
//   | ExpBin SEQ ExpBin | ExpBin HASH ExpBin
//   | BAR Exp BAR | UnaryOperator ExpBin | InfixOperator ExpBin
//   | ExpBin StarOperator ExpBin | ExpBin SLASH ExpBin
//   | ExpBin BACKSLASH ExpBin | ExpBin PLUS ExpBin
//   | ExpBin MINUS ExpBin | ExpBin PLUS2 ExpBin
//   | ExpBin DotOperator ExpBin | ExpBin SemicolonOperator ExpBin
//   | ExpBin ArrowTypOperator ExpBin | ExpBin COLON2 ExpBin
//   | ExpBin EQ ExpBin | ExpBin NEQ ExpBin
//   | ExpBin LANGLE_DASH ExpBin | ExpBin SUB PlainTyp
//   | ExpBin AND ExpBin | ExpBin OR ExpBin
//   | ExpBin DOUBLE_ARROW ExpBin | ExpBin DOUBLE_ARROW_BOTH ExpBin
//   | ExpBin DoubleArrowTypOperator ExpBin
ExpBin: ast::Exp = {
    #[precedence(level="0")]
    ExpPost,
    ExpListIter,

    #[precedence(level="2")]
    #[assoc(side="left")]
    <left:ExpBin> "SEQ" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        let mut expressions = match left.node {
            ExpKind::Seq(expressions) if expressions.len() >= 2 => expressions,
            node => vec![crate::phrase! {
                node: node,
                span: left.span,
            }],
        };
        expressions.push(right);
        crate::phrase! {
            node: ExpKind::Seq(expressions),
            span: span,
        }
    },
    <left:ExpBin> "HASH" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Fuse(Box::new(left), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="3")]
    <left:@L> "BAR" <exp:Exp> "BAR" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Len(Box::new(exp)),
            span: context.span(left, right),
        }
    },
    <left:@L> <operator:UnaryOperator> <exp:ExpBin> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Un(operator, Box::new(exp)),
            span: context.span(left, right),
        }
    },
    <operator:InfixOperator> <right:ExpBin> => {
        let span = Span::new(operator.span.left.clone(), right.span.right.clone());
        let left = crate::phrase! {
            node: ExpKind::Seq(vec![]),
            span: operator.span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="4")]
    #[assoc(side="left")]
    <left:ExpBin> <_operator:StarOperator> <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mul), Box::new(right)),
            span: span,
        }
    },
    <left:ExpBin> "SLASH" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Div), Box::new(right)),
            span: span,
        }
    },
    <left:ExpBin> "BACKSLASH" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mod), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="5")]
    #[assoc(side="left")]
    <left:ExpBin> "PLUS" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Add), Box::new(right)),
            span: span,
        }
    },
    <left:ExpBin> "MINUS" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Sub), Box::new(right)),
            span: span,
        }
    },
    <left:ExpBin> "PLUS2" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cat(Box::new(left), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="6")]
    #[assoc(side="left")]
    <left:ExpBin> <operator:DotOperator> <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="7")]
    #[assoc(side="left")]
    <left:ExpBin> <operator:SemicolonOperator> <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="8")]
    #[assoc(side="right")]
    <left:ExpBin> <operator:ArrowTypOperator> <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="9")]
    #[assoc(side="right")]
    <head:ExpBin> "COLON2" <tail:ExpBin> => {
        let span = Span::new(head.span.left.clone(), tail.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cons(Box::new(head), Box::new(tail)),
            span: span,
        }
    },

    #[precedence(level="10")]
    #[assoc(side="right")]
    <left:ExpBin> "EQ" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cmp(Box::new(left), CmpOp::Bool(xl::bool::CmpOp::Eq), Box::new(right)),
            span: span,
        }
    },
    <left:ExpBin> "NEQ" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cmp(Box::new(left), CmpOp::Bool(xl::bool::CmpOp::Ne), Box::new(right)),
            span: span,
        }
    },
    <left:ExpBin> "LANGLE_DASH" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Mem(Box::new(left), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="11")]
    #[assoc(side="left")]
    <left:ExpBin> "SUB" <plain_typ:PlainTyp> => {
        let span = Span::new(left.span.left.clone(), plain_typ.span.right.clone());
        crate::phrase! {
            node: ExpKind::Sub(Box::new(left), plain_typ),
            span: span,
        }
    },

    #[precedence(level="15")]
    #[assoc(side="left")]
    <left:ExpBin> "AND" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::And), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="16")]
    #[assoc(side="left")]
    <left:ExpBin> "OR" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Or), Box::new(right)),
            span: span,
        }
    },

    #[precedence(level="17")]
    #[assoc(side="right")]
    <left:ExpBin> "DOUBLE_ARROW" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Impl), Box::new(right)),
            span: span,
        }
    },
    <left:ExpBin> "DOUBLE_ARROW_BOTH" <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Equiv), Box::new(right)),
            span: span,
        }
    },
    <left:ExpBin> <operator:DoubleArrowTypOperator> <right:ExpBin> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },
};

// ExpListBase ::= LBRACK CommaList<ExpBin> RBRACK
ExpListBase: ast::Exp = {
    <left:@L> "LBRACK" <expressions:CommaList<ExpBin>> "RBRACK" <right:@R> => {
        crate::phrase! {
            node: ExpKind::List(expressions),
            span: context.span(left, right),
        }
    },
};

// ExpListIter ::= ExpListBase QuestionIterAt*
ExpListIter: ast::Exp = {
    <left:@L> <base:ExpListBase> <iterations:QuestionIterAt*> => {
        iterations.into_iter().fold(base, |exp, (iter, right)| {
            crate::phrase! {
                node: ExpKind::Iter(Box::new(exp), iter),
                span: context.span(left, right),
            }
        })
    },
};

// UnaryOperator ::= TILDE | PLUS | MINUS
UnaryOperator: UnOp = {
    "TILDE" => UnOp::Bool(xl::bool::UnOp::Not),
    "PLUS" => UnOp::Num(num::UnOp::Plus),
    "MINUS" => UnOp::Num(num::UnOp::Minus),
};

// `ParserTokens` inserts `SEQ` after a binary `*` when its right operand can
// also begin a notation sequence. Consuming it here leaves the same token as a
// real sequence separator after a postfix type iteration.
// StarOperator ::= STAR SEQ | STAR
StarOperator: () = {
    "STAR" "SEQ" => (),
    "STAR" => (),
};

// QuestionIter ::= QUEST | ITER_STAR
QuestionIter: Iter = {
    "QUEST" => Iter::Opt,
    "ITER_STAR" => Iter::List,
};

// QuestionIterAt ::= QuestionIter
QuestionIterAt: (Iter, Loc) = {
    <iter:QuestionIter> <right:@R> => (iter, right),
};

// ExpAtomBase ::= ExpPrimary | AtomRule
//   | AtomIdLParen Exp RPAREN
ExpAtomBase: ast::Exp = {
    ExpPrimary,
    <atom:AtomRule> => {
        let span = atom.span.clone();
        crate::phrase! {
            node: ExpKind::Atom(atom),
            span: span,
        }
    },
    <left:@L> <id:AtomIdLParen> <id_right:@R> <exp:Exp> "RPAREN" <right:@R> => {
        let atom = crate::phrase! {
            node: Atom::Keyword(id),
            span: context.span(left, id_right),
        };
        let atom_span = atom.span.clone();
        let atom_exp = crate::phrase! {
            node: ExpKind::Atom(atom),
            span: atom_span,
        };
        let paren_span = exp.span.clone();
        let paren_exp = crate::phrase! {
            node: ExpKind::Paren(Box::new(exp)),
            span: paren_span,
        };
        crate::phrase! {
            node: ExpKind::Seq(vec![atom_exp, paren_exp]),
            span: context.span(left, right),
        }
    },
};

// A postfix-only expression is used where whitespace-separated atoms form a
// record field or table pattern.  Keeping it separate from `Exp` prevents the
// separator from absorbing binary and relation operators.
// ExpPost ::= ExpAtomBase
//   | ExpPost LBRACK Arith RBRACK
//   | ExpPost LBRACK Arith COLON Arith RBRACK
//   | ExpPost UpdatePath EQ Exp RBRACK
//   | ExpPost QuestionIter
//   | ExpPost DotId
ExpPost: ast::Exp = {
    ExpAtomBase,
    <left:@L> <base:ExpPost> "LBRACK" <index:Arith> "RBRACK" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Idx(Box::new(base), Box::new(index)),
            span: context.span(left, right),
        }
    },
    <left:@L> <base:ExpPost> "LBRACK" <start:Arith> "COLON" <end:Arith>
        "RBRACK" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Slice(Box::new(base), Box::new(start), Box::new(end)),
            span: context.span(left, right),
        }
    },
    <left:@L> <base:ExpPost> <path:UpdatePath> "EQ" <value:Exp> "RBRACK"
        <right:@R> => {
        crate::phrase! {
            node: ExpKind::Upd(Box::new(base), path, Box::new(value)),
            span: context.span(left, right),
        }
    },
    <left:@L> <base:ExpPost> <iter:QuestionIter> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Iter(Box::new(base), iter),
            span: context.span(left, right),
        }
    },
    <left:@L> <base:ExpPost> <field:DotId> <right:@R> => {
        match (base.node, field.node) {
            (ExpKind::Atom(atom), Atom::Keyword(suffix)) => match atom.node {
                Atom::Keyword(prefix) => {
                    let span = context.span(left, right);
                    let atom = crate::phrase! {
                        node: Atom::Keyword(format!("{prefix}.{suffix}")),
                        span: span.clone(),
                    };
                    crate::phrase! {
                        node: ExpKind::Atom(atom),
                        span: span,
                    }
                }
                node => crate::phrase! {
                    node: ExpKind::Dot(
                        Box::new(crate::phrase! {
                            node: ExpKind::Atom(crate::phrase! {
                                node: node,
                                span: atom.span,
                            }),
                            span: base.span,
                        }),
                        crate::phrase! {
                            node: Atom::Keyword(suffix),
                            span: field.span,
                        },
                    ),
                    span: context.span(left, right),
                },
            },
            (node, field_node) => crate::phrase! {
                node: ExpKind::Dot(
                    Box::new(crate::phrase! {
                        node: node,
                        span: base.span,
                    }),
                    crate::phrase! {
                        node: field_node,
                        span: field.span,
                    },
                ),
                span: context.span(left, right),
            },
        }
    },
};

// ExpPrimary ::= ExpLiteral | ExpVariable | ExpCall | ExpHole | EPS
//   | LBRACE CommaList<FieldExp> RBRACE
//   | LPAREN CommaList<ExpBin> RPAREN
//   | TickLAngle Exp TickRAngle
//   | TickLParen Exp TickRParen
//   | TickLBrack Exp TickRBrack
//   | TickLBrace Exp TickRBrace
//   | DOLLAR LPAREN Arith RPAREN
//   | HASH2 ExpPrimary
ExpPrimary: ast::Exp = {
    ExpLiteral,
    ExpVariable,
    ExpCall,
    ExpHole,
    <left:@L> "EPS" <right:@R> => crate::phrase! {
        node: ExpKind::Eps,
        span: context.span(left, right),
    },
    <left:@L> "LBRACE" <fields:CommaList<FieldExp>> "RBRACE" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Str(fields),
            span: context.span(left, right),
        }
    },
    <left:@L> "LPAREN" <expressions:CommaList<ExpBin>> "RPAREN" <right:@R> => {
        let kind = match expressions.as_slice() {
            [] => ExpKind::Paren(Box::new(crate::phrase! {
                node: ExpKind::Tuple(vec![]),
                span: context.span(left, right),
            })),
            [exp] => ExpKind::Paren(Box::new(exp.clone())),
            _ => ExpKind::Tuple(expressions),
        };
        crate::phrase! {
            node: kind,
            span: context.span(left, right),
        }
    },
    <left:TickLAngle> <exp:Exp> <right:TickRAngle> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Brack(left, Box::new(exp), right),
            span: span,
        }
    },
    <left:TickLParen> <exp:Exp> <right:TickRParen> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Brack(left, Box::new(exp), right),
            span: span,
        }
    },
    <left:TickLBrack> <exp:Exp> <right:TickRBrack> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Brack(left, Box::new(exp), right),
            span: span,
        }
    },
    <left:TickLBrace> <exp:Exp> <right:TickRBrace> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Brack(left, Box::new(exp), right),
            span: span,
        }
    },
    <left:@L> "DOLLAR" "LPAREN" <arith:Arith> "RPAREN" <right:@R> => {
        crate::phrase! {
            node: arith.node,
            span: context.span(left, right),
        }
    },
    <left:@L> "HASH2" <exp:ExpPrimary> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Unparen(Box::new(exp)),
            span: context.span(left, right),
        }
    },
};

// ExpLiteral ::= BOOLLIT | NATLIT | HEXLIT | TEXTLIT
ExpLiteral: ast::Exp = {
    <left:@L> <value:"BOOLLIT"> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Bool(value),
            span: context.span(left, right),
        }
    },
    <left:@L> <value:"NATLIT"> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Num(NumOp::Dec, num::Number::Nat(value)),
            span: context.span(left, right),
        }
    },
    <left:@L> <value:"HEXLIT"> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Num(NumOp::Hex, num::Number::Nat(value)),
            span: context.span(left, right),
        }
    },
    <left:@L> <text:"TEXTLIT"> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Text(text),
            span: context.span(left, right),
        }
    },
};

// ExpVariable ::= VarId | BOOL | NAT | INT | TEXT
ExpVariable: ast::Exp = {
    <id:VarId> => {
        let span = id.span.clone();
        crate::phrase! {
            node: ExpKind::Var(id),
            span: span,
        }
    },
    <left:@L> "BOOL" <right:@R> => {
        let span = context.span(left, right);
        let id = crate::phrase! {
            node: "bool".to_owned(),
            span: span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Var(id),
            span: span,
        }
    },
    <left:@L> "NAT" <right:@R> => {
        let span = context.span(left, right);
        let id = crate::phrase! {
            node: "nat".to_owned(),
            span: span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Var(id),
            span: span,
        }
    },
    <left:@L> "INT" <right:@R> => {
        let span = context.span(left, right);
        let id = crate::phrase! {
            node: "int".to_owned(),
            span: span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Var(id),
            span: span,
        }
    },
    <left:@L> "TEXT" <right:@R> => {
        let span = context.span(left, right);
        let id = crate::phrase! {
            node: "text".to_owned(),
            span: span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Var(id),
            span: span,
        }
    },
};

// ExpCall ::= DOLLAR DefId
//   | DOLLAR DefIdLParen CommaList<Arg> RPAREN
//   | DOLLAR DefIdLAngle CommaList<Targ> RANGLE
//   | DOLLAR DefIdLAngle CommaList<Targ> RANGLE_LPAREN
//       CommaList<Arg> RPAREN
ExpCall: ast::Exp = {
    <left:@L> "DOLLAR" <id:DefId> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Call(id, vec![], vec![]),
            span: context.span(left, right),
        }
    },
    <left:@L> "DOLLAR" <id:DefIdLParen> <args:CommaList<Arg>> "RPAREN" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Call(id, vec![], args),
            span: context.span(left, right),
        }
    },
    <left:@L> "DOLLAR" <id:DefIdLAngle> <targs:CommaList<Targ>> "RANGLE" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Call(id, targs, vec![]),
            span: context.span(left, right),
        }
    },
    <left:@L> "DOLLAR" <id:DefIdLAngle> <targs:CommaList<Targ>> "RANGLE_LPAREN"
        <args:CommaList<Arg>> "RPAREN" <right:@R> => {
            crate::phrase! {
                node: ExpKind::Call(id, targs, args),
                span: context.span(left, right),
            }
        },
};

// ExpHole ::= HOLE_NUM | HOLE | HOLE_MULTI | HOLE_NIL
//   | LATEX LPAREN TEXTLIT* RPAREN
ExpHole: ast::Exp = {
    <left:@L> <number:"HOLE_NUM"> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Hole(Hole::Num(number)),
            span: context.span(left, right),
        }
    },
    <left:@L> "HOLE" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Hole(Hole::Next),
            span: context.span(left, right),
        }
    },
    <left:@L> "HOLE_MULTI" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Hole(Hole::Rest),
            span: context.span(left, right),
        }
    },
    <left:@L> "HOLE_NIL" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Hole(Hole::None),
            span: context.span(left, right),
        }
    },
    <left:@L> "LATEX" "LPAREN" <parts:"TEXTLIT"*> "RPAREN" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Latex(parts.join(" ")),
            span: context.span(left, right),
        }
    },
};

// FieldExp ::= FieldId SEQ ExpPost (SEQ ExpPost)*
FieldExp: (ast::Atom, ast::Exp) = {
    <field:FieldId> "SEQ" <first:ExpPost> <rest:("SEQ" <ExpPost>)*> => {
        let mut expressions = Vec::with_capacity(rest.len() + 1);
        expressions.push(first);
        expressions.extend(rest);
        let exp = if expressions.len() == 1 {
            expressions.into_iter().next().expect("one expression")
        } else {
            let span = Span::new(
                expressions
                    .first()
                    .expect("nonempty expressions")
                    .span
                    .left
                    .clone(),
                expressions
                    .last()
                    .expect("nonempty expressions")
                    .span
                    .right
                    .clone(),
            );
            crate::phrase! {
                node: ExpKind::Seq(expressions),
                span: span,
            }
        };
        (field, exp)
    },
};

// Arg ::= EnterExp ExpBin ExitMode | DEF DOLLAR DefId
Arg: ast::Arg = {
    <left:@L> <_enter:EnterExp> <exp:ExpBin> <right:@R> <_exit:ExitMode> => {
        crate::phrase! {
            node: ArgKind::Exp(Box::new(exp)),
            span: context.span(left, right),
        }
    },
    <left:@L> "DEF" "DOLLAR" <id:DefId> <right:@R> => {
        crate::phrase! {
            node: ArgKind::Def(id),
            span: context.span(left, right),
        }
    },
};

// Arith ::= EnterArith ArithDoubleArrow ExitMode
Arith: ast::Exp = {
    <_enter:EnterArith> <arith:ArithDoubleArrow> <_exit:ExitMode> => arith,
};

// ArithDoubleArrow ::= ArithOr DOUBLE_ARROW ArithDoubleArrow
//   | ArithOr DOUBLE_ARROW_BOTH ArithDoubleArrow
//   | ArithOr
ArithDoubleArrow: ast::Exp = {
    <left:ArithOr> "DOUBLE_ARROW" <right:ArithDoubleArrow> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Impl), Box::new(right)),
            span: span,
        }
    },
    <left:ArithOr> "DOUBLE_ARROW_BOTH" <right:ArithDoubleArrow> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Equiv), Box::new(right)),
            span: span,
        }
    },
    ArithOr,
};

// ArithOr ::= ArithOr OR ArithAnd | ArithAnd
ArithOr: ast::Exp = {
    <left:ArithOr> "OR" <right:ArithAnd> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Or), Box::new(right)),
            span: span,
        }
    },
    ArithAnd,
};

// ArithAnd ::= ArithAnd AND ArithComparison | ArithComparison
ArithAnd: ast::Exp = {
    <left:ArithAnd> "AND" <right:ArithComparison> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::And), Box::new(right)),
            span: span,
        }
    },
    ArithComparison,
};

// ArithComparison ::= ArithAdd ArithCompareOperator ArithComparison
//   | ArithAdd LANGLE_DASH ArithComparison
//   | ArithAdd
ArithComparison: ast::Exp = {
    <left:ArithAdd> <operator:ArithCompareOperator> <right:ArithComparison> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cmp(Box::new(left), operator, Box::new(right)),
            span: span,
        }
    },
    <left:ArithAdd> "LANGLE_DASH" <right:ArithComparison> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Mem(Box::new(left), Box::new(right)),
            span: span,
        }
    },
    ArithAdd,
};

// ArithCompareOperator ::= EQ | NEQ | LANGLE | RANGLE
//   | LANGLE_EQ | RANGLE_EQ
ArithCompareOperator: CmpOp = {
    "EQ" => CmpOp::Bool(xl::bool::CmpOp::Eq),
    "NEQ" => CmpOp::Bool(xl::bool::CmpOp::Ne),
    "LANGLE" => CmpOp::Num(num::CmpOp::Lt),
    "RANGLE" => CmpOp::Num(num::CmpOp::Gt),
    "LANGLE_EQ" => CmpOp::Num(num::CmpOp::Le),
    "RANGLE_EQ" => CmpOp::Num(num::CmpOp::Ge),
};

// ArithAdd ::= ArithAdd PLUS ArithMul
//   | ArithAdd MINUS ArithMul
//   | ArithAdd PLUS2 ArithMul
//   | ArithMul
ArithAdd: ast::Exp = {
    <left:ArithAdd> "PLUS" <right:ArithMul> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Add), Box::new(right)),
            span: span,
        }
    },
    <left:ArithAdd> "MINUS" <right:ArithMul> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Sub), Box::new(right)),
            span: span,
        }
    },
    <left:ArithAdd> "PLUS2" <right:ArithMul> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cat(Box::new(left), Box::new(right)),
            span: span,
        }
    },
    ArithMul,
};

// ArithMul ::= ArithMul StarOperator ArithUnary
//   | ArithMul SLASH ArithUnary
//   | ArithMul BACKSLASH ArithUnary
//   | ArithUnary
ArithMul: ast::Exp = {
    <left:ArithMul> <_operator:StarOperator> <right:ArithUnary> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mul), Box::new(right)),
            span: span,
        }
    },
    <left:ArithMul> "SLASH" <right:ArithUnary> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Div), Box::new(right)),
            span: span,
        }
    },
    <left:ArithMul> "BACKSLASH" <right:ArithUnary> => {
        let span = Span::new(left.span.left.clone(), right.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mod), Box::new(right)),
            span: span,
        }
    },
    ArithUnary,
};

// ArithUnary ::= BAR EnterExp Exp BAR ExitMode
//   | UnaryOperator ArithUnary
//   | ArithPost
ArithUnary: ast::Exp = {
    <left:@L> "BAR" <_enter:EnterExp> <exp:Exp> "BAR" <right:@R> <_exit:ExitMode> => {
        crate::phrase! {
            node: ExpKind::Len(Box::new(exp)),
            span: context.span(left, right),
        }
    },
    <left:@L> <operator:UnaryOperator> <exp:ArithUnary> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Un(operator, Box::new(exp)),
            span: context.span(left, right),
        }
    },
    ArithPost,
};

// ArithPost ::= ArithAtomBase
//   | ArithPost UP ArithAtomBase
//   | ArithPost LBRACK Arith RBRACK
//   | ArithPost DotId
ArithPost: ast::Exp = {
    ArithAtomBase,
    <left:@L> <base:ArithPost> "UP" <exponent:ArithAtomBase> <right:@R> => {
        crate::phrase! {
            node: ExpKind::Bin(
                Box::new(base),
                BinOp::Num(num::BinOp::Pow),
                Box::new(exponent),
            ),
            span: context.span(left, right),
        }
    },
    <left:@L> <base:ArithPost> "LBRACK" <index:Arith> "RBRACK" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Idx(Box::new(base), Box::new(index)),
            span: context.span(left, right),
        }
    },
    <left:@L> <base:ArithPost> <field:DotId> <right:@R> => {
        match (base.node, field.node) {
            (ExpKind::Atom(atom), Atom::Keyword(suffix)) => match atom.node {
                Atom::Keyword(prefix) => {
                    let span = context.span(left, right);
                    let atom = crate::phrase! {
                        node: Atom::Keyword(format!("{prefix}.{suffix}")),
                        span: span.clone(),
                    };
                    crate::phrase! {
                        node: ExpKind::Atom(atom),
                        span: span,
                    }
                }
                node => crate::phrase! {
                    node: ExpKind::Dot(
                        Box::new(crate::phrase! {
                            node: ExpKind::Atom(crate::phrase! {
                                node: node,
                                span: atom.span,
                            }),
                            span: base.span,
                        }),
                        crate::phrase! {
                            node: Atom::Keyword(suffix),
                            span: field.span,
                        },
                    ),
                    span: context.span(left, right),
                },
            },
            (node, field_node) => crate::phrase! {
                node: ExpKind::Dot(
                    Box::new(crate::phrase! {
                        node: node,
                        span: base.span,
                    }),
                    crate::phrase! {
                        node: field_node,
                        span: field.span,
                    },
                ),
                span: context.span(left, right),
            },
        }
    },
};

// ArithAtomBase ::= ExpLiteral | ExpVariable | ExpCall | ExpHole
//   | LPAREN Arith RPAREN
//   | DOLLAR LPAREN EnterExp Exp RPAREN ExitMode
//   | AtomRule
ArithAtomBase: ast::Exp = {
    ExpLiteral,
    ExpVariable,
    ExpCall,
    ExpHole,
    <left:@L> "LPAREN" <arith:Arith> "RPAREN" <right:@R> => {
        crate::phrase! {
            node: ExpKind::Paren(Box::new(arith)),
            span: context.span(left, right),
        }
    },
    <left:@L> "DOLLAR" "LPAREN" <_enter:EnterExp> <exp:Exp> "RPAREN" <right:@R>
        <_exit:ExitMode> => {
        crate::phrase! {
            node: exp.node,
            span: context.span(left, right),
        }
    },
    <atom:AtomRule> => {
        let span = atom.span.clone();
        crate::phrase! {
            node: ExpKind::Atom(atom),
            span: span,
        }
    },
};

// UpdatePath ::= LBRACK
//   | UpdatePath LBRACK Arith RBRACK
//   | UpdatePath LBRACK Arith COLON Arith RBRACK
//   | UpdatePath DotId
UpdatePath: ast::Path = {
    "LBRACK" <right:@R> => crate::phrase! {
        node: PathKind::Root,
        span: context.span(right, right),
    },
    <path:UpdatePath> "LBRACK" <index:Arith> "RBRACK" <right:@R> => {
        let left = path.span.left.clone();
        crate::phrase! {
            node: PathKind::Idx(Box::new(path), Box::new(index)),
            span: Span::new(left, context.position(right)),
        }
    },
    <path:UpdatePath> "LBRACK" <start:Arith> "COLON" <end:Arith> "RBRACK"
        <right:@R> => {
        let left = path.span.left.clone();
        crate::phrase! {
            node: PathKind::Slice(Box::new(path), Box::new(start), Box::new(end)),
            span: Span::new(left, context.position(right)),
        }
    },
    <path:UpdatePath> <field:DotId> <right:@R> => {
        let left = path.span.left.clone();
        crate::phrase! {
            node: PathKind::Dot(Box::new(path), field),
            span: Span::new(left, context.position(right)),
        }
    },
};

// Param ::= ParamKindRule
Param: ast::Param = {
    <left:@L> <kind:ParamKindRule> <right:@R> => crate::phrase! {
        node: kind,
        span: context.span(left, right),
    },
};

// ParamKindRule ::= PlainTyp
//   | DEF DOLLAR DefId COLON PlainTyp
//   | DEF DOLLAR DefIdLParen EnterScope CommaList<Param> RPAREN
//       COLON PlainTyp ExitScope
//   | DEF DOLLAR DefIdLAngle EnterScope CommaList<TParam> RANGLE
//       COLON PlainTyp ExitScope
//   | DEF DOLLAR DefIdLAngle EnterScope CommaList<TParam>
//       RANGLE_LPAREN CommaList<Param> RPAREN COLON PlainTyp ExitScope
ParamKindRule: ParamKind = {
    <plain_typ:PlainTyp> => ParamKind::Exp(plain_typ),
    "DEF" "DOLLAR" <id:DefId> "COLON" <plain_typ:PlainTyp> => {
        ParamKind::Def(id, vec![], vec![], plain_typ)
    },
    "DEF" "DOLLAR" <id:DefIdLParen> <_enter:EnterScope> <params:CommaList<Param>>
        "RPAREN" "COLON" <plain_typ:PlainTyp> <_exit:ExitScope> => {
            ParamKind::Def(id, vec![], params, plain_typ)
        },
    "DEF" "DOLLAR" <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>>
        "RANGLE" "COLON" <plain_typ:PlainTyp> <_exit:ExitScope> => {
            ParamKind::Def(id, tparams, vec![], plain_typ)
        },
    "DEF" "DOLLAR" <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>>
        "RANGLE_LPAREN" <params:CommaList<Param>> "RPAREN" "COLON" <plain_typ:PlainTyp>
        <_exit:ExitScope> => ParamKind::Def(id, tparams, params, plain_typ),
};

// PremList ::= EnterScope PremEntry* ExitScope
PremList: Vec<Phrase<Option<ast::Prem>>> = {
    <_enter:EnterScope> <entries:PremEntry*> <_exit:ExitScope> => entries,
};

// PremEntry ::= DASH DASH | DASH Prem
PremEntry: Phrase<Option<ast::Prem>> = {
    <left:@L> "DASH" "DASH" <right:@R> => crate::phrase! {
        node: None,
        span: context.span(left, right),
    },
    <left:@L> "DASH" <premise:Prem> <right:@R> => crate::phrase! {
        node: Some(premise),
        span: context.span(left, right),
    },
};

// Prem ::= PremKindRule
Prem: ast::Prem = {
    <left:@L> <kind:PremKindRule> <right:@R> => crate::phrase! {
        node: kind,
        span: context.span(left, right),
    },
};

// PremKindRule ::= OTHERWISE
//   | LPAREN Prem RPAREN IterRule*
//   | RelId COLON Exp
//   | RelId COLON_SLASH Exp
//   | VAR VarIdBind COLON PlainTyp
//   | IF Exp
//   | DEBUG Exp
PremKindRule: PremKind = {
    "OTHERWISE" => PremKind::Else,
    <left:@L> "LPAREN" <premise:Prem> "RPAREN" <iterations:IterRule*> <right:@R> => {
        let mut premise = premise;
        for iter in iterations {
            premise = crate::phrase! {
                node: PremKind::Iter(IterPrem {
                    prem: Box::new(premise),
                    iter,
                }),
                span: context.span(left, right),
            };
        }
        premise.node
    },
    <id:RelId> "COLON" <exp:Exp> => PremKind::Rule(RulePrem { id, exp }),
    <id:RelId> "COLON_SLASH" <exp:Exp> => PremKind::RuleNot(RuleNotPrem { id, exp }),
    "VAR" <id:VarIdBind> "COLON" <plain_typ:PlainTyp> => {
        PremKind::Var(VarPrem { id, plain_typ })
    },
    "IF" <exp:Exp> => {
        fn from_exp(exp: ast::Exp) -> PremKind {
            match exp.node {
                ExpKind::Iter(exp, iter) => {
                    let span = exp.span.clone();
                    PremKind::Iter(IterPrem {
                        prem: Box::new(crate::phrase! {
                            node: from_exp(*exp),
                            span: span,
                        }),
                        iter,
                    })
                }
                node => PremKind::If(IfPrem {
                    exp: crate::phrase! {
                        node: node,
                        span: exp.span,
                    },
                }),
            }
        }
        from_exp(exp)
    },
    "DEBUG" <exp:Exp> => PremKind::Debug(DebugPrem { exp }),
};

// Hint ::= HINT_LPAREN HintId SEQ Exp RPAREN
//   | HINT_LPAREN HintId RPAREN
Hint: Phrase<ast::Hint> = {
    <left:@L> "HINT_LPAREN" <id_left:@L> <id:HintId> <id_right:@R> "SEQ"
        <exp:Exp> "RPAREN" <right:@R> => {
        let id = crate::phrase! {
            node: id,
            span: context.span(id_left, id_right),
        };
        crate::phrase! {
            node: (id, exp),
            span: context.span(left, right),
        }
    },
    <left:@L> "HINT_LPAREN" <id_left:@L> <id:HintId> <id_right:@R> "RPAREN"
        <right:@R> => {
        let id = crate::phrase! {
            node: id,
            span: context.span(id_left, id_right),
        };
        let exp = crate::phrase! {
            node: ExpKind::Seq(vec![]),
            span: id.span.clone(),
        };
        crate::phrase! {
            node: (id, exp),
            span: context.span(left, right),
        }
    },
};

// Hints ::= Hint*
Hints: Vec<Phrase<ast::Hint>> = {
    <hints:Hint*> => hints,
};

// TableBody ::= Bar BarList<TableRow>
TableBody: Vec<ast::TableRow> = {
    <_bar:Bar> <rows:BarList<TableRow>> => rows,
};

// TableRow ::= TablePattern DOUBLE_ARROW ExpBin
TableRow: ast::TableRow = {
    <pattern:TablePattern> "DOUBLE_ARROW" <body:ExpBin> => {
        let span = Span::new(pattern.span.left.clone(), body.span.right.clone());
        crate::phrase! {
            node: (pattern, body),
            span: span,
        }
    },
};

// TablePattern ::= ExpSeq
TablePattern: ast::Exp = ExpSeq;

// ExpSeq ::= ExpSeqStart ExpSeqTail*
ExpSeq: ast::Exp = {
    <first:ExpSeqStart> <rest:ExpSeqTail*> => {
        rest.into_iter().fold(first, |left, (fuse, right)| {
            let span = Span::new(left.span.left.clone(), right.span.right.clone());
            if fuse {
                crate::phrase! {
                    node: ExpKind::Fuse(Box::new(left), Box::new(right)),
                    span: span,
                }
            } else {
                let mut expressions = match left.node {
                    ExpKind::Seq(expressions) if expressions.len() >= 2 => expressions,
                    node => vec![crate::phrase! {
                        node: node,
                        span: left.span,
                    }],
                };
                expressions.push(right);
                crate::phrase! {
                    node: ExpKind::Seq(expressions),
                    span: span,
                }
            }
        })
    },
};

// ExpSeqStart ::= ExpPost | ExpListIter
ExpSeqStart: ast::Exp = {
    ExpPost,
    ExpListIter,
};

// ExpSeqTail ::= SEQ ExpPost | HASH ExpPost
ExpSeqTail: (bool, ast::Exp) = {
    "SEQ" <exp:ExpPost> => (false, exp),
    "HASH" <exp:ExpPost> => (true, exp),
};

// RuleRule ::= RULE RelId RuleIds COLON Exp PremList
RuleRule: ast::Rule = {
    <left:@L> "RULE" <relid:RelId> <ruleids:RuleIds> "COLON" <exp:Exp>
        <premises:PremList> => {
            let groupid = if ruleids.node.is_empty() {
                String::new()
            } else {
                ruleids.node[1..].to_owned()
            };
            let groupid = crate::phrase! {
                node: groupid,
                span: ruleids.span,
            };
            let right = premises
                .last()
                .map(|premise| premise.span.right.clone())
                .unwrap_or_else(|| exp.span.right.clone());
            let premises = premises
                .into_iter()
                .filter_map(|premise| premise.node)
                .collect();
            crate::phrase! {
                node: (relid, groupid, exp, premises),
                span: Span::new(context.position(left), right),
            }
        },
};

// RuleItem ::= NL2 | NL3 | RuleRule
RuleItem: Option<ast::Rule> = {
    "NL2" => None,
    "NL3" => None,
    <rule:RuleRule> => Some(rule),
};

// Rules ::= RuleItem*
Rules: Vec<ast::Rule> = {
    <items:RuleItem*> => items.into_iter().flatten().collect(),
};

// CallableDec ::= DefId COLON PlainTyp Hints
//   | DefIdLParen EnterScope CommaList<Param> RPAREN COLON PlainTyp
//       Hints ExitScope
//   | DefIdLAngle EnterScope CommaList<TParam> RANGLE COLON PlainTyp
//       Hints ExitScope
//   | DefIdLAngle EnterScope CommaList<TParam> RANGLE_LPAREN
//       CommaList<Param> RPAREN COLON PlainTyp Hints ExitScope
CallableDec: (
    ast::Id,
    Vec<ast::TParam>,
    Vec<ast::Param>,
    ast::PlainTyp,
    Vec<Phrase<ast::Hint>>,
) = {
    <id:DefId> "COLON" <plain_typ:PlainTyp> <hints:Hints> => {
        (id, vec![], vec![], plain_typ, hints)
    },
    <id:DefIdLParen> <_enter:EnterScope> <params:CommaList<Param>> "RPAREN" "COLON"
        <plain_typ:PlainTyp> <hints:Hints> <_exit:ExitScope> => {
            (id, vec![], params, plain_typ, hints)
        },
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE" "COLON"
        <plain_typ:PlainTyp> <hints:Hints> <_exit:ExitScope> => {
            (id, tparams, vec![], plain_typ, hints)
        },
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE_LPAREN"
        <params:CommaList<Param>> "RPAREN" "COLON" <plain_typ:PlainTyp> <hints:Hints>
        <_exit:ExitScope> => {
            (id, tparams, params, plain_typ, hints)
        },
};

// TableDecSignature ::= DefId COLON PlainTyp Hints
//   | DefIdLParen EnterScope CommaList<Param> RPAREN COLON PlainTyp
//       Hints ExitScope
TableDecSignature: (
    ast::Id,
    Vec<ast::Param>,
    ast::PlainTyp,
    Vec<Phrase<ast::Hint>>,
) = {
    <id:DefId> "COLON" <plain_typ:PlainTyp> <hints:Hints> => {
        (id, vec![], plain_typ, hints)
    },
    <id:DefIdLParen> <_enter:EnterScope> <params:CommaList<Param>> "RPAREN" "COLON"
        <plain_typ:PlainTyp> <hints:Hints> <_exit:ExitScope> => {
            (id, params, plain_typ, hints)
        },
};

// FunctionDefSignature ::= DefId EQ Exp PremList
//   | DefIdLParen EnterScope CommaList<Arg> RPAREN EQ Exp PremList
//       ExitScope
//   | DefIdLAngle EnterScope CommaList<TParam> RANGLE EQ Exp PremList
//       ExitScope
//   | DefIdLAngle EnterScope CommaList<TParam> RANGLE_LPAREN
//       CommaList<Arg> RPAREN EQ Exp PremList ExitScope
FunctionDefSignature: (
    ast::Id,
    Vec<ast::TParam>,
    Vec<ast::Arg>,
    ast::Exp,
    Vec<Phrase<Option<ast::Prem>>>,
) = {
    <id:DefId> "EQ" <exp:Exp> <prems:PremList> => {
        (id, vec![], vec![], exp, prems)
    },
    <id:DefIdLParen> <_enter:EnterScope> <args:CommaList<Arg>> "RPAREN" "EQ"
        <exp:Exp> <prems:PremList> <_exit:ExitScope> => {
            (id, vec![], args, exp, prems)
        },
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE" "EQ"
        <exp:Exp> <prems:PremList> <_exit:ExitScope> => {
            (id, tparams, vec![], exp, prems)
        },
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE_LPAREN"
        <args:CommaList<Arg>> "RPAREN" "EQ" <exp:Exp> <prems:PremList>
        <_exit:ExitScope> => {
            (id, tparams, args, exp, prems)
        },
};
