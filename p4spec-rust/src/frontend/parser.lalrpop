        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Bool(xl::bool::BinOp::Equiv), Box::new(r)),
            span: span,
        }
    },

    // ArithDoubleArrow ::= ArithOr
    ArithOr,
};

