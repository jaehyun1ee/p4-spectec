Bar: () = {
    // Bar ::= BAR
    "BAR" => (),

    // Bar ::= NL_BAR
    "NL_BAR" => (),
};

// BarList<T> ::= Separated<T, Bar>
BarList<T>: Vec<T> = Separated<T, Bar>;

Exp: ast::Exp = {
    // Exp ::= ExpPost
    #[precedence(level="0")]
    ExpPost,

    // Exp ::= ExpListIter
    ExpListIter,

    // Exp ::= Exp SEQ Exp
    #[precedence(level="2")]
    #[assoc(side="left")]
    <l:Exp> "SEQ" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        let mut expressions = match l.node {
            ExpKind::Seq(expressions) if expressions.len() >= 2 => expressions,
            node => vec![crate::phrase! {
                node: node,
                span: l.span,
            }],
        };
        expressions.push(r);
        crate::phrase! {
            node: ExpKind::Seq(expressions),
            span: span,
        }
    },

    // Exp ::= Exp HASH Exp
    <l:Exp> "HASH" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Fuse(Box::new(l), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= BAR Exp BAR
    #[precedence(level="3")]
    <l:@L> "BAR" <exp:Exp> "BAR" <r:@R> => {
        crate::phrase! {
            node: ExpKind::Len(Box::new(exp)),
            span: context.span(l, r),
        }
    },

    // Exp ::= UnaryOperator Exp
    <l:@L> <operator:UnaryOperator> <exp:Exp> <r:@R> => {
        crate::phrase! {
            node: ExpKind::Un(operator, Box::new(exp)),
            span: context.span(l, r),
        }
    },

    // Exp ::= InfixOperator Exp
    <operator:InfixOperator> <r:Exp> => {
        let span = Span::new(operator.span.left.clone(), r.span.right.clone());
        let l = crate::phrase! {
            node: ExpKind::Seq(vec![]),
            span: operator.span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp StarOperator Exp
    #[precedence(level="4")]
    #[assoc(side="left")]
    <l:Exp> <_operator:StarOperator> <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Mul), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp SLASH Exp
    <l:Exp> "SLASH" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Div), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp BACKSLASH Exp
    <l:Exp> "BACKSLASH" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Mod), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp PLUS Exp
    #[precedence(level="5")]
    #[assoc(side="left")]
    <l:Exp> "PLUS" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Add), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp MINUS Exp
    <l:Exp> "MINUS" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Sub), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp PLUS2 Exp
    <l:Exp> "PLUS2" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cat(Box::new(l), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp DotOperator Exp
    #[precedence(level="6")]
    #[assoc(side="left")]
    <l:Exp> <operator:DotOperator> <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp SemicolonOperator Exp
    #[precedence(level="7")]
    #[assoc(side="left")]
    <l:Exp> <operator:SemicolonOperator> <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp ArrowTypOperator Exp
    #[precedence(level="8")]
    #[assoc(side="right")]
    <l:Exp> <operator:ArrowTypOperator> <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp COLON2 Exp
    #[precedence(level="9")]
    #[assoc(side="right")]
    <head:Exp> "COLON2" <tail:Exp> => {
        let span = Span::new(head.span.left.clone(), tail.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cons(Box::new(head), Box::new(tail)),
            span: span,
        }
    },

    // Exp ::= Exp EQ Exp
    #[precedence(level="10")]
    #[assoc(side="right")]
    <l:Exp> "EQ" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cmp(Box::new(l), CmpOp::Bool(xl::bool::CmpOp::Eq), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp NEQ Exp
    <l:Exp> "NEQ" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cmp(Box::new(l), CmpOp::Bool(xl::bool::CmpOp::Ne), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp LANGLE_DASH Exp
    <l:Exp> "LANGLE_DASH" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Mem(Box::new(l), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp SUB PlainTyp
    #[precedence(level="11")]
    #[assoc(side="left")]
    <l:Exp> "SUB" <plain_typ:PlainTyp> => {
        let span = Span::new(l.span.left.clone(), plain_typ.span.right.clone());
        crate::phrase! {
            node: ExpKind::Sub(Box::new(l), plain_typ),
            span: span,
        }
    },

    // Exp ::= Exp ColonTypOperator Exp
    <l:Exp> <operator:ColonTypOperator> <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp SquigglyOperator Exp
    #[precedence(level="12")]
    #[assoc(side="right")]
    <l:Exp> <operator:SquigglyOperator> <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp TilesturnOperator Exp
    #[precedence(level="13")]
    #[assoc(side="none")]
    <l:Exp> <operator:TilesturnOperator> <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp TurnstileOperator Exp
    #[precedence(level="14")]
    #[assoc(side="none")]
    <l:Exp> <operator:TurnstileOperator> <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp AND Exp
    #[precedence(level="15")]
    #[assoc(side="left")]
    <l:Exp> "AND" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Bool(xl::bool::BinOp::And), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp OR Exp
    #[precedence(level="16")]
    #[assoc(side="left")]
    <l:Exp> "OR" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Bool(xl::bool::BinOp::Or), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp DOUBLE_ARROW Exp
    #[precedence(level="17")]
    #[assoc(side="right")]
    <l:Exp> "DOUBLE_ARROW" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Bool(xl::bool::BinOp::Impl), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp DOUBLE_ARROW_BOTH Exp
    <l:Exp> "DOUBLE_ARROW_BOTH" <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Bool(xl::bool::BinOp::Equiv), Box::new(r)),
            span: span,
        }
    },

    // Exp ::= Exp DoubleArrowTypOperator Exp
    <l:Exp> <operator:DoubleArrowTypOperator> <r:Exp> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // Exp ::= RelationOperator Exp
    #[precedence(level="18")]
    #[assoc(side="right")]
    <operator:RelationOperator> <r:Exp> => {
        let span = Span::new(operator.span.left.clone(), r.span.right.clone());
        let l = crate::phrase! {
            node: ExpKind::Seq(vec![]),
            span: operator.span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },
};

// Menhir deliberately uses `exp_bin` (rather than `exp`) at collection,
// argument, and table-body boundaries.  This parallel precedence grammar
// excludes the relation operators while retaining all ordinary expression
// operators and the full-expression escape hatches inside postfix forms.
ExpBin: ast::Exp = {
    // ExpBin ::= ExpPost
    #[precedence(level="0")]
    ExpPost,

    // ExpBin ::= ExpListIter
    ExpListIter,

    // ExpBin ::= ExpBin SEQ ExpBin
    #[precedence(level="2")]
    #[assoc(side="left")]
    <l:ExpBin> "SEQ" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        let mut expressions = match l.node {
            ExpKind::Seq(expressions) if expressions.len() >= 2 => expressions,
            node => vec![crate::phrase! {
                node: node,
                span: l.span,
            }],
        };
        expressions.push(r);
        crate::phrase! {
            node: ExpKind::Seq(expressions),
            span: span,
        }
    },

    // ExpBin ::= ExpBin HASH ExpBin
    <l:ExpBin> "HASH" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Fuse(Box::new(l), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= BAR Exp BAR
    #[precedence(level="3")]
    <l:@L> "BAR" <exp:Exp> "BAR" <r:@R> => {
        crate::phrase! {
            node: ExpKind::Len(Box::new(exp)),
            span: context.span(l, r),
        }
    },

    // ExpBin ::= UnaryOperator ExpBin
    <l:@L> <operator:UnaryOperator> <exp:ExpBin> <r:@R> => {
        crate::phrase! {
            node: ExpKind::Un(operator, Box::new(exp)),
            span: context.span(l, r),
        }
    },

    // ExpBin ::= InfixOperator ExpBin
    <operator:InfixOperator> <r:ExpBin> => {
        let span = Span::new(operator.span.left.clone(), r.span.right.clone());
        let l = crate::phrase! {
            node: ExpKind::Seq(vec![]),
            span: operator.span.clone(),
        };
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin StarOperator ExpBin
    #[precedence(level="4")]
    #[assoc(side="left")]
    <l:ExpBin> <_operator:StarOperator> <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Mul), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin SLASH ExpBin
    <l:ExpBin> "SLASH" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Div), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin BACKSLASH ExpBin
    <l:ExpBin> "BACKSLASH" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Mod), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin PLUS ExpBin
    #[precedence(level="5")]
    #[assoc(side="left")]
    <l:ExpBin> "PLUS" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Add), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin MINUS ExpBin
    <l:ExpBin> "MINUS" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Num(num::BinOp::Sub), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin PLUS2 ExpBin
    <l:ExpBin> "PLUS2" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cat(Box::new(l), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin DotOperator ExpBin
    #[precedence(level="6")]
    #[assoc(side="left")]
    <l:ExpBin> <operator:DotOperator> <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin SemicolonOperator ExpBin
    #[precedence(level="7")]
    #[assoc(side="left")]
    <l:ExpBin> <operator:SemicolonOperator> <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin ArrowTypOperator ExpBin
    #[precedence(level="8")]
    #[assoc(side="right")]
    <l:ExpBin> <operator:ArrowTypOperator> <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin COLON2 ExpBin
    #[precedence(level="9")]
    #[assoc(side="right")]
    <head:ExpBin> "COLON2" <tail:ExpBin> => {
        let span = Span::new(head.span.left.clone(), tail.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cons(Box::new(head), Box::new(tail)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin EQ ExpBin
    #[precedence(level="10")]
    #[assoc(side="right")]
    <l:ExpBin> "EQ" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cmp(Box::new(l), CmpOp::Bool(xl::bool::CmpOp::Eq), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin NEQ ExpBin
    <l:ExpBin> "NEQ" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Cmp(Box::new(l), CmpOp::Bool(xl::bool::CmpOp::Ne), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin LANGLE_DASH ExpBin
    <l:ExpBin> "LANGLE_DASH" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Mem(Box::new(l), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin SUB PlainTyp
    #[precedence(level="11")]
    #[assoc(side="left")]
    <l:ExpBin> "SUB" <plain_typ:PlainTyp> => {
        let span = Span::new(l.span.left.clone(), plain_typ.span.right.clone());
        crate::phrase! {
            node: ExpKind::Sub(Box::new(l), plain_typ),
            span: span,
        }
    },

    // ExpBin ::= ExpBin AND ExpBin
    #[precedence(level="15")]
    #[assoc(side="left")]
    <l:ExpBin> "AND" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Bool(xl::bool::BinOp::And), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin OR ExpBin
    #[precedence(level="16")]
    #[assoc(side="left")]
    <l:ExpBin> "OR" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Bool(xl::bool::BinOp::Or), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin DOUBLE_ARROW ExpBin
    #[precedence(level="17")]
    #[assoc(side="right")]
    <l:ExpBin> "DOUBLE_ARROW" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Bool(xl::bool::BinOp::Impl), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin DOUBLE_ARROW_BOTH ExpBin
    <l:ExpBin> "DOUBLE_ARROW_BOTH" <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Bin(Box::new(l), BinOp::Bool(xl::bool::BinOp::Equiv), Box::new(r)),
            span: span,
        }
    },

    // ExpBin ::= ExpBin DoubleArrowTypOperator ExpBin
    <l:ExpBin> <operator:DoubleArrowTypOperator> <r:ExpBin> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        }
    },
};

ExpListBase: ast::Exp = {
    // ExpListBase ::= LBRACK CommaList<ExpBin> RBRACK
    <l:@L> "LBRACK" <expressions:CommaList<ExpBin>> "RBRACK" <r:@R> => {
        crate::phrase! {
            node: ExpKind::List(expressions),
            span: context.span(l, r),
        }
    },
};

ExpListIter: ast::Exp = {
    // ExpListIter ::= ExpListBase QuestionIterAt*
    <l:@L> <base:ExpListBase> <iterations:QuestionIterAt*> => {
        iterations.into_iter().fold(base, |exp, (iter, r)| {
            crate::phrase! {
                node: ExpKind::Iter(Box::new(exp), iter),
                span: context.span(l, r),
            }
        })
    },
};

UnaryOperator: UnOp = {
    // UnaryOperator ::= TILDE
    "TILDE" => UnOp::Bool(xl::bool::UnOp::Not),

    // UnaryOperator ::= PLUS
    "PLUS" => UnOp::Num(num::UnOp::Plus),

    // UnaryOperator ::= MINUS
    "MINUS" => UnOp::Num(num::UnOp::Minus),
};

// `ParserTokens` inserts `SEQ` after a binary `*` when its right operand can
// also begin a notation sequence. Consuming it here leaves the same token as a
// real sequence separator after a postfix type iteration.
StarOperator: () = {
    // StarOperator ::= STAR SEQ
    "STAR" "SEQ" => (),

    // StarOperator ::= STAR
    "STAR" => (),
};

QuestionIter: Iter = {
    // QuestionIter ::= QUEST
    "QUEST" => Iter::Opt,

    // QuestionIter ::= ITER_STAR
    "ITER_STAR" => Iter::List,
};

QuestionIterAt: (Iter, Loc) = {
    // QuestionIterAt ::= QuestionIter
    <iter:QuestionIter> <r:@R> => (iter, r),
};

ExpAtomBase: ast::Exp = {
    // ExpAtomBase ::= ExpPrimary
    ExpPrimary,

    // ExpAtomBase ::= AtomRule
    <atom:AtomRule> => {
        let span = atom.span.clone();
        crate::phrase! {
            node: ExpKind::Atom(atom),
            span: span,
        }
    },

    // ExpAtomBase ::= AtomIdLParen Exp RPAREN
    <l:@L> <id:AtomIdLParen> <id_r:@R> <exp:Exp> "RPAREN" <r:@R> => {
        let atom = crate::phrase! {
            node: Atom::Keyword(id),
            span: context.span(l, id_r),
        };
        let atom_span = atom.span.clone();
        let atom_exp = crate::phrase! {
            node: ExpKind::Atom(atom),
            span: atom_span,
        };
        let paren_span = exp.span.clone();
        let paren_exp = crate::phrase! {
            node: ExpKind::Paren(Box::new(exp)),
            span: paren_span,
        };
        crate::phrase! {
            node: ExpKind::Seq(vec![atom_exp, paren_exp]),
            span: context.span(l, r),
        }
    },
};

// A postfix-only expression is used where whitespace-separated atoms form a
// record field or table pattern.  Keeping it separate from `Exp` prevents the
// separator from absorbing binary and relation operators.
ExpPost: ast::Exp = {
    // ExpPost ::= ExpAtomBase
    ExpAtomBase,

    // ExpPost ::= ExpPost LBRACK Arith RBRACK
    <l:@L> <base:ExpPost> "LBRACK" <index:Arith> "RBRACK" <r:@R> => {
        crate::phrase! {
            node: ExpKind::Idx(Box::new(base), Box::new(index)),
            span: context.span(l, r),
        }
    },

    // ExpPost ::= ExpPost LBRACK Arith COLON Arith RBRACK
    <l:@L> <base:ExpPost> "LBRACK" <start:Arith> "COLON" <end:Arith>
        "RBRACK" <r:@R> => {
        crate::phrase! {
            node: ExpKind::Slice(Box::new(base), Box::new(start), Box::new(end)),
            span: context.span(l, r),
        }
    },

    // ExpPost ::= ExpPost UpdatePath EQ Exp RBRACK
    <l:@L> <base:ExpPost> <path:UpdatePath> "EQ" <value:Exp> "RBRACK"
        <r:@R> => {
        crate::phrase! {
            node: ExpKind::Upd(Box::new(base), path, Box::new(value)),
            span: context.span(l, r),
        }
    },

    // ExpPost ::= ExpPost QuestionIter
    <l:@L> <base:ExpPost> <iter:QuestionIter> <r:@R> => {
        crate::phrase! {
            node: ExpKind::Iter(Box::new(base), iter),
            span: context.span(l, r),
        }
    },

    // ExpPost ::= ExpPost DotId
    <l:@L> <base:ExpPost> <field:DotId> <r:@R> => {
        match (base.node, field.node) {
            (ExpKind::Atom(atom), Atom::Keyword(suffix)) => match atom.node {
                Atom::Keyword(prefix) => {
                    let span = context.span(l, r);
                    let atom = crate::phrase! {
                        node: Atom::Keyword(format!("{prefix}.{suffix}")),
                        span: span.clone(),
                    };
                    crate::phrase! {
                        node: ExpKind::Atom(atom),
                        span: span,
                    }
                }
                node => crate::phrase! {
                    node: ExpKind::Dot(
                        Box::new(crate::phrase! {
                            node: ExpKind::Atom(crate::phrase! {
                                node: node,
                                span: atom.span,
                            }),
                            span: base.span,
                        }),
                        crate::phrase! {
                            node: Atom::Keyword(suffix),
                            span: field.span,
                        },
                    ),
                    span: context.span(l, r),
                },
            },
            (node, field_node) => crate::phrase! {
                node: ExpKind::Dot(
                    Box::new(crate::phrase! {
                        node: node,
                        span: base.span,
                    }),
                    crate::phrase! {
                        node: field_node,
                        span: field.span,
                    },
                ),
                span: context.span(l, r),
            },
        }
    },
};

ExpPrimary: ast::Exp = {
    // ExpPrimary ::= ExpLiteral
    ExpLiteral,

    // ExpPrimary ::= ExpVariable
    ExpVariable,

    // ExpPrimary ::= ExpCall
    ExpCall,

    // ExpPrimary ::= ExpHole
    ExpHole,

    // ExpPrimary ::= EPS
    <l:@L> "EPS" <r:@R> => crate::phrase! {
        node: ExpKind::Eps,
        span: context.span(l, r),
    },

    // ExpPrimary ::= LBRACE CommaList<FieldExp> RBRACE
    <l:@L> "LBRACE" <fields:CommaList<FieldExp>> "RBRACE" <r:@R> => {
        crate::phrase! {
            node: ExpKind::Str(fields),
            span: context.span(l, r),
        }
    },

    // ExpPrimary ::= LPAREN CommaList<ExpBin> RPAREN
    <l:@L> "LPAREN" <expressions:CommaList<ExpBin>> "RPAREN" <r:@R> => {
        let kind = match expressions.as_slice() {
            [] => ExpKind::Paren(Box::new(crate::phrase! {
                node: ExpKind::Tuple(vec![]),
                span: context.span(l, r),
            })),
            [exp] => ExpKind::Paren(Box::new(exp.clone())),
            _ => ExpKind::Tuple(expressions),
        };
        crate::phrase! {
            node: kind,
            span: context.span(l, r),
        }
    },

    // ExpPrimary ::= TickLAngle Exp TickRAngle
    <l:TickLAngle> <exp:Exp> <r:TickRAngle> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Brack(l, Box::new(exp), r),
            span: span,
        }
    },

    // ExpPrimary ::= TickLParen Exp TickRParen
    <l:TickLParen> <exp:Exp> <r:TickRParen> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Brack(l, Box::new(exp), r),
            span: span,
        }
    },

    // ExpPrimary ::= TickLBrack Exp TickRBrack
    <l:TickLBrack> <exp:Exp> <r:TickRBrack> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Brack(l, Box::new(exp), r),
            span: span,
        }
    },

    // ExpPrimary ::= TickLBrace Exp TickRBrace
    <l:TickLBrace> <exp:Exp> <r:TickRBrace> => {
        let span = Span::new(l.span.left.clone(), r.span.right.clone());
        crate::phrase! {
            node: ExpKind::Brack(l, Box::new(exp), r),
            span: span,
        }
    },

    // ExpPrimary ::= DOLLAR LPAREN Arith RPAREN
    <l:@L> "DOLLAR" "LPAREN" <arith:Arith> "RPAREN" <r:@R> => {
        crate::phrase! {
            node: arith.node,
            span: context.span(l, r),
        }
    },

    // ExpPrimary ::= HASH2 ExpPrimary
    <l:@L> "HASH2" <exp:ExpPrimary> <r:@R> => {
        crate::phrase! {
            node: ExpKind::Unparen(Box::new(exp)),
            span: context.span(l, r),
        }
    },
};

