// Parses SpecTec source by entering declaration scopes, building EL phrases,
// and attaching source spans; for example, `syntax bit = nat` becomes one type
// definition whose right edge is the `nat` token.

use crate::frontend::{
    ctx::{Context, Location as Loc},
    error::{FrontendError, SyntaxErrorKind},
    lexer::Token,
};
use crate::lang::{
    common::{notation::atom::Atom, source::{Position, Span, Phrase}},
    el::ast::{self, *},
    xl::{self, num},
};

grammar(context: &Context);

extern {
    type Location = Loc;
    type Error = FrontendError;

    enum Token {
        "TAG_UPID" => Token::TagUpperId(<String>),
        "OPERATOR" => Token::Operator(<String>),
        "TICK_LPAREN" => Token::TickLeftParen,
        "TICK_RPAREN" => Token::TickRightParen,
        "TICK_LBRACK" => Token::TickLeftBracket,
        "TICK_RBRACK" => Token::TickRightBracket,
        "TICK_LBRACE" => Token::TickLeftBrace,
        "TICK_RBRACE" => Token::TickRightBrace,
        "TICK_LANGLE" => Token::TickLeftAngle,
        "TICK_RANGLE" => Token::TickRightAngle,
        "NL_BAR" => Token::NewlineBar,
        "NL2" => Token::Newline2,
        "NL3" => Token::Newline3,
        "SEQ" => Token::Sequence,
        "SUB" => Token::Subtype,
        "TURNSTILE" => Token::Turnstile,
        "TILESTURN" => Token::Tilesturn,
        "ARROW" => Token::Arrow,
        "ARROW_SUB" => Token::ArrowSub,
        "DOUBLE_ARROW" => Token::DoubleArrow,
        "DOUBLE_ARROW_SUB" => Token::DoubleArrowSub,
        "DOUBLE_ARROW_BOTH" => Token::DoubleArrowBoth,
        "DOUBLE_ARROW_LONG" => Token::DoubleArrowLong,
        "SQARROW" => Token::SquigglyArrow,
        "SQARROW_STAR" => Token::SquigglyArrowStar,
        "AND" => Token::And,
        "OR" => Token::Or,
        "DOT" => Token::Dot,
        "DOT2" => Token::DoubleDot,
        "DOT3" => Token::TripleDot,
        "COMMA" => Token::Comma,
        "COMMA_NL" => Token::CommaNewline,
        "SEMICOLON" => Token::Semicolon,
        "COLON" => Token::Colon,
        "COLON2" => Token::DoubleColon,
        "COLON_SLASH" => Token::ColonSlash,
        "COLON_EQ" => Token::ColonEquals,
        "HASH" => Token::Hash,
        "HASH2" => Token::DoubleHash,
        "DOLLAR" => Token::Dollar,
        "QUEST" => Token::Question,
        "TILDE" => Token::Tilde,
        "TILDE2" => Token::DoubleTilde,
        "LANGLE" => Token::LeftAngle,
        "LANGLE_DASH" => Token::LeftAngleDash,
        "LANGLE_EQ" => Token::LeftAngleEquals,
        "RANGLE" => Token::RightAngle,
        "RANGLE_EQ" => Token::RightAngleEquals,
        "RANGLE_LPAREN" => Token::RightAngleLeftParen,
        "LPAREN" => Token::LeftParen,
        "RPAREN" => Token::RightParen,
        "LBRACK" => Token::LeftBracket,
        "RBRACK" => Token::RightBracket,
        "LBRACE" => Token::LeftBrace,
        "RBRACE" => Token::RightBrace,
        "PLUS" => Token::Plus,
        "PLUS2" => Token::DoublePlus,
        "MINUS" => Token::Minus,
        "DASH" => Token::Dash,
        "STAR" => Token::Star,
        "ITER_STAR" => Token::IterStar,
        "SLASH" => Token::Slash,
        "BACKSLASH" => Token::Backslash,
        "HOLE" => Token::Hole,
        "HOLE_NUM" => Token::NumberedHole(<i64>),
        "HOLE_MULTI" => Token::MultipleHole,
        "HOLE_NIL" => Token::EmptyHole,
        "EQ" => Token::Equals,
        "NEQ" => Token::NotEquals,
        "UP" => Token::Up,
        "BAR" => Token::Bar,
        "LATEX" => Token::Latex,
        "BOOL" => Token::Bool,
        "NAT" => Token::Nat,
        "INT" => Token::Int,
        "TEXT" => Token::Text,
        "SYNTAX" => Token::Syntax,
        "EXTERN" => Token::Extern,
        "TABLE" => Token::Table,
        "RELATION" => Token::Relation,
        "RULEGROUP" => Token::RuleGroup,
        "RULE" => Token::Rule,
        "VAR" => Token::Var,
        "BUILTIN" => Token::Builtin,
        "DEC" => Token::Dec,
        "DEF" => Token::Def,
        "IF" => Token::If,
        "OTHERWISE" => Token::Otherwise,
        "DEBUG" => Token::Debug,
        "HINT_LPAREN" => Token::HintLeftParen,
        "EPS" => Token::Epsilon,
        "BOOLLIT" => Token::BoolLiteral(<bool>),
        "NATLIT" => Token::NaturalLiteral(<num::Natural>),
        "HEXLIT" => Token::HexLiteral(<num::Natural>),
        "TEXTLIT" => Token::TextLiteral(<String>),
        "UPID" => Token::UpperId(<String>),
        "LOID" => Token::LowerId(<String>),
        "DOTID" => Token::DotId(<String>),
        "UPID_LPAREN" => Token::UpperIdLeftParen(<String>),
        "LOID_LPAREN" => Token::LowerIdLeftParen(<String>),
        "UPID_LANGLE" => Token::UpperIdLeftAngle(<String>),
        "LOID_LANGLE" => Token::LowerIdLeftAngle(<String>),
        "EOF" => Token::Eof,
    }
}

pub Spec: ast::Spec = {
    // Spec ::= NL2* Def* EOF
    "NL2"* <definitions:Def*> "EOF" => definitions,
};

Def: ast::Def = {
    // Def ::= DefCore NL2*
    <definition:DefCore> "NL2"* => definition,
};

DefCore: ast::Def = {
    // DefCore ::= RuleRule
    <l:@L> <rule:RuleRule> => {
        let r = rule.span.right.clone();
        let (relid, groupid, _, _) = rule.node.clone();
        let kind = DefKind::RuleGroup(RuleGroupDef {
            relid,
            groupid,
            rules: vec![rule],
        });
        crate::phrase! {
            node: kind,
            span: Span::new(context.position(l), r),
        }
    },

    // DefCore ::= DefKindRule
    DefKindRule,
};

DefKindRule: ast::Def = {
    // DefKindRule ::= EXTERN SYNTAX VarId Hints
    <l:@L> "EXTERN" "SYNTAX" <id:VarId> <hints:Hints> => {
        let r = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| id.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::ExternSyntax(ExternSyntaxDef { id, hints }),
            span: Span::new(context.position(l), r),
        }
    },

    // DefKindRule ::= SYNTAX CommaList<SynId>
    <l:@L> "SYNTAX" <syntax_r:@R> <entries:CommaList<SynId>> <r:@R> =>? {
        if entries.is_empty() {
            Err(lalrpop_util::ParseError::User {
                error: crate::phrase! {
                    node: SyntaxErrorKind::EmptySyntaxDeclaration,
                    span: context.span(l, syntax_r),
                }.into(),
            })
        } else {
            Ok(crate::phrase! {
                node: DefKind::Syntax(SyntaxDef { entries }),
                span: context.span(l, r),
            })
        }
    },

    // DefKindRule ::= SYNTAX VarIdBind Hints DefTypEquals DefTyp
    <l:@L> "SYNTAX" <id:VarIdBind> <hints:Hints> <equal_r:DefTypEquals>
        <def_typ:DefTyp?> =>? {
        let def_typ = def_typ.ok_or_else(|| lalrpop_util::ParseError::User {
            error: crate::phrase! {
                node: SyntaxErrorKind::EmptyType,
                span: context.span(equal_r, equal_r),
            }.into(),
        })?;
        let r = def_typ.span.right.clone();
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        Ok(crate::phrase! {
            node: DefKind::Typ(TypDef {
                id,
                tparams: vec![],
                def_typ,
                hints,
            }),
            span: Span::new(context.position(l), r),
        })
    },

    // DefKindRule ::= SYNTAX VarIdLAngleBind EnterScope CommaList<TParam> RANGLE Hints DefTypEquals
    //     DefTyp
    <l:@L> "SYNTAX" <id:VarIdLAngleBind> <_enter:EnterScope>
        <tparams:CommaList<TParam>> "RANGLE" <hints:Hints> <equal_r:DefTypEquals>
        <def_typ:DefTyp?> =>? {
            context.exit_scope();
            let def_typ = def_typ.ok_or_else(|| lalrpop_util::ParseError::User {
                error: crate::phrase! {
                    node: SyntaxErrorKind::EmptyType,
                    span: context.span(equal_r, equal_r),
                }.into(),
            })?;
            let r = def_typ.span.right.clone();
            let hints = hints.into_iter().map(|hint| hint.node).collect();
            Ok(crate::phrase! {
                node: DefKind::Typ(TypDef {
                    id,
                    tparams,
                    def_typ,
                    hints,
                }),
                span: Span::new(context.position(l), r),
            })
        },

    // DefKindRule ::= VAR VarIdBind COLON PlainTyp Hints
    <l:@L> "VAR" <id:VarIdBind> "COLON" <plain_typ:PlainTyp> <hints:Hints> => {
        let r = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::Var(VarDef { id, plain_typ, hints }),
            span: Span::new(context.position(l), r),
        }
    },

    // DefKindRule ::= EXTERN RELATION RelId COLON NotTyp Hints
    <l:@L> "EXTERN" "RELATION" <id:RelId> "COLON" <not_typ:NotTyp>
        <hints:Hints> => {
        let r = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| not_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::ExternRel(ExternRelDef { id, not_typ, hints }),
            span: Span::new(context.position(l), r),
        }
    },

    // DefKindRule ::= RELATION RelId COLON NotTyp Hints
    <l:@L> "RELATION" <id:RelId> "COLON" <not_typ:NotTyp> <hints:Hints> => {
        let r = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| not_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::Rel(RelDef { id, not_typ, hints }),
            span: Span::new(context.position(l), r),
        }
    },

    // DefKindRule ::= RULEGROUP RelId RuleIds SEQ? LBRACE Rules RBRACE
    <l:@L> "RULEGROUP" <relid:RelId> <ruleids:RuleIds> "SEQ"? "LBRACE"
        <rules:Rules> "RBRACE" <r:@R> => {
        let groupid = if ruleids.node.is_empty() {
            String::new()
        } else {
            ruleids.node[1..].to_owned()
        };
        crate::phrase! {
            node: DefKind::RuleGroup(RuleGroupDef {
                relid,
                groupid: crate::phrase! {
                    node: groupid,
                    span: ruleids.span,
                },
                rules,
            }),
            span: context.span(l, r),
        }
    },

    // DefKindRule ::= EXTERN DEC DOLLAR CallableDec
    <l:@L> "EXTERN" "DEC" "DOLLAR" <signature:CallableDec> => {
        let (id, tparams, params, plain_typ, hints) = signature;
        let r = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::ExternDec(ExternDecDef { id, tparams, params, plain_typ, hints }),
            span: Span::new(context.position(l), r),
        }
    },

    // DefKindRule ::= BUILTIN DEC DOLLAR CallableDec
    <l:@L> "BUILTIN" "DEC" "DOLLAR" <signature:CallableDec> => {
        let (id, tparams, params, plain_typ, hints) = signature;
        let r = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::BuiltinDec(BuiltinDecDef { id, tparams, params, plain_typ, hints }),
            span: Span::new(context.position(l), r),
        }
    },

    // DefKindRule ::= TABLE DEC DOLLAR TableDecSignature
    <l:@L> "TABLE" "DEC" "DOLLAR" <signature:TableDecSignature> => {
        let (id, params, plain_typ, hints) = signature;
        let r = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::TableDec(TableDecDef { id, params, plain_typ, hints }),
            span: Span::new(context.position(l), r),
        }
    },

    // DefKindRule ::= DEC DOLLAR CallableDec
    <l:@L> "DEC" "DOLLAR" <signature:CallableDec> => {
        let (id, tparams, params, plain_typ, hints) = signature;
        let r = hints
            .last()
            .map(|hint| hint.span.right.clone())
            .unwrap_or_else(|| plain_typ.span.right.clone());
        let hints = hints.into_iter().map(|hint| hint.node).collect();
        crate::phrase! {
            node: DefKind::FuncDec(FuncDecDef { id, tparams, params, plain_typ, hints }),
            span: Span::new(context.position(l), r),
        }
    },

    // DefKindRule ::= TABLE DEF DOLLAR DefId EQ TableBody
    <l:@L> "TABLE" "DEF" "DOLLAR" <id:DefId> "EQ" <rows:TableBody>
        <r:@R> => {
        crate::phrase! {
            node: DefKind::TableDef(TableDef { id, rows }),
            span: context.span(l, r),
        }
    },

    // DefKindRule ::= DEF DOLLAR FunctionDefSignature
    <l:@L> "DEF" "DOLLAR" <signature:FunctionDefSignature> => {
        let (id, tparams, args, exp, prems) = signature;
        let r = prems
            .last()
            .map(|premise| premise.span.right.clone())
            .unwrap_or_else(|| exp.span.right.clone());
        let prems = prems
            .into_iter()
            .filter_map(|premise| premise.node)
            .collect();
        crate::phrase! {
            node: DefKind::FuncDef(FuncDef { id, tparams, args, exp, prems }),
            span: Span::new(context.position(l), r),
        }
    },

    // DefKindRule ::= NL3
    <l:@L> "NL3" <r:@R> => crate::phrase! {
        node: DefKind::Sep,
        span: context.span(l, r),
    },
};

EnterScope: () = {
    // EnterScope ::= ε
    => context.enter_scope(),
};

ExitScope: () = {
    // ExitScope ::= ε
    => context.exit_scope(),
};

EnterExp: () = {
    // EnterExp ::= ε
    => context.enter_exp(),
};

EnterArith: () = {
    // EnterArith ::= ε
    => context.enter_arith(),
};

ExitMode: () = {
    // ExitMode ::= ε
    => context.exit_mode(),
};

DefTypEquals: Loc = {
    // DefTypEquals ::= EQ
    "EQ" <r:@R> => r,
};

Comma: () = {
    // Comma ::= COMMA
    "COMMA" => (),

    // Comma ::= COMMA_NL
    "COMMA_NL" => (),
};

Separated<T, Sep>: Vec<T> = {
    // Separated<T, Sep> ::= ε
    => vec![],

    // Separated<T, Sep> ::= T (Sep T)*
    <head:T> <tail:(<Sep> <T>)*> => {
        let mut items = Vec::with_capacity(tail.len() + 1);
        items.push(head);
        items.extend(tail.into_iter().map(|(_, item)| item));
        items
    },
};

// CommaList<T> ::= Separated<T, Comma>
CommaList<T>: Vec<T> = Separated<T, Comma>;

Id: ast::Id = {
    // Id ::= UPID
    <l:@L> <id:"UPID"> <r:@R> => crate::phrase! {
        node: id,
        span: context.span(l, r),
    },

    // Id ::= LOID
    <l:@L> <id:"LOID"> <r:@R> => crate::phrase! {
        node: id,
        span: context.span(l, r),
    },
};

IdLParen: ast::Id = {
    // IdLParen ::= UPID_LPAREN
    <l:@L> <id:"UPID_LPAREN"> <r:@R> => crate::phrase! {
        node: id,
        span: context.span(l, r),
    },

    // IdLParen ::= LOID_LPAREN
    <l:@L> <id:"LOID_LPAREN"> <r:@R> => crate::phrase! {
        node: id,
        span: context.span(l, r),
    },
};

IdLAngle: ast::Id = {
    // IdLAngle ::= UPID_LANGLE
    <l:@L> <id:"UPID_LANGLE"> <r:@R> => crate::phrase! {
        node: id,
        span: context.span(l, r),
    },

    // IdLAngle ::= LOID_LANGLE
    <l:@L> <id:"LOID_LANGLE"> <r:@R> => crate::phrase! {
        node: id,
        span: context.span(l, r),
    },
};

VarId: ast::Id = {
    // VarId ::= LOID
    <l:@L> <id:"LOID"> <r:@R> => crate::phrase! {
        node: id,
        span: context.span(l, r),
    },
};

VarIdBind: ast::Id = {
    // VarIdBind ::= VarId
    <id:VarId> => {
        context.add_id(&id.node);
        id
    },

    // VarIdBind ::= UPID
    <l:@L> <id:"UPID"> <r:@R> => {
        context.add_id(&id);
        crate::phrase! {
            node: id,
            span: context.span(l, r),
        }
    },
};

VarIdLAngle: ast::Id = {
    // VarIdLAngle ::= LOID_LANGLE
    <l:@L> <id:"LOID_LANGLE"> <r:@R> => crate::phrase! {
        node: id,
        span: context.span(l, r),
    },
};

VarIdLAngleBind: ast::Id = {
    // VarIdLAngleBind ::= VarIdLAngle
    <id:VarIdLAngle> => {
        context.add_id(&id.node);
        id
    },

    // VarIdLAngleBind ::= UPID_LANGLE
    <l:@L> <id:"UPID_LANGLE"> <r:@R> => {
        context.add_id(&id);
        crate::phrase! {
            node: id,
            span: context.span(l, r),
        }
    },
};

AtomIdRaw: String = {
    // AtomIdRaw ::= UPID
    <id:"UPID"> => id,
};

AtomIdLParen: String = {
    // AtomIdLParen ::= UPID_LPAREN
    <id:"UPID_LPAREN"> => id,
};

AtomIdLAngle: String = {
    // AtomIdLAngle ::= UPID_LANGLE
    <id:"UPID_LANGLE"> => id,
};

DotId: ast::Atom = {
    // DotId ::= DOTID
    <l:@L> <id:"DOTID"> <r:@R> => {
        crate::phrase! {
            node: Atom::Keyword(id),
            span: context.span(l, r),
        }
    },
};

FieldId: ast::Atom = {
    // FieldId ::= AtomIdRaw
    <l:@L> <id:AtomIdRaw> <r:@R> => {
        crate::phrase! {
            node: Atom::Keyword(id),
            span: context.span(l, r),
        }
    },
};

// RelId ::= Id
RelId: ast::Id = Id;

// DefId ::= Id
DefId: ast::Id = Id;

// DefIdLParen ::= IdLParen
DefIdLParen: ast::Id = IdLParen;

// DefIdLAngle ::= IdLAngle
DefIdLAngle: ast::Id = IdLAngle;

HintId: String = {
    // HintId ::= UPID
    <id:"UPID"> => id,

    // HintId ::= LOID
    <id:"LOID"> => id,
};

SynId: SyntaxDefEntry = {
    // SynId ::= VarId
    //   ExitScope
    <id:VarId> => SyntaxDefEntry { id, tparams: vec![] },

    // SynId ::= VarIdLAngleBind EnterScope CommaList<TParam> RANGLE
    <id:VarIdLAngleBind> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE"
        <_exit:ExitScope> => SyntaxDefEntry { id, tparams },
};

RuleId: String = {
    // RuleId ::= UPID
    <id:"UPID"> => id,

    // RuleId ::= LOID
    <id:"LOID"> => id,

    // RuleId ::= TEXT
    "TEXT" => "text".to_owned(),

    // RuleId ::= EXTERN
    "EXTERN" => "extern".to_owned(),

    // RuleId ::= BUILTIN
    "BUILTIN" => "builtin".to_owned(),

    // RuleId ::= NATLIT
    <value:"NATLIT"> => value.to_string(),

    // RuleId ::= BOOLLIT
    <value:"BOOLLIT"> => value.to_string(),

    // RuleId ::= RuleId DOTID
    <prefix:RuleId> <suffix:"DOTID"> => format!("{prefix}.{suffix}"),
};

RuleIdSegment: String = {
    // RuleIdSegment ::= SLASH RuleId
    "SLASH" <id:RuleId> => format!("/{id}"),

    // RuleIdSegment ::= MINUS RuleId
    "MINUS" <id:RuleId> => format!("-{id}"),
};

RuleIds: ast::Id = {
    // RuleIds ::= RuleIdSegment*
    <l:@L> <segments:RuleIdSegment*> <r:@R> => {
        crate::phrase! {
            node: segments.concat(),
            span: context.span(l, r),
        }
    },
};

// TParam ::= VarIdBind
TParam: ast::TParam = VarIdBind;

// Targ ::= PlainTyp
Targ: ast::Targ = PlainTyp;

#[inline]
IterRule: Iter = {
    // IterRule ::= QUEST
    "QUEST" => Iter::Opt,

    // IterRule ::= STAR
    "STAR" => Iter::List,

    // IterRule ::= ITER_STAR
    "ITER_STAR" => Iter::List,
};

PlainTyp: ast::PlainTyp = {
    // PlainTyp ::= PlainTypBase
    #[precedence(level="0")]
    <l:@L> <kind:PlainTypBase> <r:@R> => crate::phrase! {
        node: kind,
        span: context.span(l, r),
    },

    // PlainTyp ::= PlainTyp IterRule
    #[precedence(level="1")]
    #[assoc(side="left")]
    <l:@L> <plain_typ:PlainTyp> <iter:IterRule> <r:@R> => {
        crate::phrase! {
            node: PlainTypKind::Iter(Box::new(plain_typ), iter),
            span: context.span(l, r),
        }
    },
};

PlainTypBase: PlainTypKind = {
    // PlainTypBase ::= PlainTypPrimaryKind
    PlainTypPrimaryKind,

    // PlainTypBase ::= LPAREN CommaList<PlainTyp> RPAREN
    <l:@L> "LPAREN" <types:CommaList<PlainTyp>> "RPAREN" <r:@R> => {
        match types.as_slice() {
            [] => PlainTypKind::Paren(Box::new(crate::phrase! {
                node: PlainTypKind::Tuple(vec![]),
                span: context.span(l, r),
            })),
            [plain_typ] => PlainTypKind::Paren(Box::new(plain_typ.clone())),
            _ => PlainTypKind::Tuple(types),
        }
    },
};

PlainTypPrimaryKind: PlainTypKind = {
    // PlainTypPrimaryKind ::= VarId
    <id:VarId> => PlainTypKind::Var(id, vec![]),

    // PlainTypPrimaryKind ::= VarIdLAngle CommaList<Targ> RANGLE
    <id:VarIdLAngle> <targs:CommaList<Targ>> "RANGLE" => PlainTypKind::Var(id, targs),

    // PlainTypPrimaryKind ::= BOOL
    "BOOL" => PlainTypKind::Bool,

    // PlainTypPrimaryKind ::= NAT
    "NAT" => PlainTypKind::Num(num::Typ::Nat),

    // PlainTypPrimaryKind ::= INT
    "INT" => PlainTypKind::Num(num::Typ::Int),

    // PlainTypPrimaryKind ::= TEXT
    "TEXT" => PlainTypKind::Text,
};

AtomRule: ast::Atom = {
    // AtomRule ::= AtomKind
    <l:@L> <atom:AtomKind> <r:@R> => crate::phrase! {
        node: atom,
        span: context.span(l, r),
    },
};

AtomKind: Atom = {
    // AtomKind ::= AtomIdRaw
    <id:AtomIdRaw> => Atom::Keyword(id),

    // AtomKind ::= TAG_UPID
    <id:"TAG_UPID"> => Atom::Tag(id),

    // AtomKind ::= OPERATOR
    <operator:"OPERATOR"> => Atom::Operator(operator),
};

TypAtom: ast::Atom = {
    // TypAtom ::= AtomIdRaw DOTID*
    <l:@L> <id:AtomIdRaw> <suffixes:"DOTID"*> <r:@R> => {
        let id = suffixes.into_iter().fold(id, |prefix, suffix| {
            format!("{prefix}.{suffix}")
        });
        crate::phrase! {
            node: Atom::Keyword(id),
            span: context.span(l, r),
        }
    },

    // TypAtom ::= TAG_UPID
    <l:@L> <id:"TAG_UPID"> <r:@R> => crate::phrase! {
        node: Atom::Tag(id),
        span: context.span(l, r),
    },

    // TypAtom ::= OPERATOR
    <l:@L> <operator:"OPERATOR"> <r:@R> => {
        crate::phrase! {
            node: Atom::Operator(operator),
            span: context.span(l, r),
        }
    },
};

TypPrimary: Typ = {
    // TypPrimary ::= PlainTyp
    <plain_typ:PlainTyp> => Typ::Plain(plain_typ),

    // TypPrimary ::= TypAtom
    <atom:TypAtom> => {
        let span = atom.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Atom(atom),
            span: span,
        })
    },

    // TypPrimary ::= TickLAngle Typ TickRAngle
    <l:TickLAngle> <typ:Typ> <r:TickRAngle> => {
        let span = l.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Brack(l, Box::new(typ), r),
            span: span,
        })
    },

    // TypPrimary ::= TickLParen Typ TickRParen
    <l:TickLParen> <typ:Typ> <r:TickRParen> => {
        let span = l.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Brack(l, Box::new(typ), r),
            span: span,
        })
    },

    // TypPrimary ::= TickLBrack Typ TickRBrack
    <l:TickLBrack> <typ:Typ> <r:TickRBrack> => {
        let span = l.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Brack(l, Box::new(typ), r),
            span: span,
        })
    },

    // TypPrimary ::= TickLBrace Typ TickRBrace
    <l:TickLBrace> <typ:Typ> <r:TickRBrace> => {
        let span = l.span.clone();
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Brack(l, Box::new(typ), r),
            span: span,
        })
    },
};

Typ: Typ = {
    // Typ ::= RelationOperator Typ
    <operator:RelationOperator> <r:Typ> => {
        let span = operator.span.clone();
        let l = Typ::Notation(crate::phrase! {
            node: NotTypKind::Seq(vec![]),
            span: span.clone(),
        });
        Typ::Notation(crate::phrase! {
            node: NotTypKind::Infix(Box::new(l), operator, Box::new(r)),
            span: span,
        })
    },

    // Typ ::= TypDoubleArrow
    TypDoubleArrow,
};

