use crate::frontend::{
    error::{FrontendError, SyntaxErrorKind},
    lexer::Token,
    parser_support::{
        ExpPostfix, ParserContext, ParserLocation, PathStep, apply_exp_postfixes, build_path,
        def_typ_kind, dot_exp, infix_exp, infix_typ, prefix_exp, prefix_typ, span_between,
        spanned, syntax_error, typ_span,
    },
};
use crate::lang::{
    common::{notation::atom::Atom, source::{Span, Spanned}},
    el::ast::{self, *},
    xl::{self, num},
};

grammar(context: &ParserContext);

extern {
    type Location = ParserLocation;
    type Error = FrontendError;

    enum Token {
        "TAG_UPID" => Token::TagUpperId(<String>),
        "OPERATOR" => Token::Operator(<String>),
        "TICK_LPAREN" => Token::TickLeftParen,
        "TICK_RPAREN" => Token::TickRightParen,
        "TICK_LBRACK" => Token::TickLeftBracket,
        "TICK_RBRACK" => Token::TickRightBracket,
        "TICK_LBRACE" => Token::TickLeftBrace,
        "TICK_RBRACE" => Token::TickRightBrace,
        "TICK_LANGLE" => Token::TickLeftAngle,
        "TICK_RANGLE" => Token::TickRightAngle,
        "NL_BAR" => Token::NewlineBar,
        "NL2" => Token::Newline2,
        "NL3" => Token::Newline3,
        "SEQ" => Token::Sequence,
        "SUB" => Token::Subtype,
        "TURNSTILE" => Token::Turnstile,
        "TILESTURN" => Token::Tilesturn,
        "ARROW" => Token::Arrow,
        "ARROW_SUB" => Token::ArrowSub,
        "DOUBLE_ARROW" => Token::DoubleArrow,
        "DOUBLE_ARROW_SUB" => Token::DoubleArrowSub,
        "DOUBLE_ARROW_BOTH" => Token::DoubleArrowBoth,
        "DOUBLE_ARROW_LONG" => Token::DoubleArrowLong,
        "SQARROW" => Token::SquigglyArrow,
        "SQARROW_STAR" => Token::SquigglyArrowStar,
        "AND" => Token::And,
        "OR" => Token::Or,
        "DOT" => Token::Dot,
        "DOT2" => Token::DoubleDot,
        "DOT3" => Token::TripleDot,
        "COMMA" => Token::Comma,
        "COMMA_NL" => Token::CommaNewline,
        "SEMICOLON" => Token::Semicolon,
        "COLON" => Token::Colon,
        "COLON2" => Token::DoubleColon,
        "COLON_SLASH" => Token::ColonSlash,
        "COLON_EQ" => Token::ColonEquals,
        "HASH" => Token::Hash,
        "HASH2" => Token::DoubleHash,
        "DOLLAR" => Token::Dollar,
        "QUEST" => Token::Question,
        "TILDE" => Token::Tilde,
        "TILDE2" => Token::DoubleTilde,
        "LANGLE" => Token::LeftAngle,
        "LANGLE_DASH" => Token::LeftAngleDash,
        "LANGLE_EQ" => Token::LeftAngleEquals,
        "RANGLE" => Token::RightAngle,
        "RANGLE_EQ" => Token::RightAngleEquals,
        "RANGLE_LPAREN" => Token::RightAngleLeftParen,
        "LPAREN" => Token::LeftParen,
        "RPAREN" => Token::RightParen,
        "LBRACK" => Token::LeftBracket,
        "RBRACK" => Token::RightBracket,
        "LBRACE" => Token::LeftBrace,
        "RBRACE" => Token::RightBrace,
        "PLUS" => Token::Plus,
        "PLUS2" => Token::DoublePlus,
        "MINUS" => Token::Minus,
        "DASH" => Token::Dash,
        "STAR" => Token::Star,
        "ITER_STAR" => Token::IterStar,
        "SLASH" => Token::Slash,
        "BACKSLASH" => Token::Backslash,
        "HOLE" => Token::Hole,
        "HOLE_NUM" => Token::NumberedHole(<i64>),
        "HOLE_MULTI" => Token::MultipleHole,
        "HOLE_NIL" => Token::EmptyHole,
        "EQ" => Token::Equals,
        "NEQ" => Token::NotEquals,
        "UP" => Token::Up,
        "BAR" => Token::Bar,
        "LATEX" => Token::Latex,
        "BOOL" => Token::Bool,
        "NAT" => Token::Nat,
        "INT" => Token::Int,
        "TEXT" => Token::Text,
        "SYNTAX" => Token::Syntax,
        "EXTERN" => Token::Extern,
        "TABLE" => Token::Table,
        "RELATION" => Token::Relation,
        "RULEGROUP" => Token::RuleGroup,
        "RULE" => Token::Rule,
        "VAR" => Token::Var,
        "BUILTIN" => Token::Builtin,
        "DEC" => Token::Dec,
        "DEF" => Token::Def,
        "IF" => Token::If,
        "OTHERWISE" => Token::Otherwise,
        "DEBUG" => Token::Debug,
        "HINT_LPAREN" => Token::HintLeftParen,
        "EPS" => Token::Epsilon,
        "BOOLLIT" => Token::BoolLiteral(<bool>),
        "NATLIT" => Token::NaturalLiteral(<num::Natural>),
        "HEXLIT" => Token::HexLiteral(<num::Natural>),
        "TEXTLIT" => Token::TextLiteral(<String>),
        "UPID" => Token::UpperId(<String>),
        "LOID" => Token::LowerId(<String>),
        "DOTID" => Token::DotId(<String>),
        "UPID_LPAREN" => Token::UpperIdLeftParen(<String>),
        "LOID_LPAREN" => Token::LowerIdLeftParen(<String>),
        "UPID_LANGLE" => Token::UpperIdLeftAngle(<String>),
        "LOID_LANGLE" => Token::LowerIdLeftAngle(<String>),
        "EOF" => Token::Eof,
    }
}

// Spec ::= NL2* Def* EOF
pub Spec: ast::Spec = {
    "NL2"* <definitions:Def*> "EOF" => definitions,
};

// Def ::= DefCore NL2*
Def: ast::Def = {
    <definition:DefCore> "NL2"* => definition,
};

// DefCore ::= RuleRule | DefKindRule
DefCore: ast::Def = {
    <left:@L> <rule:RuleRule> => {
        let right = rule.span.right.clone();
        let (relid, groupid, _, _) = rule.node.clone();
        let kind = DefKind::RuleGroup(RuleGroupDef {
            relid,
            groupid,
            rules: vec![rule],
        });
        Spanned::new(kind, Span::new(context.position(left), right))
    },
    <left:@L> <kind:DefKindRule> <right:@R> => {
        let actual_right = match &kind {
            DefKind::ExternSyntax(definition) => definition
                .hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| definition.id.span.right.clone()),
            DefKind::Syntax(_) => context.position(right),
            DefKind::Typ(definition) => definition.def_typ.span.right.clone(),
            DefKind::Var(definition) => definition
                .hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| definition.plain_typ.span.right.clone()),
            DefKind::ExternRel(definition) => definition
                .hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| definition.not_typ.span.right.clone()),
            DefKind::Rel(definition) => definition
                .hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| definition.not_typ.span.right.clone()),
            DefKind::RuleGroup(_) => context.position(right),
            DefKind::ExternDec(definition) => definition
                .hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| definition.plain_typ.span.right.clone()),
            DefKind::BuiltinDec(definition) => definition
                .hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| definition.plain_typ.span.right.clone()),
            DefKind::TableDec(definition) => definition
                .hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| definition.plain_typ.span.right.clone()),
            DefKind::FuncDec(definition) => definition
                .hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| definition.plain_typ.span.right.clone()),
            DefKind::TableDef(_) => context.position(right),
            DefKind::FuncDef(definition) => {
                context.last_prem_list_right_or(definition.exp.span.right.clone())
            },
            DefKind::Sep => context.position(right),
        };
        Spanned::new(kind, Span::new(context.position(left), actual_right))
    },
};

// DefKindRule ::= EXTERN SYNTAX VarId Hints
//   | SYNTAX CommaList<SynId>
//   | SYNTAX VarIdBind Hints DefTypEquals DefTyp
//   | SYNTAX VarIdLAngleBind EnterScope CommaList<TParam> RANGLE Hints
//       DefTypEquals DefTyp
//   | VAR VarIdBind COLON PlainTyp Hints
//   | EXTERN RELATION RelId COLON NotTyp Hints
//   | RELATION RelId COLON NotTyp Hints
//   | RULEGROUP RelId RuleIds SEQ? LBRACE Rules RBRACE
//   | EXTERN DEC DOLLAR CallableDec
//   | BUILTIN DEC DOLLAR CallableDec
//   | TABLE DEC DOLLAR TableDecSignature
//   | DEC DOLLAR CallableDec
//   | TABLE DEF DOLLAR DefId EQ TableBody
//   | DEF DOLLAR FunctionDefSignature
//   | NL3
DefKindRule: DefKind = {
    "EXTERN" "SYNTAX" <id:VarId> <hints:Hints> => {
        DefKind::ExternSyntax(ExternSyntaxDef { id, hints })
    },
    <left:@L> "SYNTAX" <syntax_right:@R> <entries:CommaList<SynId>> =>? {
        if entries.is_empty() {
            Err(syntax_error(
                context,
                SyntaxErrorKind::EmptySyntaxDeclaration,
                left,
                syntax_right,
            ))
        } else {
            Ok(DefKind::Syntax(SyntaxDef { entries }))
        }
    },
    "SYNTAX" <id:VarIdBind> <hints:Hints> <_equal:DefTypEquals> <def_typ:DefTyp> => {
        DefKind::Typ(TypDef {
            id,
            tparams: vec![],
            def_typ,
            hints,
        })
    },
    "SYNTAX" <id:VarIdLAngleBind> <_enter:EnterScope>
        <tparams:CommaList<TParam>> "RANGLE" <hints:Hints> <_equal:DefTypEquals>
        <def_typ:DefTyp>
        => {
            context.exit_scope();
            DefKind::Typ(TypDef {
                id,
                tparams,
                def_typ,
                hints,
            })
        },
    "VAR" <id:VarIdBind> "COLON" <plain_typ:PlainTyp> <hints:Hints> => {
        DefKind::Var(VarDef {
            id,
            plain_typ,
            hints,
        })
    },
    "EXTERN" "RELATION" <id:RelId> "COLON" <not_typ:NotTyp> <hints:Hints> => {
        DefKind::ExternRel(ExternRelDef { id, not_typ, hints })
    },
    "RELATION" <id:RelId> "COLON" <not_typ:NotTyp> <hints:Hints> => {
        DefKind::Rel(RelDef { id, not_typ, hints })
    },
    "RULEGROUP" <relid:RelId> <ruleids:RuleIds> "SEQ"? "LBRACE" <rules:Rules> "RBRACE" => {
        let groupid = if ruleids.node.is_empty() {
            String::new()
        } else {
            ruleids.node[1..].to_owned()
        };
        DefKind::RuleGroup(RuleGroupDef {
            relid,
            groupid: Spanned::new(groupid, ruleids.span),
            rules,
        })
    },
    "EXTERN" "DEC" "DOLLAR" <signature:CallableDec> => {
        let (id, tparams, params, plain_typ, hints) = signature;
        DefKind::ExternDec(ExternDecDef { id, tparams, params, plain_typ, hints })
    },
    "BUILTIN" "DEC" "DOLLAR" <signature:CallableDec> => {
        let (id, tparams, params, plain_typ, hints) = signature;
        DefKind::BuiltinDec(BuiltinDecDef { id, tparams, params, plain_typ, hints })
    },
    "TABLE" "DEC" "DOLLAR" <signature:TableDecSignature> => {
        let (id, params, plain_typ, hints) = signature;
        DefKind::TableDec(TableDecDef { id, params, plain_typ, hints })
    },
    "DEC" "DOLLAR" <signature:CallableDec> => {
        let (id, tparams, params, plain_typ, hints) = signature;
        DefKind::FuncDec(FuncDecDef { id, tparams, params, plain_typ, hints })
    },
    "TABLE" "DEF" "DOLLAR" <id:DefId> "EQ" <rows:TableBody> => {
        DefKind::TableDef(TableDef { id, rows })
    },
    "DEF" "DOLLAR" <signature:FunctionDefSignature> => {
        let (id, tparams, args, exp, prems) = signature;
        DefKind::FuncDef(FuncDef { id, tparams, args, exp, prems })
    },
    "NL3" => DefKind::Sep,
};

// EnterScope ::= ε
EnterScope: () = {
    => context.enter_scope(),
};

// ExitScope ::= ε
ExitScope: () = {
    => context.exit_scope(),
};

// EnterExp ::= ε
EnterExp: () = {
    => context.enter_exp(),
};

// EnterArith ::= ε
EnterArith: () = {
    => context.enter_arith(),
};

// ExitMode ::= ε
ExitMode: () = {
    => context.exit_mode(),
};

// DefTypEquals ::= EQ
DefTypEquals: () = {
    "EQ" <right:@R> => context.record_def_typ_left(right),
};

// Comma ::= COMMA | COMMA_NL
Comma: () = {
    "COMMA" => (),
    "COMMA_NL" => (),
};

// CommaList<T> ::= ε | T | T Comma CommaList<T>
CommaList<T>: Vec<T> = {
    => vec![],
    <item:T> => vec![item],
    <head:T> <_comma:Comma> <mut tail:CommaList<T>> => {
        tail.insert(0, head);
        tail
    },
};

// Id ::= UPID | LOID
Id: ast::Id = {
    <left:@L> <id:"UPID"> <right:@R> => spanned(context, id, left, right),
    <left:@L> <id:"LOID"> <right:@R> => spanned(context, id, left, right),
};

// IdLParen ::= UPID_LPAREN | LOID_LPAREN
IdLParen: ast::Id = {
    <left:@L> <id:"UPID_LPAREN"> <right:@R> => spanned(context, id, left, right),
    <left:@L> <id:"LOID_LPAREN"> <right:@R> => spanned(context, id, left, right),
};

// IdLAngle ::= UPID_LANGLE | LOID_LANGLE
IdLAngle: ast::Id = {
    <left:@L> <id:"UPID_LANGLE"> <right:@R> => spanned(context, id, left, right),
    <left:@L> <id:"LOID_LANGLE"> <right:@R> => spanned(context, id, left, right),
};

// VarId ::= LOID
VarId: ast::Id = {
    <left:@L> <id:"LOID"> <right:@R> => spanned(context, id, left, right),
};

// VarIdBind ::= VarId | UPID
VarIdBind: ast::Id = {
    <id:VarId> => {
        context.bind(&id.node);
        id
    },
    <left:@L> <id:"UPID"> <right:@R> => {
        context.bind(&id);
        spanned(context, id, left, right)
    },
};

// VarIdLAngle ::= LOID_LANGLE
VarIdLAngle: ast::Id = {
    <left:@L> <id:"LOID_LANGLE"> <right:@R> => spanned(context, id, left, right),
};

// VarIdLAngleBind ::= VarIdLAngle | UPID_LANGLE
VarIdLAngleBind: ast::Id = {
    <id:VarIdLAngle> => {
        context.bind(&id.node);
        id
    },
    <left:@L> <id:"UPID_LANGLE"> <right:@R> => {
        context.bind(&id);
        spanned(context, id, left, right)
    },
};

// AtomIdRaw ::= UPID
AtomIdRaw: String = {
    <id:"UPID"> => id,
};

// AtomIdLParen ::= UPID_LPAREN
AtomIdLParen: String = {
    <id:"UPID_LPAREN"> => id,
};

// AtomIdLAngle ::= UPID_LANGLE
AtomIdLAngle: String = {
    <id:"UPID_LANGLE"> => id,
};

// DotId ::= DOTID
DotId: ast::Atom = {
    <left:@L> <id:"DOTID"> <right:@R> => {
        spanned(context, Atom::Keyword(id), left, right)
    },
};

// FieldId ::= AtomIdRaw
FieldId: ast::Atom = {
    <left:@L> <id:AtomIdRaw> <right:@R> => {
        spanned(context, Atom::Keyword(id), left, right)
    },
};

// RelId ::= Id
RelId: ast::Id = Id;

// DefId ::= Id
DefId: ast::Id = Id;

// DefIdLParen ::= IdLParen
DefIdLParen: ast::Id = IdLParen;

// DefIdLAngle ::= IdLAngle
DefIdLAngle: ast::Id = IdLAngle;

// HintId ::= UPID | LOID
HintId: String = {
    <id:"UPID"> => id,
    <id:"LOID"> => id,
};

// SynId ::= VarId | VarIdLAngleBind EnterScope CommaList<TParam> RANGLE
//   ExitScope
SynId: SyntaxDefEntry = {
    <id:VarId> => SyntaxDefEntry { id, tparams: vec![] },
    <id:VarIdLAngleBind> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE"
        <_exit:ExitScope> => SyntaxDefEntry { id, tparams },
};

// RuleId ::= UPID | LOID | TEXT | EXTERN | BUILTIN | NATLIT | BOOLLIT
//   | RuleId DOTID
RuleId: String = {
    <id:"UPID"> => id,
    <id:"LOID"> => id,
    "TEXT" => "text".to_owned(),
    "EXTERN" => "extern".to_owned(),
    "BUILTIN" => "builtin".to_owned(),
    <value:"NATLIT"> => value.to_string(),
    <value:"BOOLLIT"> => value.to_string(),
    <prefix:RuleId> <suffix:"DOTID"> => format!("{prefix}.{suffix}"),
};

// RuleIdSegment ::= SLASH RuleId | MINUS RuleId
RuleIdSegment: String = {
    "SLASH" <id:RuleId> => format!("/{id}"),
    "MINUS" <id:RuleId> => format!("-{id}"),
};

// RuleIds ::= RuleIdSegment*
RuleIds: ast::Id = {
    <left:@L> <segments:RuleIdSegment*> <right:@R> => {
        spanned(context, segments.concat(), left, right)
    },
};

// TParam ::= VarIdBind
TParam: ast::TParam = VarIdBind;

// Targ ::= PlainTyp
Targ: ast::Targ = PlainTyp;

// IterRule ::= QUEST | STAR | ITER_STAR
#[inline]
IterRule: Iter = {
    "QUEST" => Iter::Opt,
    "STAR" => Iter::List,
    "ITER_STAR" => Iter::List,
};

// PlainTyp ::= PlainTypBase | PlainTyp IterRule
PlainTyp: ast::PlainTyp = {
    #[precedence(level="0")]
    <left:@L> <kind:PlainTypBase> <right:@R> => spanned(context, kind, left, right),
    #[precedence(level="1")]
    #[assoc(side="left")]
    <left:@L> <plain_typ:PlainTyp> <iter:IterRule> <right:@R> => {
        spanned(context, PlainTypKind::Iter(Box::new(plain_typ), iter), left, right)
    },
};

// PlainTypBase ::= PlainTypPrimaryKind
//   | LPAREN CommaList<PlainTyp> RPAREN
PlainTypBase: PlainTypKind = {
    PlainTypPrimaryKind,
    <left:@L> "LPAREN" <types:CommaList<PlainTyp>> "RPAREN" <right:@R> => {
        match types.as_slice() {
            [] => PlainTypKind::Paren(Box::new(spanned(
                context,
                PlainTypKind::Tuple(vec![]),
                left,
                right,
            ))),
            [plain_typ] => PlainTypKind::Paren(Box::new(plain_typ.clone())),
            _ => PlainTypKind::Tuple(types),
        }
    },
};

// PlainTypPrimaryKind ::= VarId | VarIdLAngle CommaList<Targ> RANGLE
//   | BOOL | NAT | INT | TEXT
PlainTypPrimaryKind: PlainTypKind = {
    <id:VarId> => PlainTypKind::Var(id, vec![]),
    <id:VarIdLAngle> <targs:CommaList<Targ>> "RANGLE" => PlainTypKind::Var(id, targs),
    "BOOL" => PlainTypKind::Bool,
    "NAT" => PlainTypKind::Num(num::Typ::Nat),
    "INT" => PlainTypKind::Num(num::Typ::Int),
    "TEXT" => PlainTypKind::Text,
};

// AtomRule ::= AtomKind
AtomRule: ast::Atom = {
    <left:@L> <atom:AtomKind> <right:@R> => spanned(context, atom, left, right),
};

// AtomKind ::= AtomIdRaw | TAG_UPID | OPERATOR
AtomKind: Atom = {
    <id:AtomIdRaw> => Atom::Keyword(id),
    <id:"TAG_UPID"> => Atom::Tag(id),
    <operator:"OPERATOR"> => Atom::Operator(operator),
};

// TypAtom ::= AtomIdRaw DOTID* | TAG_UPID | OPERATOR
TypAtom: ast::Atom = {
    <left:@L> <id:AtomIdRaw> <suffixes:"DOTID"*> <right:@R> => {
        let id = suffixes.into_iter().fold(id, |prefix, suffix| {
            format!("{prefix}.{suffix}")
        });
        spanned(context, Atom::Keyword(id), left, right)
    },
    <left:@L> <id:"TAG_UPID"> <right:@R> => spanned(context, Atom::Tag(id), left, right),
    <left:@L> <operator:"OPERATOR"> <right:@R> => {
        spanned(context, Atom::Operator(operator), left, right)
    },
};

// TypPrimary ::= PlainTyp | TypAtom
//   | TickLAngle Typ TickRAngle
//   | TickLParen Typ TickRParen
//   | TickLBrack Typ TickRBrack
//   | TickLBrace Typ TickRBrace
TypPrimary: Typ = {
    <plain_typ:PlainTyp> => Typ::Plain(plain_typ),
    <atom:TypAtom> => {
        let span = atom.span.clone();
        Typ::Notation(Spanned::new(NotTypKind::Atom(atom), span))
    },
    <left:TickLAngle> <typ:Typ> <right:TickRAngle> => {
        let span = left.span.clone();
        Typ::Notation(Spanned::new(
            NotTypKind::Brack(left, Box::new(typ), right),
            span,
        ))
    },
    <left:TickLParen> <typ:Typ> <right:TickRParen> => {
        let span = left.span.clone();
        Typ::Notation(Spanned::new(
            NotTypKind::Brack(left, Box::new(typ), right),
            span,
        ))
    },
    <left:TickLBrack> <typ:Typ> <right:TickRBrack> => {
        let span = left.span.clone();
        Typ::Notation(Spanned::new(
            NotTypKind::Brack(left, Box::new(typ), right),
            span,
        ))
    },
    <left:TickLBrace> <typ:Typ> <right:TickRBrace> => {
        let span = left.span.clone();
        Typ::Notation(Spanned::new(
            NotTypKind::Brack(left, Box::new(typ), right),
            span,
        ))
    },
};

// Typ ::= RelationOperator Typ | TypDoubleArrow
Typ: Typ = {
    <operator:RelationOperator> <right:Typ> => prefix_typ(operator, right),
    TypDoubleArrow,
};

// TypDoubleArrow ::= TypTurnstile DoubleArrowTypOperator TypDoubleArrow
//   | TypTurnstile
TypDoubleArrow: Typ = {
    <left:TypTurnstile> <operator:DoubleArrowTypOperator> <right:TypDoubleArrow> => {
        infix_typ(left, operator, right)
    },
    TypTurnstile,
};

// TypTurnstile ::= TypTilesturn TurnstileOperator TypTilesturn
//   | TypTilesturn
TypTurnstile: Typ = {
    <left:TypTilesturn> <operator:TurnstileOperator> <right:TypTilesturn> => {
        infix_typ(left, operator, right)
    },
    TypTilesturn,
};

// TypTilesturn ::= TypSquiggly TilesturnOperator TypSquiggly
//   | TypSquiggly
TypTilesturn: Typ = {
    <left:TypSquiggly> <operator:TilesturnOperator> <right:TypSquiggly> => {
        infix_typ(left, operator, right)
    },
    TypSquiggly,
};

// TypSquiggly ::= TypColon SquigglyOperator TypSquiggly | TypColon
TypSquiggly: Typ = {
    <left:TypColon> <operator:SquigglyOperator> <right:TypSquiggly> => {
        infix_typ(left, operator, right)
    },
    TypColon,
};

// TypColon ::= TypColon ColonTypOperator TypArrow | TypArrow
TypColon: Typ = {
    <left:TypColon> <operator:ColonTypOperator> <right:TypArrow> => {
        infix_typ(left, operator, right)
    },
    TypArrow,
};

// TypArrow ::= TypSemicolon ArrowTypOperator TypArrow | TypSemicolon
TypArrow: Typ = {
    <left:TypSemicolon> <operator:ArrowTypOperator> <right:TypArrow> => {
        infix_typ(left, operator, right)
    },
    TypSemicolon,
};

// TypSemicolon ::= TypSemicolon SemicolonOperator TypDot | TypDot
TypSemicolon: Typ = {
    <left:TypSemicolon> <operator:SemicolonOperator> <right:TypDot> => {
        infix_typ(left, operator, right)
    },
    TypDot,
};

// TypDot ::= TypDot DotOperator TypBackslash | TypBackslash
TypDot: Typ = {
    <left:TypDot> <operator:DotOperator> <right:TypBackslash> => {
        infix_typ(left, operator, right)
    },
    TypBackslash,
};

// TypBackslash ::= TypBackslash BackslashOperator TypPrefix | TypPrefix
TypBackslash: Typ = {
    <left:TypBackslash> <operator:BackslashOperator> <right:TypPrefix> => {
        infix_typ(left, operator, right)
    },
    TypPrefix,
};

// TypPrefix ::= InfixOperator TypPrefix | TypSeq
TypPrefix: Typ = {
    <operator:InfixOperator> <right:TypPrefix> => prefix_typ(operator, right),
    TypSeq,
};

// TypSeq ::= TypPrimary (SEQ TypPrimary)*
TypSeq: Typ = {
    <first:TypPrimary> <first_right:@R> <rest:("SEQ" <TypPrimary>)*> => {
        if rest.is_empty() {
            first
        } else {
            let span = Span::new(
                typ_span(&first).left.clone(),
                context.position(first_right),
            );
            let mut types = Vec::with_capacity(rest.len() + 1);
            types.push(first);
            types.extend(rest);
            Typ::Notation(Spanned::new(NotTypKind::Seq(types), span))
        }
    },
};

// CheckTyp ::= Typ EOF
pub CheckTyp: Typ = {
    <typ:Typ> "EOF" => typ,
};

// NotTyp ::= Typ
NotTyp: ast::NotTyp = {
    <left:@L> <typ:Typ> <right:@R> =>? match typ {
        Typ::Notation(not_typ) => Ok(not_typ),
        Typ::Plain(_) => Err(syntax_error(
            context,
            SyntaxErrorKind::ExpectedNotationType,
            left,
            right,
        )),
    },
};

// FieldTyp ::= FieldId SEQ PlainTyp Hints
FieldTyp: ast::TypField = {
    <field:FieldId> "SEQ" <plain_typ:PlainTyp> <hints:Hints> => (field, plain_typ, hints),
};

// CaseTyp ::= Typ Hints
CaseTyp: (Typ, Vec<ast::Hint>, ParserLocation) = {
    <typ:Typ> <typ_right:@R> <hints:Hints> => (typ, hints, typ_right),
};

// CaseTypList ::= ε | CaseTyp (Bar CaseTyp)* BarAt?
CaseTypList: (Vec<(Typ, Vec<ast::Hint>, ParserLocation)>, Option<ParserLocation>) = {
    => (vec![], None),
    <head:CaseTyp> <tail:(<Bar> <CaseTyp>)*> <trailing:BarAt?> => {
        let mut cases = Vec::with_capacity(tail.len() + 1);
        cases.push(head);
        cases.extend(tail.into_iter().map(|(_, case)| case));
        (cases, trailing)
    },
};

// BarAt ::= Bar
BarAt: ParserLocation = {
    <_bar:Bar> <right:@R> => right,
};

// DefTyp ::= LBRACE CommaList<FieldTyp> RBRACE
//   | Bar CaseTypList
//   | CaseTypList
DefTyp: ast::DefTyp = {
    <left:@L> "LBRACE" <fields:CommaList<FieldTyp>> "RBRACE" <right:@R> =>? {
        if fields.is_empty() {
            Err(syntax_error(context, SyntaxErrorKind::EmptyStructType, left, right))
        } else {
            Ok(spanned(context, DefTypKind::Struct(fields), left, right))
        }
    },
    <left:@L> <_bar:Bar> <bar_right:@R> <case_list:CaseTypList> =>? {
        let (cases, trailing) = case_list;
        let actual_right = trailing
            .map(|location| context.position(location))
            .or_else(|| cases.last().map(|(_typ, hints, typ_right)| hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| context.position(*typ_right))))
            .unwrap_or_else(|| context.position(bar_right));
        let actual_right_location = context.intern_position(actual_right.clone());
        let cases = cases
            .into_iter()
            .map(|(typ, hints, _)| (typ, hints))
            .collect();
        def_typ_kind(cases, SyntaxErrorKind::EmptyVariantType)
            .map(|kind| Spanned::new(
                kind,
                Span::new(context.position(left), actual_right),
            ))
            .map_err(|kind| syntax_error(context, kind, left, actual_right_location))
    },
    <left:@L> <case_list:CaseTypList> =>? {
        let (cases, trailing) = case_list;
        let actual_right = trailing
            .map(|location| context.position(location))
            .or_else(|| cases.last().map(|(_typ, hints, typ_right)| hints
                .last()
                .map(|_| context.last_hint_right())
                .unwrap_or_else(|| context.position(*typ_right))))
            .unwrap_or_else(|| context.last_def_typ_left());
        let actual_right_location = context.intern_position(actual_right.clone());
        let actual_left = if cases.is_empty() {
            actual_right_location
        } else {
            left
        };
        let cases = cases
            .into_iter()
            .map(|(typ, hints, _)| (typ, hints))
            .collect();
        def_typ_kind(cases, SyntaxErrorKind::EmptyType)
            .map(|kind| Spanned::new(
                kind,
                Span::new(context.position(actual_left), actual_right),
            ))
            .map_err(|kind| syntax_error(context, kind, actual_left, actual_right_location))
    },
};

// TickLAngle ::= TICK_LANGLE
TickLAngle: ast::Atom = {
    <left:@L> "TICK_LANGLE" <right:@R> => spanned(context, Atom::LAngle, left, right),
};

// TickRAngle ::= TICK_RANGLE
TickRAngle: ast::Atom = {
    <left:@L> "TICK_RANGLE" <right:@R> => spanned(context, Atom::RAngle, left, right),
};

// TickLParen ::= TICK_LPAREN
TickLParen: ast::Atom = {
    <left:@L> "TICK_LPAREN" <right:@R> => spanned(context, Atom::LParen, left, right),
};

// TickRParen ::= TICK_RPAREN
TickRParen: ast::Atom = {
    <left:@L> "TICK_RPAREN" <right:@R> => spanned(context, Atom::RParen, left, right),
};

// TickLBrack ::= TICK_LBRACK
TickLBrack: ast::Atom = {
    <left:@L> "TICK_LBRACK" <right:@R> => spanned(context, Atom::LBrack, left, right),
};

// TickRBrack ::= TICK_RBRACK
TickRBrack: ast::Atom = {
    <left:@L> "TICK_RBRACK" <right:@R> => spanned(context, Atom::RBrack, left, right),
};

// TickLBrace ::= TICK_LBRACE
TickLBrace: ast::Atom = {
    <left:@L> "TICK_LBRACE" <right:@R> => spanned(context, Atom::LBrace, left, right),
};

// TickRBrace ::= TICK_RBRACE
TickRBrace: ast::Atom = {
    <left:@L> "TICK_RBRACE" <right:@R> => spanned(context, Atom::RBrace, left, right),
};

// InfixOperator ::= DotOperator | SemicolonOperator
//   | BackslashOperator | ArrowTypOperator | DoubleArrowTypOperator
InfixOperator: ast::Atom = {
    DotOperator,
    SemicolonOperator,
    BackslashOperator,
    ArrowTypOperator,
    DoubleArrowTypOperator,
};

// RelationOperator ::= ColonTypOperator | SquigglyOperator
//   | TilesturnOperator | TurnstileOperator
RelationOperator: ast::Atom = {
    ColonTypOperator,
    SquigglyOperator,
    TilesturnOperator,
    TurnstileOperator,
};

// DoubleArrowTypOperator ::= DOUBLE_ARROW_SUB | DOUBLE_ARROW_LONG
DoubleArrowTypOperator: ast::Atom = {
    <left:@L> "DOUBLE_ARROW_SUB" <right:@R> => {
        spanned(context, Atom::DoubleArrowSub, left, right)
    },
    <left:@L> "DOUBLE_ARROW_LONG" <right:@R> => {
        spanned(context, Atom::DoubleArrowLong, left, right)
    },
};

// TurnstileOperator ::= TURNSTILE
TurnstileOperator: ast::Atom = {
    <left:@L> "TURNSTILE" <right:@R> => spanned(context, Atom::Turnstile, left, right),
};

// TilesturnOperator ::= TILESTURN
TilesturnOperator: ast::Atom = {
    <left:@L> "TILESTURN" <right:@R> => spanned(context, Atom::Tilesturn, left, right),
};

// SquigglyOperator ::= SQARROW | SQARROW_STAR
SquigglyOperator: ast::Atom = {
    <left:@L> "SQARROW" <right:@R> => spanned(context, Atom::SqArrow, left, right),
    <left:@L> "SQARROW_STAR" <right:@R> => {
        spanned(context, Atom::SqArrowStar, left, right)
    },
};

// ColonTypOperator ::= COLON | COLON_EQ | TILDE2
ColonTypOperator: ast::Atom = {
    <left:@L> "COLON" <right:@R> => spanned(context, Atom::Colon, left, right),
    <left:@L> "COLON_EQ" <right:@R> => spanned(context, Atom::ColonEq, left, right),
    <left:@L> "TILDE2" <right:@R> => spanned(context, Atom::Tilde2, left, right),
};

// ArrowTypOperator ::= ARROW | ARROW_SUB
ArrowTypOperator: ast::Atom = {
    <left:@L> "ARROW" <right:@R> => spanned(context, Atom::Arrow, left, right),
    <left:@L> "ARROW_SUB" <right:@R> => spanned(context, Atom::ArrowSub, left, right),
};

// SemicolonOperator ::= SEMICOLON
SemicolonOperator: ast::Atom = {
    <left:@L> "SEMICOLON" <right:@R> => spanned(context, Atom::Semicolon, left, right),
};

// DotOperator ::= DOT | DOT2 | DOT3
DotOperator: ast::Atom = {
    <left:@L> "DOT" <right:@R> => spanned(context, Atom::Dot, left, right),
    <left:@L> "DOT2" <right:@R> => spanned(context, Atom::Dot2, left, right),
    <left:@L> "DOT3" <right:@R> => spanned(context, Atom::Dot3, left, right),
};

// BackslashOperator ::= BACKSLASH
BackslashOperator: ast::Atom = {
    <left:@L> "BACKSLASH" <right:@R> => spanned(context, Atom::Backslash, left, right),
};

// Bar ::= BAR | NL_BAR
Bar: () = {
    "BAR" => (),
    "NL_BAR" => (),
};

// BarList<T> ::= ε | T | T Bar BarList<T>
BarList<T>: Vec<T> = {
    => vec![],
    <item:T> => vec![item],
    <head:T> <_bar:Bar> <mut tail:BarList<T>> => {
        tail.insert(0, head);
        tail
    },
};

// Exp ::= ExpPost | ExpListIter
//   | Exp SEQ Exp | Exp HASH Exp
//   | BAR Exp BAR | UnaryOperator Exp | InfixOperator Exp
//   | Exp StarOperator Exp | Exp SLASH Exp | Exp BACKSLASH Exp
//   | Exp PLUS Exp | Exp MINUS Exp | Exp PLUS2 Exp
//   | Exp DotOperator Exp | Exp SemicolonOperator Exp
//   | Exp ArrowTypOperator Exp | Exp COLON2 Exp
//   | Exp EQ Exp | Exp NEQ Exp | Exp LANGLE_DASH Exp
//   | Exp SUB PlainTyp | Exp ColonTypOperator Exp
//   | Exp SquigglyOperator Exp | Exp TilesturnOperator Exp
//   | Exp TurnstileOperator Exp | Exp AND Exp | Exp OR Exp
//   | Exp DOUBLE_ARROW Exp | Exp DOUBLE_ARROW_BOTH Exp
//   | Exp DoubleArrowTypOperator Exp | RelationOperator Exp
Exp: ast::Exp = {
    #[precedence(level="0")]
    ExpPost,
    ExpListIter,

    #[precedence(level="2")]
    #[assoc(side="left")]
    <left:Exp> "SEQ" <right:Exp> => {
        let span = span_between(&left, &right);
        let mut expressions = match left.node {
            ExpKind::Seq(expressions) if expressions.len() >= 2 => expressions,
            node => vec![Spanned::new(node, left.span)],
        };
        expressions.push(right);
        Spanned::new(ExpKind::Seq(expressions), span)
    },
    <left:Exp> "HASH" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Fuse(Box::new(left), Box::new(right)), span)
    },

    #[precedence(level="3")]
    <left:@L> "BAR" <exp:Exp> "BAR" <right:@R> => {
        spanned(context, ExpKind::Len(Box::new(exp)), left, right)
    },
    <left:@L> <operator:UnaryOperator> <exp:Exp> <right:@R> => {
        spanned(context, ExpKind::Un(operator, Box::new(exp)), left, right)
    },
    <operator:InfixOperator> <right:Exp> => prefix_exp(operator, right),

    #[precedence(level="4")]
    #[assoc(side="left")]
    <left:Exp> <_operator:StarOperator> <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mul), Box::new(right)),
            span,
        )
    },
    <left:Exp> "SLASH" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Div), Box::new(right)),
            span,
        )
    },
    <left:Exp> "BACKSLASH" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mod), Box::new(right)),
            span,
        )
    },

    #[precedence(level="5")]
    #[assoc(side="left")]
    <left:Exp> "PLUS" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Add), Box::new(right)),
            span,
        )
    },
    <left:Exp> "MINUS" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Sub), Box::new(right)),
            span,
        )
    },
    <left:Exp> "PLUS2" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Cat(Box::new(left), Box::new(right)), span)
    },

    #[precedence(level="6")]
    #[assoc(side="left")]
    <left:Exp> <operator:DotOperator> <right:Exp> => infix_exp(left, operator, right),

    #[precedence(level="7")]
    #[assoc(side="left")]
    <left:Exp> <operator:SemicolonOperator> <right:Exp> => infix_exp(left, operator, right),

    #[precedence(level="8")]
    #[assoc(side="right")]
    <left:Exp> <operator:ArrowTypOperator> <right:Exp> => infix_exp(left, operator, right),

    #[precedence(level="9")]
    #[assoc(side="right")]
    <head:Exp> "COLON2" <tail:Exp> => {
        let span = span_between(&head, &tail);
        Spanned::new(ExpKind::Cons(Box::new(head), Box::new(tail)), span)
    },

    #[precedence(level="10")]
    #[assoc(side="right")]
    <left:Exp> "EQ" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Cmp(Box::new(left), CmpOp::Bool(xl::bool::CmpOp::Eq), Box::new(right)),
            span,
        )
    },
    <left:Exp> "NEQ" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Cmp(Box::new(left), CmpOp::Bool(xl::bool::CmpOp::Ne), Box::new(right)),
            span,
        )
    },
    <left:Exp> "LANGLE_DASH" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Mem(Box::new(left), Box::new(right)), span)
    },

    #[precedence(level="11")]
    #[assoc(side="left")]
    <left:Exp> "SUB" <plain_typ:PlainTyp> => {
        let span = span_between(&left, &plain_typ);
        Spanned::new(ExpKind::Sub(Box::new(left), plain_typ), span)
    },
    <left:Exp> <operator:ColonTypOperator> <right:Exp> => infix_exp(left, operator, right),

    #[precedence(level="12")]
    #[assoc(side="right")]
    <left:Exp> <operator:SquigglyOperator> <right:Exp> => infix_exp(left, operator, right),

    #[precedence(level="13")]
    #[assoc(side="none")]
    <left:Exp> <operator:TilesturnOperator> <right:Exp> => infix_exp(left, operator, right),

    #[precedence(level="14")]
    #[assoc(side="none")]
    <left:Exp> <operator:TurnstileOperator> <right:Exp> => infix_exp(left, operator, right),

    #[precedence(level="15")]
    #[assoc(side="left")]
    <left:Exp> "AND" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::And), Box::new(right)),
            span,
        )
    },

    #[precedence(level="16")]
    #[assoc(side="left")]
    <left:Exp> "OR" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Or), Box::new(right)),
            span,
        )
    },

    #[precedence(level="17")]
    #[assoc(side="right")]
    <left:Exp> "DOUBLE_ARROW" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Impl), Box::new(right)),
            span,
        )
    },
    <left:Exp> "DOUBLE_ARROW_BOTH" <right:Exp> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Equiv), Box::new(right)),
            span,
        )
    },
    <left:Exp> <operator:DoubleArrowTypOperator> <right:Exp> => {
        infix_exp(left, operator, right)
    },

    #[precedence(level="18")]
    #[assoc(side="right")]
    <operator:RelationOperator> <right:Exp> => prefix_exp(operator, right),
};

// Menhir deliberately uses `exp_bin` (rather than `exp`) at collection,
// argument, and table-body boundaries.  This parallel precedence grammar
// excludes the relation operators while retaining all ordinary expression
// operators and the full-expression escape hatches inside postfix forms.
// ExpBin ::= ExpPost | ExpListIter
//   | ExpBin SEQ ExpBin | ExpBin HASH ExpBin
//   | BAR Exp BAR | UnaryOperator ExpBin | InfixOperator ExpBin
//   | ExpBin StarOperator ExpBin | ExpBin SLASH ExpBin
//   | ExpBin BACKSLASH ExpBin | ExpBin PLUS ExpBin
//   | ExpBin MINUS ExpBin | ExpBin PLUS2 ExpBin
//   | ExpBin DotOperator ExpBin | ExpBin SemicolonOperator ExpBin
//   | ExpBin ArrowTypOperator ExpBin | ExpBin COLON2 ExpBin
//   | ExpBin EQ ExpBin | ExpBin NEQ ExpBin
//   | ExpBin LANGLE_DASH ExpBin | ExpBin SUB PlainTyp
//   | ExpBin AND ExpBin | ExpBin OR ExpBin
//   | ExpBin DOUBLE_ARROW ExpBin | ExpBin DOUBLE_ARROW_BOTH ExpBin
//   | ExpBin DoubleArrowTypOperator ExpBin
ExpBin: ast::Exp = {
    #[precedence(level="0")]
    ExpPost,
    ExpListIter,

    #[precedence(level="2")]
    #[assoc(side="left")]
    <left:ExpBin> "SEQ" <right:ExpBin> => {
        let span = span_between(&left, &right);
        let mut expressions = match left.node {
            ExpKind::Seq(expressions) if expressions.len() >= 2 => expressions,
            node => vec![Spanned::new(node, left.span)],
        };
        expressions.push(right);
        Spanned::new(ExpKind::Seq(expressions), span)
    },
    <left:ExpBin> "HASH" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Fuse(Box::new(left), Box::new(right)), span)
    },

    #[precedence(level="3")]
    <left:@L> "BAR" <exp:Exp> "BAR" <right:@R> => {
        spanned(context, ExpKind::Len(Box::new(exp)), left, right)
    },
    <left:@L> <operator:UnaryOperator> <exp:ExpBin> <right:@R> => {
        spanned(context, ExpKind::Un(operator, Box::new(exp)), left, right)
    },
    <operator:InfixOperator> <right:ExpBin> => prefix_exp(operator, right),

    #[precedence(level="4")]
    #[assoc(side="left")]
    <left:ExpBin> <_operator:StarOperator> <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mul), Box::new(right)),
            span,
        )
    },
    <left:ExpBin> "SLASH" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Div), Box::new(right)),
            span,
        )
    },
    <left:ExpBin> "BACKSLASH" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mod), Box::new(right)),
            span,
        )
    },

    #[precedence(level="5")]
    #[assoc(side="left")]
    <left:ExpBin> "PLUS" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Add), Box::new(right)),
            span,
        )
    },
    <left:ExpBin> "MINUS" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Sub), Box::new(right)),
            span,
        )
    },
    <left:ExpBin> "PLUS2" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Cat(Box::new(left), Box::new(right)), span)
    },

    #[precedence(level="6")]
    #[assoc(side="left")]
    <left:ExpBin> <operator:DotOperator> <right:ExpBin> => {
        infix_exp(left, operator, right)
    },

    #[precedence(level="7")]
    #[assoc(side="left")]
    <left:ExpBin> <operator:SemicolonOperator> <right:ExpBin> => {
        infix_exp(left, operator, right)
    },

    #[precedence(level="8")]
    #[assoc(side="right")]
    <left:ExpBin> <operator:ArrowTypOperator> <right:ExpBin> => {
        infix_exp(left, operator, right)
    },

    #[precedence(level="9")]
    #[assoc(side="right")]
    <head:ExpBin> "COLON2" <tail:ExpBin> => {
        let span = span_between(&head, &tail);
        Spanned::new(ExpKind::Cons(Box::new(head), Box::new(tail)), span)
    },

    #[precedence(level="10")]
    #[assoc(side="right")]
    <left:ExpBin> "EQ" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Cmp(Box::new(left), CmpOp::Bool(xl::bool::CmpOp::Eq), Box::new(right)),
            span,
        )
    },
    <left:ExpBin> "NEQ" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Cmp(Box::new(left), CmpOp::Bool(xl::bool::CmpOp::Ne), Box::new(right)),
            span,
        )
    },
    <left:ExpBin> "LANGLE_DASH" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Mem(Box::new(left), Box::new(right)), span)
    },

    #[precedence(level="11")]
    #[assoc(side="left")]
    <left:ExpBin> "SUB" <plain_typ:PlainTyp> => {
        let span = span_between(&left, &plain_typ);
        Spanned::new(ExpKind::Sub(Box::new(left), plain_typ), span)
    },

    #[precedence(level="15")]
    #[assoc(side="left")]
    <left:ExpBin> "AND" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::And), Box::new(right)),
            span,
        )
    },

    #[precedence(level="16")]
    #[assoc(side="left")]
    <left:ExpBin> "OR" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Or), Box::new(right)),
            span,
        )
    },

    #[precedence(level="17")]
    #[assoc(side="right")]
    <left:ExpBin> "DOUBLE_ARROW" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Impl), Box::new(right)),
            span,
        )
    },
    <left:ExpBin> "DOUBLE_ARROW_BOTH" <right:ExpBin> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Equiv), Box::new(right)),
            span,
        )
    },
    <left:ExpBin> <operator:DoubleArrowTypOperator> <right:ExpBin> => {
        infix_exp(left, operator, right)
    },
};

// ExpListBase ::= LBRACK CommaList<ExpBin> RBRACK
ExpListBase: ast::Exp = {
    <left:@L> "LBRACK" <expressions:CommaList<ExpBin>> "RBRACK" <right:@R> => {
        spanned(context, ExpKind::List(expressions), left, right)
    },
};

// ExpListIter ::= ExpListBase QuestionIterAt*
ExpListIter: ast::Exp = {
    <left:@L> <base:ExpListBase> <iterations:QuestionIterAt*> => {
        let postfixes = iterations
            .into_iter()
            .map(|(iter, right)| ExpPostfix::Iter(iter, right))
            .collect();
        apply_exp_postfixes(context, left, base, postfixes)
    },
};

// UnaryOperator ::= TILDE | PLUS | MINUS
UnaryOperator: UnOp = {
    "TILDE" => UnOp::Bool(xl::bool::UnOp::Not),
    "PLUS" => UnOp::Num(num::UnOp::Plus),
    "MINUS" => UnOp::Num(num::UnOp::Minus),
};

// `ParserTokens` inserts `SEQ` after a binary `*` when its right operand can
// also begin a notation sequence. Consuming it here leaves the same token as a
// real sequence separator after a postfix type iteration.
// StarOperator ::= STAR SEQ | STAR
StarOperator: () = {
    "STAR" "SEQ" => (),
    "STAR" => (),
};

// QuestionIter ::= QUEST | ITER_STAR
QuestionIter: Iter = {
    "QUEST" => Iter::Opt,
    "ITER_STAR" => Iter::List,
};

// QuestionIterAt ::= QuestionIter
QuestionIterAt: (Iter, ParserLocation) = {
    <iter:QuestionIter> <right:@R> => (iter, right),
};

// ExpAtomBase ::= ExpPrimary | AtomRule
//   | AtomIdLParen Exp RPAREN
ExpAtomBase: ast::Exp = {
    ExpPrimary,
    <atom:AtomRule> => {
        let span = atom.span.clone();
        Spanned::new(ExpKind::Atom(atom), span)
    },
    <left:@L> <id:AtomIdLParen> <id_right:@R> <exp:Exp> "RPAREN" <right:@R> => {
        let atom = spanned(context, Atom::Keyword(id), left, id_right);
        let atom_span = atom.span.clone();
        let atom_exp = Spanned::new(ExpKind::Atom(atom), atom_span);
        let paren_span = exp.span.clone();
        let paren_exp = Spanned::new(ExpKind::Paren(Box::new(exp)), paren_span);
        spanned(context, ExpKind::Seq(vec![atom_exp, paren_exp]), left, right)
    },
};

// A postfix-only expression is used where whitespace-separated atoms form a
// record field or table pattern.  Keeping it separate from `Exp` prevents the
// separator from absorbing binary and relation operators.
// ExpPost ::= ExpAtomBase ExpPostfixRule*
ExpPost: ast::Exp = {
    <left:@L> <base:ExpAtomBase> <postfixes:ExpPostfixRule*> => {
        apply_exp_postfixes(context, left, base, postfixes)
    },
};

// ExpPostfixRule ::= LBRACK Arith RBRACK
//   | LBRACK Arith COLON Arith RBRACK
//   | LBracketRight PathSteps EQ Exp RBRACK
//   | LBracketRight EQ Exp RBRACK
//   | QuestionIter | DotId
ExpPostfixRule: ExpPostfix = {
    "LBRACK" <index:Arith> "RBRACK" <right:@R> => ExpPostfix::Idx(index, right),
    "LBRACK" <start:Arith> "COLON" <end:Arith> "RBRACK" <right:@R> => {
        ExpPostfix::Slice(start, end, right)
    },
    <path_left:LBracketRight> <steps:PathSteps> "EQ" <value:Exp> "RBRACK" <right:@R> => {
        ExpPostfix::Upd(build_path(context, path_left, steps), value, right)
    },
    <path_left:LBracketRight> "EQ" <value:Exp> "RBRACK" <right:@R> => {
        ExpPostfix::Upd(build_path(context, path_left, vec![]), value, right)
    },
    <iter:QuestionIter> <right:@R> => ExpPostfix::Iter(iter, right),
    <atom:DotId> <right:@R> => ExpPostfix::Dot(atom, right),
};

// ExpPrimary ::= ExpLiteral | ExpVariable | ExpCall | ExpHole | EPS
//   | LBRACE CommaList<FieldExp> RBRACE
//   | LPAREN CommaList<ExpBin> RPAREN
//   | TickLAngle Exp TickRAngle
//   | TickLParen Exp TickRParen
//   | TickLBrack Exp TickRBrack
//   | TickLBrace Exp TickRBrace
//   | DOLLAR LPAREN Arith RPAREN
//   | HASH2 ExpPrimary
ExpPrimary: ast::Exp = {
    ExpLiteral,
    ExpVariable,
    ExpCall,
    ExpHole,
    <left:@L> "EPS" <right:@R> => spanned(context, ExpKind::Eps, left, right),
    <left:@L> "LBRACE" <fields:CommaList<FieldExp>> "RBRACE" <right:@R> => {
        spanned(context, ExpKind::Str(fields), left, right)
    },
    <left:@L> "LPAREN" <expressions:CommaList<ExpBin>> "RPAREN" <right:@R> => {
        let kind = match expressions.as_slice() {
            [] => ExpKind::Paren(Box::new(spanned(
                context,
                ExpKind::Tuple(vec![]),
                left,
                right,
            ))),
            [exp] => ExpKind::Paren(Box::new(exp.clone())),
            _ => ExpKind::Tuple(expressions),
        };
        spanned(context, kind, left, right)
    },
    <left:TickLAngle> <exp:Exp> <right:TickRAngle> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Brack(left, Box::new(exp), right), span)
    },
    <left:TickLParen> <exp:Exp> <right:TickRParen> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Brack(left, Box::new(exp), right), span)
    },
    <left:TickLBrack> <exp:Exp> <right:TickRBrack> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Brack(left, Box::new(exp), right), span)
    },
    <left:TickLBrace> <exp:Exp> <right:TickRBrace> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Brack(left, Box::new(exp), right), span)
    },
    <left:@L> "DOLLAR" "LPAREN" <arith:Arith> "RPAREN" <right:@R> => {
        spanned(context, arith.node, left, right)
    },
    <left:@L> "HASH2" <exp:ExpPrimary> <right:@R> => {
        spanned(context, ExpKind::Unparen(Box::new(exp)), left, right)
    },
};

// ExpLiteral ::= BOOLLIT | NATLIT | HEXLIT | TEXTLIT
ExpLiteral: ast::Exp = {
    <left:@L> <value:"BOOLLIT"> <right:@R> => {
        spanned(context, ExpKind::Bool(value), left, right)
    },
    <left:@L> <value:"NATLIT"> <right:@R> => {
        spanned(
            context,
            ExpKind::Num(NumOp::Dec, num::Number::Nat(value)),
            left,
            right,
        )
    },
    <left:@L> <value:"HEXLIT"> <right:@R> => {
        spanned(
            context,
            ExpKind::Num(NumOp::Hex, num::Number::Nat(value)),
            left,
            right,
        )
    },
    <left:@L> <text:"TEXTLIT"> <right:@R> => {
        spanned(context, ExpKind::Text(text), left, right)
    },
};

// ExpVariable ::= VarId | BOOL | NAT | INT | TEXT
ExpVariable: ast::Exp = {
    <id:VarId> => {
        let span = id.span.clone();
        Spanned::new(ExpKind::Var(id), span)
    },
    <left:@L> "BOOL" <right:@R> => {
        spanned(
            context,
            ExpKind::Var(spanned(context, "bool".to_owned(), left, right)),
            left,
            right,
        )
    },
    <left:@L> "NAT" <right:@R> => {
        spanned(
            context,
            ExpKind::Var(spanned(context, "nat".to_owned(), left, right)),
            left,
            right,
        )
    },
    <left:@L> "INT" <right:@R> => {
        spanned(
            context,
            ExpKind::Var(spanned(context, "int".to_owned(), left, right)),
            left,
            right,
        )
    },
    <left:@L> "TEXT" <right:@R> => {
        spanned(
            context,
            ExpKind::Var(spanned(context, "text".to_owned(), left, right)),
            left,
            right,
        )
    },
};

// ExpCall ::= DOLLAR DefId
//   | DOLLAR DefIdLParen CommaList<Arg> RPAREN
//   | DOLLAR DefIdLAngle CommaList<Targ> RANGLE
//   | DOLLAR DefIdLAngle CommaList<Targ> RANGLE_LPAREN
//       CommaList<Arg> RPAREN
ExpCall: ast::Exp = {
    <left:@L> "DOLLAR" <id:DefId> <right:@R> => {
        spanned(context, ExpKind::Call(id, vec![], vec![]), left, right)
    },
    <left:@L> "DOLLAR" <id:DefIdLParen> <args:CommaList<Arg>> "RPAREN" <right:@R> => {
        spanned(context, ExpKind::Call(id, vec![], args), left, right)
    },
    <left:@L> "DOLLAR" <id:DefIdLAngle> <targs:CommaList<Targ>> "RANGLE" <right:@R> => {
        spanned(context, ExpKind::Call(id, targs, vec![]), left, right)
    },
    <left:@L> "DOLLAR" <id:DefIdLAngle> <targs:CommaList<Targ>> "RANGLE_LPAREN"
        <args:CommaList<Arg>> "RPAREN" <right:@R> => {
            spanned(context, ExpKind::Call(id, targs, args), left, right)
        },
};

// ExpHole ::= HOLE_NUM | HOLE | HOLE_MULTI | HOLE_NIL
//   | LATEX LPAREN TEXTLIT* RPAREN
ExpHole: ast::Exp = {
    <left:@L> <number:"HOLE_NUM"> <right:@R> => {
        spanned(context, ExpKind::Hole(Hole::Num(number)), left, right)
    },
    <left:@L> "HOLE" <right:@R> => {
        spanned(context, ExpKind::Hole(Hole::Next), left, right)
    },
    <left:@L> "HOLE_MULTI" <right:@R> => {
        spanned(context, ExpKind::Hole(Hole::Rest), left, right)
    },
    <left:@L> "HOLE_NIL" <right:@R> => {
        spanned(context, ExpKind::Hole(Hole::None), left, right)
    },
    <left:@L> "LATEX" "LPAREN" <parts:"TEXTLIT"*> "RPAREN" <right:@R> => {
        spanned(context, ExpKind::Latex(parts.join(" ")), left, right)
    },
};

// FieldExp ::= FieldId SEQ ExpPost (SEQ ExpPost)*
FieldExp: (ast::Atom, ast::Exp) = {
    <field:FieldId> "SEQ" <first:ExpPost> <rest:("SEQ" <ExpPost>)*> => {
        let mut expressions = Vec::with_capacity(rest.len() + 1);
        expressions.push(first);
        expressions.extend(rest);
        let exp = if expressions.len() == 1 {
            expressions.into_iter().next().expect("one expression")
        } else {
            let span = span_between(
                expressions.first().expect("nonempty expressions"),
                expressions.last().expect("nonempty expressions"),
            );
            Spanned::new(ExpKind::Seq(expressions), span)
        };
        (field, exp)
    },
};

// Arg ::= EnterExp ExpBin ExitMode | DEF DOLLAR DefId
Arg: ast::Arg = {
    <left:@L> <_enter:EnterExp> <exp:ExpBin> <right:@R> <_exit:ExitMode> => {
        spanned(context, ArgKind::Exp(Box::new(exp)), left, right)
    },
    <left:@L> "DEF" "DOLLAR" <id:DefId> <right:@R> => {
        spanned(context, ArgKind::Def(id), left, right)
    },
};

// Arith ::= EnterArith ArithDoubleArrow ExitMode
Arith: ast::Exp = {
    <_enter:EnterArith> <arith:ArithDoubleArrow> <_exit:ExitMode> => arith,
};

// ArithDoubleArrow ::= ArithOr DOUBLE_ARROW ArithDoubleArrow
//   | ArithOr DOUBLE_ARROW_BOTH ArithDoubleArrow
//   | ArithOr
ArithDoubleArrow: ast::Exp = {
    <left:ArithOr> "DOUBLE_ARROW" <right:ArithDoubleArrow> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Impl), Box::new(right)),
            span,
        )
    },
    <left:ArithOr> "DOUBLE_ARROW_BOTH" <right:ArithDoubleArrow> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Equiv), Box::new(right)),
            span,
        )
    },
    ArithOr,
};

// ArithOr ::= ArithOr OR ArithAnd | ArithAnd
ArithOr: ast::Exp = {
    <left:ArithOr> "OR" <right:ArithAnd> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::Or), Box::new(right)),
            span,
        )
    },
    ArithAnd,
};

// ArithAnd ::= ArithAnd AND ArithComparison | ArithComparison
ArithAnd: ast::Exp = {
    <left:ArithAnd> "AND" <right:ArithComparison> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Bool(xl::bool::BinOp::And), Box::new(right)),
            span,
        )
    },
    ArithComparison,
};

// ArithComparison ::= ArithAdd ArithCompareOperator ArithComparison
//   | ArithAdd LANGLE_DASH ArithComparison
//   | ArithAdd
ArithComparison: ast::Exp = {
    <left:ArithAdd> <operator:ArithCompareOperator> <right:ArithComparison> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Cmp(Box::new(left), operator, Box::new(right)), span)
    },
    <left:ArithAdd> "LANGLE_DASH" <right:ArithComparison> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Mem(Box::new(left), Box::new(right)), span)
    },
    ArithAdd,
};

// ArithCompareOperator ::= EQ | NEQ | LANGLE | RANGLE
//   | LANGLE_EQ | RANGLE_EQ
ArithCompareOperator: CmpOp = {
    "EQ" => CmpOp::Bool(xl::bool::CmpOp::Eq),
    "NEQ" => CmpOp::Bool(xl::bool::CmpOp::Ne),
    "LANGLE" => CmpOp::Num(num::CmpOp::Lt),
    "RANGLE" => CmpOp::Num(num::CmpOp::Gt),
    "LANGLE_EQ" => CmpOp::Num(num::CmpOp::Le),
    "RANGLE_EQ" => CmpOp::Num(num::CmpOp::Ge),
};

// ArithAdd ::= ArithAdd PLUS ArithMul
//   | ArithAdd MINUS ArithMul
//   | ArithAdd PLUS2 ArithMul
//   | ArithMul
ArithAdd: ast::Exp = {
    <left:ArithAdd> "PLUS" <right:ArithMul> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Add), Box::new(right)),
            span,
        )
    },
    <left:ArithAdd> "MINUS" <right:ArithMul> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Sub), Box::new(right)),
            span,
        )
    },
    <left:ArithAdd> "PLUS2" <right:ArithMul> => {
        let span = span_between(&left, &right);
        Spanned::new(ExpKind::Cat(Box::new(left), Box::new(right)), span)
    },
    ArithMul,
};

// ArithMul ::= ArithMul StarOperator ArithUnary
//   | ArithMul SLASH ArithUnary
//   | ArithMul BACKSLASH ArithUnary
//   | ArithUnary
ArithMul: ast::Exp = {
    <left:ArithMul> <_operator:StarOperator> <right:ArithUnary> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mul), Box::new(right)),
            span,
        )
    },
    <left:ArithMul> "SLASH" <right:ArithUnary> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Div), Box::new(right)),
            span,
        )
    },
    <left:ArithMul> "BACKSLASH" <right:ArithUnary> => {
        let span = span_between(&left, &right);
        Spanned::new(
            ExpKind::Bin(Box::new(left), BinOp::Num(num::BinOp::Mod), Box::new(right)),
            span,
        )
    },
    ArithUnary,
};

// ArithUnary ::= BAR EnterExp Exp BAR ExitMode
//   | UnaryOperator ArithUnary
//   | ArithPost
ArithUnary: ast::Exp = {
    <left:@L> "BAR" <_enter:EnterExp> <exp:Exp> "BAR" <right:@R> <_exit:ExitMode> => {
        spanned(context, ExpKind::Len(Box::new(exp)), left, right)
    },
    <left:@L> <operator:UnaryOperator> <exp:ArithUnary> <right:@R> => {
        spanned(context, ExpKind::Un(operator, Box::new(exp)), left, right)
    },
    ArithPost,
};

// ArithPost ::= ArithAtomBase
//   | ArithPost UP ArithAtomBase
//   | ArithPost LBRACK Arith RBRACK
//   | ArithPost DotId
ArithPost: ast::Exp = {
    ArithAtomBase,
    <left:@L> <base:ArithPost> "UP" <exponent:ArithAtomBase> <right:@R> => {
        spanned(
            context,
            ExpKind::Bin(Box::new(base), BinOp::Num(num::BinOp::Pow), Box::new(exponent)),
            left,
            right,
        )
    },
    <left:@L> <base:ArithPost> "LBRACK" <index:Arith> "RBRACK" <right:@R> => {
        spanned(context, ExpKind::Idx(Box::new(base), Box::new(index)), left, right)
    },
    <left:@L> <base:ArithPost> <field:DotId> <right:@R> => {
        dot_exp(context, base, field, left, right)
    },
};

// ArithAtomBase ::= ExpLiteral | ExpVariable | ExpCall | ExpHole
//   | LPAREN Arith RPAREN
//   | DOLLAR LPAREN EnterExp Exp RPAREN ExitMode
//   | AtomRule
ArithAtomBase: ast::Exp = {
    ExpLiteral,
    ExpVariable,
    ExpCall,
    ExpHole,
    <left:@L> "LPAREN" <arith:Arith> "RPAREN" <right:@R> => {
        spanned(context, ExpKind::Paren(Box::new(arith)), left, right)
    },
    <left:@L> "DOLLAR" "LPAREN" <_enter:EnterExp> <exp:Exp> "RPAREN" <right:@R>
        <_exit:ExitMode> => {
        spanned(context, exp.node, left, right)
    },
    <atom:AtomRule> => {
        let span = atom.span.clone();
        Spanned::new(ExpKind::Atom(atom), span)
    },
};

// PathSteps ::= PathStepRule+
PathSteps: Vec<PathStep> = {
    <steps:PathStepRule+> => steps,
};

// LBracketRight ::= LBRACK
LBracketRight: ParserLocation = {
    "LBRACK" <right:@R> => right,
};

// PathStepRule ::= LBRACK Arith RBRACK
//   | LBRACK Arith COLON Arith RBRACK
//   | DotId
PathStepRule: PathStep = {
    "LBRACK" <index:Arith> "RBRACK" <right:@R> => {
        PathStep::Idx(Box::new(index), right)
    },
    "LBRACK" <start:Arith> "COLON" <end:Arith> "RBRACK" <right:@R> => {
        PathStep::Slice(Box::new(start), Box::new(end), right)
    },
    <field:DotId> <right:@R> => PathStep::Dot(field, right),
};

// Param ::= ParamKindRule
Param: ast::Param = {
    <left:@L> <kind:ParamKindRule> <right:@R> => spanned(context, kind, left, right),
};

// ParamKindRule ::= PlainTyp
//   | DEF DOLLAR DefId COLON PlainTyp
//   | DEF DOLLAR DefIdLParen EnterScope CommaList<Param> RPAREN
//       COLON PlainTyp ExitScope
//   | DEF DOLLAR DefIdLAngle EnterScope CommaList<TParam> RANGLE
//       COLON PlainTyp ExitScope
//   | DEF DOLLAR DefIdLAngle EnterScope CommaList<TParam>
//       RANGLE_LPAREN CommaList<Param> RPAREN COLON PlainTyp ExitScope
ParamKindRule: ParamKind = {
    <plain_typ:PlainTyp> => ParamKind::Exp(plain_typ),
    "DEF" "DOLLAR" <id:DefId> "COLON" <plain_typ:PlainTyp> => {
        ParamKind::Def(id, vec![], vec![], plain_typ)
    },
    "DEF" "DOLLAR" <id:DefIdLParen> <_enter:EnterScope> <params:CommaList<Param>>
        "RPAREN" "COLON" <plain_typ:PlainTyp> <_exit:ExitScope> => {
            ParamKind::Def(id, vec![], params, plain_typ)
        },
    "DEF" "DOLLAR" <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>>
        "RANGLE" "COLON" <plain_typ:PlainTyp> <_exit:ExitScope> => {
            ParamKind::Def(id, tparams, vec![], plain_typ)
        },
    "DEF" "DOLLAR" <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>>
        "RANGLE_LPAREN" <params:CommaList<Param>> "RPAREN" "COLON" <plain_typ:PlainTyp>
        <_exit:ExitScope> => ParamKind::Def(id, tparams, params, plain_typ),
};

// PremList ::= EnterScope PremEntry* ExitScope
PremList: Vec<ast::Prem> = {
    <_enter:EnterScope> <entries:PremEntry*> <right:@R> <_exit:ExitScope> => {
        context.record_prem_list(right, !entries.is_empty());
        entries.into_iter().flatten().collect()
    },
};

// PremEntry ::= DASH DASH | DASH Prem
PremEntry: Option<ast::Prem> = {
    "DASH" "DASH" => None,
    "DASH" <premise:Prem> => Some(premise),
};

// Prem ::= PremKindRule
Prem: ast::Prem = {
    <left:@L> <kind:PremKindRule> <right:@R> => spanned(context, kind, left, right),
};

// PremKindRule ::= OTHERWISE
//   | LPAREN Prem RPAREN IterRule*
//   | RelId COLON Exp
//   | RelId COLON_SLASH Exp
//   | VAR VarIdBind COLON PlainTyp
//   | IF Exp
//   | DEBUG Exp
PremKindRule: PremKind = {
    "OTHERWISE" => PremKind::Else,
    <left:@L> "LPAREN" <premise:Prem> "RPAREN" <iterations:IterRule*> <right:@R> => {
        let mut premise = premise;
        for iter in iterations {
            premise = spanned(
                context,
                PremKind::Iter(IterPrem {
                    prem: Box::new(premise),
                    iter,
                }),
                left,
                right,
            );
        }
        premise.node
    },
    <id:RelId> "COLON" <exp:Exp> => PremKind::Rule(RulePrem { id, exp }),
    <id:RelId> "COLON_SLASH" <exp:Exp> => PremKind::RuleNot(RuleNotPrem { id, exp }),
    "VAR" <id:VarIdBind> "COLON" <plain_typ:PlainTyp> => {
        PremKind::Var(VarPrem { id, plain_typ })
    },
    "IF" <exp:Exp> => {
        fn from_exp(exp: ast::Exp) -> PremKind {
            match exp.node {
                ExpKind::Iter(exp, iter) => {
                    let span = exp.span.clone();
                    PremKind::Iter(IterPrem {
                        prem: Box::new(Spanned::new(from_exp(*exp), span)),
                        iter,
                    })
                }
                node => PremKind::If(IfPrem {
                    exp: Spanned::new(node, exp.span),
                }),
            }
        }
        from_exp(exp)
    },
    "DEBUG" <exp:Exp> => PremKind::Debug(DebugPrem { exp }),
};

// Hint ::= HINT_LPAREN HintId SEQ Exp RPAREN
//   | HINT_LPAREN HintId RPAREN
Hint: ast::Hint = {
    "HINT_LPAREN" <left:@L> <id:HintId> <right:@R> "SEQ" <exp:Exp> "RPAREN"
        <hint_right:@R> => {
        context.record_hint_right(hint_right);
        (spanned(context, id, left, right), exp)
    },
    "HINT_LPAREN" <left:@L> <id:HintId> <right:@R> "RPAREN" <hint_right:@R> => {
        context.record_hint_right(hint_right);
        let id = spanned(context, id, left, right);
        let exp = Spanned::new(ExpKind::Seq(vec![]), id.span.clone());
        (id, exp)
    },
};

// Hints ::= ε | Hint Hints
Hints: Vec<ast::Hint> = {
    => vec![],
    <head:Hint> <mut tail:Hints> => {
        tail.insert(0, head);
        tail
    },
};

// TableBody ::= Bar BarList<TableRow>
TableBody: Vec<ast::TableRow> = {
    <_bar:Bar> <rows:BarList<TableRow>> => rows,
};

// TableRow ::= TablePattern DOUBLE_ARROW ExpBin
TableRow: ast::TableRow = {
    <pattern:TablePattern> "DOUBLE_ARROW" <body:ExpBin> => {
        let span = span_between(&pattern, &body);
        Spanned::new((pattern, body), span)
    },
};

// TablePattern ::= ExpSeq
TablePattern: ast::Exp = ExpSeq;

// ExpSeq ::= ExpSeqStart ExpSeqTail*
ExpSeq: ast::Exp = {
    <first:ExpSeqStart> <rest:ExpSeqTail*> => {
        rest.into_iter().fold(first, |left, (fuse, right)| {
            let span = span_between(&left, &right);
            if fuse {
                Spanned::new(ExpKind::Fuse(Box::new(left), Box::new(right)), span)
            } else {
                let mut expressions = match left.node {
                    ExpKind::Seq(expressions) if expressions.len() >= 2 => expressions,
                    node => vec![Spanned::new(node, left.span)],
                };
                expressions.push(right);
                Spanned::new(ExpKind::Seq(expressions), span)
            }
        })
    },
};

// ExpSeqStart ::= ExpPost | ExpListIter
ExpSeqStart: ast::Exp = {
    ExpPost,
    ExpListIter,
};

// ExpSeqTail ::= SEQ ExpPost | HASH ExpPost
ExpSeqTail: (bool, ast::Exp) = {
    "SEQ" <exp:ExpPost> => (false, exp),
    "HASH" <exp:ExpPost> => (true, exp),
};

// RuleRule ::= RULE RelId RuleIds COLON Exp PremList
RuleRule: ast::Rule = {
    <left:@L> "RULE" <relid:RelId> <ruleids:RuleIds> "COLON" <exp:Exp>
        <premises:PremList> => {
            let groupid = if ruleids.node.is_empty() {
                String::new()
            } else {
                ruleids.node[1..].to_owned()
            };
            let groupid = Spanned::new(groupid, ruleids.span);
            let right = context.last_prem_list_right_or(exp.span.right.clone());
            Spanned::new(
                (relid, groupid, exp, premises),
                Span::new(context.position(left), right),
            )
        },
};

// RuleItem ::= NL2 | NL3 | RuleRule
RuleItem: Option<ast::Rule> = {
    "NL2" => None,
    "NL3" => None,
    <rule:RuleRule> => Some(rule),
};

// Rules ::= RuleItem*
Rules: Vec<ast::Rule> = {
    <items:RuleItem*> => items.into_iter().flatten().collect(),
};

// CallableDec ::= DefId COLON PlainTyp Hints
//   | DefIdLParen EnterScope CommaList<Param> RPAREN COLON PlainTyp
//       Hints ExitScope
//   | DefIdLAngle EnterScope CommaList<TParam> RANGLE COLON PlainTyp
//       Hints ExitScope
//   | DefIdLAngle EnterScope CommaList<TParam> RANGLE_LPAREN
//       CommaList<Param> RPAREN COLON PlainTyp Hints ExitScope
CallableDec: (ast::Id, Vec<ast::TParam>, Vec<ast::Param>, ast::PlainTyp, Vec<ast::Hint>) = {
    <id:DefId> "COLON" <plain_typ:PlainTyp> <hints:Hints> => {
        (id, vec![], vec![], plain_typ, hints)
    },
    <id:DefIdLParen> <_enter:EnterScope> <params:CommaList<Param>> "RPAREN" "COLON"
        <plain_typ:PlainTyp> <hints:Hints> <_exit:ExitScope> => {
            (id, vec![], params, plain_typ, hints)
        },
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE" "COLON"
        <plain_typ:PlainTyp> <hints:Hints> <_exit:ExitScope> => {
            (id, tparams, vec![], plain_typ, hints)
        },
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE_LPAREN"
        <params:CommaList<Param>> "RPAREN" "COLON" <plain_typ:PlainTyp> <hints:Hints>
        <_exit:ExitScope> => (id, tparams, params, plain_typ, hints),
};

// TableDecSignature ::= DefId COLON PlainTyp Hints
//   | DefIdLParen EnterScope CommaList<Param> RPAREN COLON PlainTyp
//       Hints ExitScope
TableDecSignature: (ast::Id, Vec<ast::Param>, ast::PlainTyp, Vec<ast::Hint>) = {
    <id:DefId> "COLON" <plain_typ:PlainTyp> <hints:Hints> => {
        (id, vec![], plain_typ, hints)
    },
    <id:DefIdLParen> <_enter:EnterScope> <params:CommaList<Param>> "RPAREN" "COLON"
        <plain_typ:PlainTyp> <hints:Hints> <_exit:ExitScope> => {
            (id, params, plain_typ, hints)
        },
};

// FunctionDefSignature ::= DefId EQ Exp PremList
//   | DefIdLParen EnterScope CommaList<Arg> RPAREN EQ Exp PremList
//       ExitScope
//   | DefIdLAngle EnterScope CommaList<TParam> RANGLE EQ Exp PremList
//       ExitScope
//   | DefIdLAngle EnterScope CommaList<TParam> RANGLE_LPAREN
//       CommaList<Arg> RPAREN EQ Exp PremList ExitScope
FunctionDefSignature: (ast::Id, Vec<ast::TParam>, Vec<ast::Arg>, ast::Exp, Vec<ast::Prem>) = {
    <id:DefId> "EQ" <exp:Exp> <prems:PremList> => {
        (id, vec![], vec![], exp, prems)
    },
    <id:DefIdLParen> <_enter:EnterScope> <args:CommaList<Arg>> "RPAREN" "EQ"
        <exp:Exp> <prems:PremList> <_exit:ExitScope> => {
            (id, vec![], args, exp, prems)
        },
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE" "EQ"
        <exp:Exp> <prems:PremList> <_exit:ExitScope> => {
            (id, tparams, vec![], exp, prems)
        },
    <id:DefIdLAngle> <_enter:EnterScope> <tparams:CommaList<TParam>> "RANGLE_LPAREN"
        <args:CommaList<Arg>> "RPAREN" "EQ" <exp:Exp> <prems:PremList>
        <_exit:ExitScope> => (id, tparams, args, exp, prems),
};
