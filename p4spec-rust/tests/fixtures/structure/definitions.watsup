extern syntax opaque
syntax cont = CONT
syntax ret = RET
syntax flow = cont | ret
var f : flow
var n : nat

extern relation External: flow ~> flow
  hint(input %0)
relation Empty: flow ~> flow
  hint(input %0)
relation Step: flow ~> flow
  hint(input %0)
rule Step/ret: RET ~> CONT
rule Step/else: f ~> f
  -- otherwise

extern dec $external(flow) : flow
builtin dec $text_to_int(text) : nat
dec $empty(flow) : flow
dec $recover(flow) : flow
def $recover(RET) = CONT
def $recover(f) = f
  -- otherwise

tbl dec $is_return(flow) : bool
tbl def $is_return =
  | RET => true
  | CONT => false
