syntax cursor = LOCAL
syntax nameIR = text
syntax prefixedNameIR = _BARE nameIR
syntax value = _B bool | '"' text '"'
syntax typingContext = CTX value value

dec $find_var_value_t(prefixedNameIR, cursor, typingContext) : value
def $find_var_value_t(_BARE "check", LOCAL, CTX value_check value_message)
  = value_check
def $find_var_value_t(_BARE "message", LOCAL, CTX value_check value_message)
  = value_message

extern relation ExternFunctionCall_eval_lctk:
  typingContext |- nameIR `( nameIR* `) ~> value
  hint(input %0 %1 %2)

extern relation Unsupported: bool ~> bool
  hint(input %0)
